<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Excise.Avalonia.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="Excise.Avalonia.Controls.PdfViewerControl">

    <!-- The ControlThemes of the two views (#1842 Phase B). They live in the viewer's own
         resources, not a host's, so every host gets them with the viewer. The app loads
         FluentAvalonia and both headless test apps FluentTheme; none of those can carry a
         theme for these internal types, and a TemplatedControl with no theme in reach
         silently has no template (HeadlessTestApp.cs). -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Excise.Avalonia/Controls/Viewer/ContinuousPageView.axaml" />
                <ResourceInclude Source="avares://Excise.Avalonia/Controls/Viewer/SinglePageView.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <!-- Continuous (reading) view: a vertically-scrolling, render-virtualized
             stack of all pages. Shown only when ViewMode=Continuous; hidden (and
             not measured) otherwise so the single-page view below owns the
             viewport. Form fields are fillable here (#1807); other editing
             still happens in single-page mode (#371). -->
        <controls:ContinuousPageView x:Name="ContinuousPart" />

        <!-- Single-page view (#1842): the page, its overlay layers and the
             loading/error chrome. After the continuous view so the chrome stays
             on top of it; its root Grid has no background, so it takes no
             pointer input where it draws nothing. -->
        <controls:SinglePageView x:Name="SinglePagePart" />
    </Grid>
</UserControl>
