<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Excise.Avalonia.Controls">

    <!-- The single-page view's template (#1842): the scroller, page image and overlay
         canvases, and the loading/error chrome, moved verbatim from the viewer's own XAML.
         PdfViewerControl.axaml merges this dictionary into the viewer's own resources, so
         no host (the app, either test app) has to load a theme for it. The view sits above
         the continuous view in the viewer's grid so the chrome stays on top of either view,
         as it always has; the two scrollers are never visible at once. The Grid has no
         Background, so it is transparent to hit-testing wherever nothing of its own is
         showing. The named elements are the view's template parts (SinglePageView.cs). -->
    <ControlTheme x:Key="{x:Type controls:SinglePageView}" TargetType="controls:SinglePageView">
        <Setter Property="Template">
            <ControlTemplate>
                <Grid>
                    <!-- Main PDF display area.
                         HorizontalContentAlignment / VerticalContentAlignment center the
                         page in the viewport when the scaled content is smaller than the
                         ScrollViewer; when the content exceeds the viewport these settings
                         have no effect (the scrollbars take over). -->
                    <ScrollViewer x:Name="PdfScrollViewer"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalContentAlignment="Center"
                                  VerticalContentAlignment="Center">

                        <!-- LayoutTransformControl participates in layout (RenderTransform
                             doesn't), so when ZoomLevel changes the wrapper's effective
                             size = bitmap size × zoom and the ScrollViewer/scrollbars
                             react correctly. The Image and OverlayCanvas live inside the
                             same wrapper so they always share one transform — no chance
                             of dual-transform drift. -->
                        <!-- Center (not Stretch) alignment is load-bearing (#693 live trace):
                             with Stretch, the ScrollViewer's presenter widens this wrapper to
                             the viewport whenever the scaled page is narrower — the Image
                             then CENTERS inside the widened ContentGrid while every overlay
                             canvas stays anchored at the grid's left edge, so highlights,
                             form boxes, and redaction previews land (gridW-imageW)/2 dips
                             left of the text (≈400 dips at 52% zoom: 'highlight very far to
                             the left'). Centering the wrapper makes it size to content, so
                             grid == image == overlay origin at every zoom. -->
                        <LayoutTransformControl x:Name="ZoomHost"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                            <LayoutTransformControl.LayoutTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </LayoutTransformControl.LayoutTransform>

                            <Grid x:Name="ContentGrid">
                                <!-- PDF Page Image (no transform here — the wrapper scales us). -->
                                <Image x:Name="PdfImage" Stretch="Fill" />

                                <!-- Overlay canvases for annotations. -->
                                <Canvas x:Name="OverlayCanvas"
                                        Background="Transparent"
                                        IsHitTestVisible="True">
                                    <Canvas x:Name="AnnotationsLayer" />
                                    <Canvas x:Name="SearchHighlightsLayer" />
                                    <Canvas x:Name="AppliedRedactionsLayer" />
                                    <Canvas x:Name="PendingRedactionsLayer" />
                                    <Canvas x:Name="TextSelectionLayer" />
                                    <Canvas x:Name="HiddenTextRevealLayer" />
                                    <Canvas x:Name="FormFieldsLayer" />
                                    <Canvas x:Name="InteractionLayer" Background="Transparent" />
                                    <Canvas x:Name="TypewriterLayer" />
                                </Canvas>
                            </Grid>
                        </LayoutTransformControl>
                    </ScrollViewer>

                    <!-- Thin indeterminate progress bar pinned to the top edge of the
                         viewer. Shown only while a page is rendering. Replaces the
                         full-screen "Loading page..." overlay that dominated the
                         viewport and made every page change feel jarring; this is the
                         standard browser-style "something's happening" affordance.
                         IsIndeterminate starts False and follows IsLoading together with
                         IsVisible (OnLoadingStateChanged): hiding an indeterminate bar
                         does NOT stop its animation (#1462). -->
                    <ProgressBar x:Name="LoadingProgressBar"
                                 IsVisible="False"
                                 IsIndeterminate="False"
                                 VerticalAlignment="Top"
                                 HorizontalAlignment="Stretch"
                                 Height="3"
                                 Margin="0"
                                 ShowProgressText="False" />

                    <!-- Kept for back-compat with code-behind that toggles it. Hidden
                         by default; the ProgressBar above is the visible indicator. -->
                    <Grid x:Name="LoadingOverlay"
                          IsVisible="False"
                          Background="Transparent" />

                    <!-- Error overlay. No Background by default → hit-transparent
                         outside the centred error message. Code-behind sets a dim
                         Background only when an error is actually being shown. -->
                    <Grid x:Name="ErrorOverlay"
                          IsVisible="False"
                          IsHitTestVisible="False">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <TextBlock x:Name="ErrorMessageText"
                                       Foreground="Red"
                                       FontSize="16"
                                       TextWrapping="Wrap"
                                       MaxWidth="400" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
