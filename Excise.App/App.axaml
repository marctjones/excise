<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sty="using:FluentAvalonia.Styling"
             xmlns:local="using:Excise.App"
             x:Class="Excise.App.App"
             Name="Excise"
             RequestedThemeVariant="Default">

    <!-- Application Resources -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Theme-aware chrome brushes (#1992) -->
                <ResourceInclude Source="/Styles/Brushes.axaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Fonts -->
            <FontFamily x:Key="MonospaceFontFamily">IBM Plex Mono, Consolas, Menlo, Monaco, monospace</FontFamily>

            <!-- Converters -->
            <local:BooleanToBrushConverter x:Key="BooleanToBrushConverter"/>
        </ResourceDictionary>
    </Application.Resources>

    <!-- Application Styles -->
    <Application.Styles>
        <!-- FluentAvalonia Theme - Modern Fluent Design System -->
        <sty:FluentAvaloniaTheme PreferSystemTheme="True"
                                  PreferUserAccentColor="False"
                                  CustomAccentColor="#4A7C4A"/>

        <!-- Custom Control Styles -->
        <StyleInclude Source="/Styles/Controls.axaml"/>
    </Application.Styles>
</Application>
