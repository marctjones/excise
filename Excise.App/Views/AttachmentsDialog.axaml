<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:Excise.App.Models"
        xmlns:vm="using:Excise.App.ViewModels"
        x:Class="Excise.App.Views.AttachmentsDialog"
        x:DataType="vm:MainWindowViewModel"
        Title="Attachments"
        Width="620" Height="420"
        WindowStartupLocation="CenterOwner"
        CanResize="True">

    <Grid Margin="16" RowDefinitions="Auto,Auto,*,Auto">

        <TextBlock Grid.Row="0"
                   Text="{Binding AttachmentsSummary}"
                   FontWeight="SemiBold"
                   FontSize="13"
                   Foreground="{DynamicResource TextPrimaryBrush}"/>

        <!-- The safety statement is part of the UI, not a comment: a user
             deciding whether to save an attachment needs to know excise will
             not open it for them. -->
        <TextBlock Grid.Row="1"
                   Margin="0,6,0,10"
                   TextWrapping="Wrap"
                   FontSize="11"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="Embedded files travel inside the PDF and are not visible on the page. excise never opens or runs them — Save writes the file to a location you choose. Remove All strips them from the document; save afterwards to keep the change."/>

        <Border Grid.Row="2"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                Padding="2">
            <ListBox x:Name="AttachmentsList"
                     ItemsSource="{Binding Attachments}"
                     SelectedItem="{Binding SelectedAttachment, Mode=TwoWay}"
                     Background="Transparent"
                     BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:AttachmentEntry">
                        <TextBlock Text="{Binding DisplayText}"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0"
                    Spacing="8">
            <Button x:Name="SaveAttachmentButton"
                    Content="Save Attachment…"
                    Padding="16,5"
                    Click="OnSaveAttachment"
                    IsEnabled="{Binding SelectedAttachment, Converter={x:Static ObjectConverters.IsNotNull}}"
                    AutomationProperties.Name="Save Attachment"/>
            <Button x:Name="RemoveAttachmentsButton"
                    Content="Remove All"
                    Padding="16,5"
                    Click="OnRemoveAll"
                    IsEnabled="{Binding HasAttachments}"
                    AutomationProperties.Name="Remove All Attachments"/>
            <Button x:Name="CloseAttachmentsButton"
                    Content="Close"
                    Padding="16,5"
                    IsDefault="True"
                    IsCancel="True"
                    Click="OnClose"
                    AutomationProperties.Name="Close Attachments"/>
        </StackPanel>
    </Grid>
</Window>
