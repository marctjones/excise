<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Excise.App.ViewModels"
        xmlns:access="using:Excise.App.Automation"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="56" d:DesignHeight="420"
        x:Class="Excise.App.Views.AnnotationPaletteWindow"
        x:DataType="vm:MainWindowViewModel"
        x:Name="PaletteWin"
        Title="Annotation Tools"
        Width="56" SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        Topmost="False"
        WindowStartupLocation="Manual"
        Background="{DynamicResource SecondaryBackgroundBrush}">

    <!--
    #1789: a compact floating tool palette — icon buttons only (no labels),
    bound to the SAME 15 annotation ICommand properties the Annotate menu and
    the optional annotation toolbar row already use. This window carries no
    command logic of its own; MainWindow's code-behind owns it as view
    mechanics (create/position/show/hide/close), the same way it owns
    BeginMoveDrag for the main window's custom title bar. Its DataContext is
    set to the active session's MainWindowViewModel by MainWindow, and kept in
    sync across a document-tab switch — this XAML never sets its own
    DataContext.

    Standard tool-palette pattern (Acrobat's comment toolbar torn off,
    Illustrator's tool palette): a single narrow column of icon buttons with
    tooltips, draggable anywhere via the normal OS window chrome, non-modal so
    the document stays interactive underneath it.
    -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Styles/Icons.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Orientation="Vertical" Spacing="2" Margin="4">
            <Button x:Name="PaletteHighlightButton"
                    Command="{Binding ToggleHighlightModeCommand}"
                    Classes="modern-button toolbar-button"
                    IsEnabled="{Binding IsDocumentLoaded}"
                    access:CommandAccessibility.CommandId="annotation.toggleHighlightMode"
                    ToolTip.Tip="Highlight tool: select text to highlight it"
                    AutomationProperties.Name="Highlight Tool">
                <PathIcon Classes="toolbar-icon" Data="{StaticResource IconHighlight}"/>
            </Button>
            <Button x:Name="PaletteUnderlineButton"
                    Command="{Binding ToggleUnderlineModeCommand}"
                    Classes="modern-button toolbar-button"
                    IsEnabled="{Binding IsDocumentLoaded}"
                    access:CommandAccessibility.CommandId="annotation.toggleUnderlineMode"
                    ToolTip.Tip="Underline tool: select text to underline it"
                    AutomationProperties.Name="Underline Tool">
                <PathIcon Classes="toolbar-icon" Data="{StaticResource IconUnderline}"/>
            </Button>
            <Button x:Name="PaletteStrikeOutButton"
                    Command="{Binding ToggleStrikeOutModeCommand}"
                    Classes="modern-button toolbar-button"
                    IsEnabled="{Binding IsDocumentLoaded}"
                    access:CommandAccessibility.CommandId="annotation.toggleStrikeOutMode"
                    ToolTip.Tip="Strikeout tool: select text to strike it out"
                    AutomationProperties.Name="Strikeout Tool">
                <PathIcon Classes="toolbar-icon" Data="{StaticResource IconStrikeOut}"/>
            </Button>
            <Button x:Name="PaletteSquigglyButton"
                    Command="{Binding ToggleSquigglyModeCommand}"
                    Classes="modern-button toolbar-button"
                    IsEnabled="{Binding IsDocumentLoaded}"
                    access:CommandAccessibility.CommandId="annotation.toggleSquigglyMode"
                    ToolTip.Tip="Squiggly tool: select text to squiggly-underline it"
                    AutomationProperties.Name="Squiggly Tool">
                <PathIcon Classes="toolbar-icon" Data="{StaticResource IconSquiggly}"/>
            </Button>

            <Separator Margin="2,4"/>

            <Button x:Name="PaletteSquareButton"
                    Command="{Binding ToggleSquareModeCommand}"
                    Classes="modern-button toolbar-button"
                    IsEnabled="{Binding IsDocumentLoaded}"
                    access:CommandAccessibility.CommandId="annotation.toggleSquareMode"
                    ToolTip.Tip="Draw square"
                    AutomationProperties.Name="Draw Square">
                <PathIcon Classes="toolbar-icon" Data="{StaticResource IconSquare}"/>
            </Button>
            <Button x:Name="PaletteCircleButton"
                    Command="{Binding ToggleCircleModeCommand}"
                    Classes="modern-button toolbar-button"
                    IsEnabled="{Binding IsDocumentLoaded}"
                    access:CommandAccessibility.CommandId="annotation.toggleCircleMode"
                    ToolTip.Tip="Draw circle"
                    AutomationProperties.Name="Draw Circle">
                <PathIcon Classes="toolbar-icon" Data="{StaticResource IconCircle}"/>
            </Button>
            <Button x:Name="PaletteFreeTextButton"
                    Command="{Binding ToggleFreeTextModeCommand}"
                    Classes="modern-button toolbar-button"
                    IsEnabled="{Binding IsDocumentLoaded}"
                    access:CommandAccessibility.CommandId="annotation.toggleFreeTextMode"
                    ToolTip.Tip="Draw text box"
                    AutomationProperties.Name="Draw Text Box">
                <PathIcon Classes="toolbar-icon" Data="{StaticResource IconFreeText}"/>
            </Button>
            <Button x:Name="PaletteStampButton"
                    Command="{Binding ToggleStampModeCommand}"
                    CommandParameter="Confidential"
                    Classes="modern-button toolbar-button"
                    IsEnabled="{Binding IsDocumentLoaded}"
                    access:CommandAccessibility.CommandId="annotation.toggleStampMode"
                    ToolTip.Tip="Draw &quot;Confidential&quot; stamp — see the Annotate menu for other stamps"
                    AutomationProperties.Name="Draw Stamp">
                <PathIcon Classes="toolbar-icon" Data="{StaticResource IconStamp}"/>
            </Button>
            <Button x:Name="PaletteImageStampButton"
                    Command="{Binding ToggleImageStampModeCommand}"
                    Classes="modern-button toolbar-button"
                    IsEnabled="{Binding IsDocumentLoaded}"
                    access:CommandAccessibility.CommandId="annotation.toggleImageStampMode"
                    ToolTip.Tip="Draw image stamp"
                    AutomationProperties.Name="Draw Image Stamp">
                <PathIcon Classes="toolbar-icon" Data="{StaticResource IconImageStamp}"/>
            </Button>

            <Separator Margin="2,4"/>

            <Button x:Name="PaletteInkButton"
                    Command="{Binding ToggleFreehandModeCommand}"
                    Classes="modern-button toolbar-button"
                    IsEnabled="{Binding IsDocumentLoaded}"
                    access:CommandAccessibility.CommandId="annotation.toggleDrawMode"
                    ToolTip.Tip="Draw (Ink)"
                    AutomationProperties.Name="Draw (Ink)">
                <PathIcon Classes="toolbar-icon" Data="{StaticResource IconInk}"/>
            </Button>
            <Button x:Name="PaletteLineButton"
                    Command="{Binding ToggleLineModeCommand}"
                    Classes="modern-button toolbar-button"
                    IsEnabled="{Binding IsDocumentLoaded}"
                    access:CommandAccessibility.CommandId="annotation.toggleLineMode"
                    ToolTip.Tip="Draw Line"
                    AutomationProperties.Name="Draw Line">
                <PathIcon Classes="toolbar-icon" Data="{StaticResource IconAnnotationLine}"/>
            </Button>
            <Button x:Name="PaletteArrowButton"
                    Command="{Binding ToggleArrowModeCommand}"
                    Classes="modern-button toolbar-button"
                    IsEnabled="{Binding IsDocumentLoaded}"
                    access:CommandAccessibility.CommandId="annotation.toggleArrowMode"
                    ToolTip.Tip="Draw Arrow"
                    AutomationProperties.Name="Draw Arrow">
                <PathIcon Classes="toolbar-icon" Data="{StaticResource IconArrow}"/>
            </Button>
            <Button x:Name="PalettePolygonButton"
                    Command="{Binding TogglePolygonModeCommand}"
                    Classes="modern-button toolbar-button"
                    IsEnabled="{Binding IsDocumentLoaded}"
                    access:CommandAccessibility.CommandId="annotation.togglePolygonMode"
                    ToolTip.Tip="Draw Polygon"
                    AutomationProperties.Name="Draw Polygon">
                <PathIcon Classes="toolbar-icon" Data="{StaticResource IconPolygon}"/>
            </Button>
            <Button x:Name="PalettePolyLineButton"
                    Command="{Binding TogglePolyLineModeCommand}"
                    Classes="modern-button toolbar-button"
                    IsEnabled="{Binding IsDocumentLoaded}"
                    access:CommandAccessibility.CommandId="annotation.togglePolyLineMode"
                    ToolTip.Tip="Draw PolyLine"
                    AutomationProperties.Name="Draw PolyLine">
                <PathIcon Classes="toolbar-icon" Data="{StaticResource IconPolyLine}"/>
            </Button>

            <Separator Margin="2,4"/>

            <Button x:Name="PaletteStickyNoteButton"
                    Command="{Binding AddStickyNoteAnnotationCommand}"
                    Classes="modern-button toolbar-button"
                    IsEnabled="{Binding IsDocumentLoaded}"
                    access:CommandAccessibility.CommandId="annotation.addStickyNote"
                    ToolTip.Tip="Add sticky note"
                    AutomationProperties.Name="Add Sticky Note">
                <PathIcon Classes="toolbar-icon" Data="{StaticResource IconNote}"/>
            </Button>
        </StackPanel>
    </ScrollViewer>
</Window>
