<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Excise.App.ViewModels"
        xmlns:ctl="using:Excise.App.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="500"
        x:Class="Excise.App.Views.PreferencesWindow"
        x:DataType="vm:PreferencesViewModel"
        Title="Preferences"
        Width="680" Height="640"
        MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        CanResize="True">

    <Design.DataContext>
        <vm:PreferencesViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource SecondaryBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,16">
            <TextBlock Text="Preferences" Classes="dialog-title"/>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" Padding="20,16">
            <StackPanel Spacing="16">

                <!-- Documents (#1463) -->
                <Border Classes="settings-card">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Documents" Classes="settings-card-title"/>
                        <TextBlock Text="Open Documents In" Classes="field-label"/>
                        <ComboBox x:Name="DocumentOpenModeComboBox"
                                  Classes="enum-labels"
                                  ItemsSource="{Binding DocumentOpenModeOptions}"
                                  SelectedItem="{Binding SelectedDocumentOpenMode}"
                                  AutomationProperties.Name="Open Documents In"
                                  AutomationProperties.HelpText="Where a document opens when the window already shows one."/>
                        <TextBlock Text="Automatic: a new window; on macOS, System Settings &gt; Desktop &amp; Dock &gt; Prefer tabs when opening documents decides whether it opens as a tab. New window: always a new window. New tab: a tab in the current window (Ctrl+Tab switches tabs; right-click a tab to move it to its own window). Replace current document: as older versions did. A window with no document always takes the file, and a file that is already open is brought to the front."
                                   Classes="help"/>
                    </StackPanel>
                </Border>

                <!-- Forms (#1570) -->
                <Border Classes="settings-card">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Forms" Classes="settings-card-title"/>
                        <CheckBox x:Name="RunFormCalcCheckBox"
                                  Content="Run form calculations (FormCalc)"
                                  IsChecked="{Binding RunFormCalc}"
                                  AutomationProperties.Name="Run Form Calculations"
                                  AutomationProperties.HelpText="Run a dynamic XFA form's FormCalc calculations when it opens."/>
                        <TextBlock Text="On (default): when a dynamic XFA form opens, its FormCalc initialize and calculate scripts run, so totals and fields shown or hidden by a script appear as the form's author meant. Scripts can only change the form's own field values and visibility; they cannot reach files, the network or the rest of your computer, and each one is limited in time and memory. Off: the form shows the values stored in the file. JavaScript never runs. Applies to documents opened after you save."
                                   Classes="help"/>
                    </StackPanel>
                </Border>

                <!-- Performance Settings Section -->
                <Border Classes="settings-card">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Performance" Classes="settings-card-title"/>

                        <TextBlock Text="Trade memory and CPU against how quickly pages you have already seen come back. Saved changes apply at once."
                                   Classes="help"/>

                        <Separator/>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Preset" Classes="field-label"/>
                            <ComboBox x:Name="PerformancePresetComboBox"
                                  Classes="enum-labels"
                                      ItemsSource="{Binding PerformancePresetOptions}"
                                      SelectedItem="{Binding SelectedPerformancePreset}"
                                      AutomationProperties.Name="Performance Preset"
                                      AutomationProperties.HelpText="Choose how much memory and CPU the viewer may use. Changing an advanced value switches this to Custom."/>
                            <TextBlock Text="Low memory: small caches, no background thumbnail rendering, trims after 15 s idle. Balanced: today's behaviour. Fast: large caches, more render threads, no background trims."
                                       Classes="help"/>
                        </StackPanel>

                        <StackPanel x:Name="MemoryReadoutPanel"
                                    Spacing="4"
                                    AutomationProperties.Name="Memory Use"
                                    AutomationProperties.HelpText="Live memory use of excise, refreshed every second while Preferences is open.">
                            <TextBlock Text="Memory use (live)" Classes="field-label"/>
                            <TextBlock Classes="help">
                                <Run Text="App working set: "/><Run Text="{Binding WorkingSetText}"/>
                            </TextBlock>
                            <TextBlock Classes="help">
                                <Run Text="Managed heap: "/><Run Text="{Binding ManagedHeapText}"/>
                            </TextBlock>
                            <TextBlock Classes="help">
                                <Run Text="Page tile cache: "/><Run Text="{Binding TileCacheText}"/>
                            </TextBlock>
                        </StackPanel>

                        <Expander x:Name="PerformanceAdvancedExpander"
                                  Header="Advanced"
                                  HorizontalAlignment="Stretch"
                                  AutomationProperties.Name="Advanced Performance Settings"
                                  AutomationProperties.HelpText="Individual cache, thumbnail, trim and render-thread limits.">
                            <StackPanel Spacing="12" Margin="0,8,0,0">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Page tile cache (MB)" Classes="field-label"/>
                                    <NumericUpDown x:Name="TileCacheBudgetNumericUpDown"
                                                   Value="{Binding TileCacheBudgetMb}"
                                                   Minimum="32" Maximum="1024" Increment="16" FormatString="0"
                                                   AutomationProperties.Name="Page Tile Cache Budget"
                                                   AutomationProperties.HelpText="Megabytes of rendered continuous-view tiles kept for scrolling back, 32 to 1024."/>
                                </StackPanel>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="Cached pages (single-page view)" Classes="field-label"/>
                                    <NumericUpDown x:Name="SinglePageCachedPagesNumericUpDown"
                                                   Value="{Binding SinglePageCachedPages}"
                                                   Minimum="1" Maximum="24" Increment="1" FormatString="0"
                                                   AutomationProperties.Name="Cached Single Pages"
                                                   AutomationProperties.HelpText="Rendered pages kept for instant back-navigation in single-page view, 1 to 24."/>
                                </StackPanel>

                                <CheckBox x:Name="ThumbnailPrewarmCheckBox"
                                          Content="Render thumbnails in the background"
                                          IsChecked="{Binding ThumbnailPrewarm}"
                                          AutomationProperties.Name="Thumbnail Background Rendering"
                                          AutomationProperties.HelpText="Pre-render every page thumbnail once the document has been idle for the idle delay below."/>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="Thumbnails kept around the visible ones" Classes="field-label"/>
                                    <NumericUpDown x:Name="ThumbnailKeepMarginNumericUpDown"
                                                   Value="{Binding ThumbnailKeepMargin}"
                                                   Minimum="12" Maximum="500" Increment="4" FormatString="0"
                                                   AutomationProperties.Name="Thumbnail Keep Margin"
                                                   AutomationProperties.HelpText="Thumbnails held in memory on each side of the visible ones, 12 to 500."/>
                                </StackPanel>

                                <CheckBox x:Name="SoftCacheTrimsCheckBox"
                                          Content="Release caches when excise is in the background or idle"
                                          IsChecked="{Binding SoftCacheTrims}"
                                          AutomationProperties.Name="Background Cache Trims"
                                          AutomationProperties.HelpText="Drop scroll-back caches when the window is deactivated, minimized, or idle."/>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="Idle delay (seconds)" Classes="field-label"/>
                                    <!-- #1565: this is now the app's one idle delay. It gates the
                                         background thumbnail pre-render as well as the cache trim,
                                         so it stays editable when soft trims are off. -->
                                    <NumericUpDown x:Name="IdleTrimSecondsNumericUpDown"
                                                   Value="{Binding IdleTrimSeconds}"
                                                   Minimum="10" Maximum="600" Increment="5" FormatString="0"
                                                   AutomationProperties.Name="Idle Delay"
                                                   AutomationProperties.HelpText="Seconds without activity before scroll-back caches are released and background thumbnail rendering starts, 10 to 600. Lowering it warms thumbnails sooner."/>
                                </StackPanel>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="Render threads" Classes="field-label"/>
                                    <NumericUpDown x:Name="RenderThreadsNumericUpDown"
                                                   Value="{Binding RenderThreads}"
                                                   Minimum="1" Maximum="{Binding MaxRenderThreads}" Increment="1" FormatString="0"
                                                   AutomationProperties.Name="Render Threads"
                                                   AutomationProperties.HelpText="Continuous-view page renders that may run at once, 1 to the CPU count."/>
                                </StackPanel>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>

                <!-- Text Selection Settings Section (#774) -->
                <Border Classes="settings-card">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Text Selection" Classes="settings-card-title"/>

                        <TextBlock Text="How copied text is ordered when you select across the page"
                                   Classes="help"/>

                        <Separator/>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Reading Order" Classes="field-label"/>
                            <ComboBox x:Name="ReadingOrderStrategyComboBox"
                                  Classes="enum-labels"
                                      ItemsSource="{Binding ReadingOrderStrategyOptions}"
                                      SelectedItem="{Binding SelectedReadingOrderStrategy}"
                                      AutomationProperties.Name="Reading Order Strategy"
                                      AutomationProperties.HelpText="How selected text is ordered when copied."/>
                            <TextBlock Text="Column by column: reads each column top to bottom before the next. Top to bottom, left to right: geometric order, which interleaves columns. As stored in the file: the PDF's own text order."
                                       Classes="help"/>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Whitespace" Classes="field-label"/>
                            <ComboBox x:Name="WhitespaceModeComboBox"
                                  Classes="enum-labels"
                                      ItemsSource="{Binding WhitespaceModeOptions}"
                                      SelectedItem="{Binding SelectedWhitespaceMode}"
                                      AutomationProperties.Name="Copy Whitespace Mode"
                                      AutomationProperties.HelpText="How blank lines and list indentation are added to copied text."/>
                            <TextBlock Text="Keep paragraphs and lists: a blank line at detected paragraph breaks, bullet and numbered lists kept indented. One line per visual line: no paragraph or list detection."
                                       Classes="help"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Redaction carrier policy (#1188/#1169) -->
                <Border Classes="settings-card">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Redaction" Classes="settings-card-title"/>

                        <TextBlock Text="A PDF repeats page text in places you never see — link targets and document metadata. Cutting the redacted word out of one of those can REVEAL it: remove 'your' from https://www.irs.gov/your-account and the leftover https://www.irs.gov/-account tells anyone who knows the site what was removed."
                                   Classes="help"/>

                        <Separator/>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Output Profile" Classes="field-label"/>
                            <ComboBox x:Name="RedactionProfileComboBox"
                                  Classes="enum-labels"
                                      ItemsSource="{Binding RedactionProfileOptions}"
                                      SelectedItem="{Binding RedactionPreferences.Profile}"
                                      AutomationProperties.Name="Redaction Output Profile"
                                      AutomationProperties.HelpText="How much of the PDF's hidden machinery a redaction removes."/>
                            <TextBlock Text="Standard: also removes the parts of the PDF that can repeat the page and that cutting a word out cannot make safe — all JavaScript, actions that open files or submit data (page links still work), the producer's private data, page thumbnails, the appearance of hidden fields, content on layers that are switched off, and the document properties and XMP (a PDF/A or PDF/UA marker is kept). Tooltips, alternate text, structure titles, field names, bookmark titles, link targets and signer names are KEPT, with the redacted word cut out. Maximum: all of that, plus the whole value of every kept item is dropped, bookmarks, links, comments and field names are stripped, and forms and annotations are flattened, signatures and their certificates included — THE RESULT IS NO LONGER ACCESSIBLE OR INTERACTIVE, so a screen reader cannot read it properly and forms no longer work."
                                       Classes="help"/>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Match Rule" Classes="field-label"/>
                            <CheckBox x:Name="RedactionWholeWordCheckBox"
                                      Content="Whole words only"
                                      IsChecked="{Binding RedactionPreferences.WholeWord}"
                                      AutomationProperties.Name="Whole Word Redaction"
                                      AutomationProperties.HelpText="Require the redacted term to be bounded by a non-word character on both sides."/>
                            <TextBlock Text="Off (default): the term matches anywhere, so redacting 'Lee' also removes it from 'Sleeman' — right for a case number inside a longer citation, wrong for a name. On: the term must stand alone. Applies to page text and to metadata, outlines and link targets alike."
                                       Classes="help"/>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Attachments" Classes="field-label"/>
                            <CheckBox x:Name="RedactionKeepAttachmentsCheckBox"
                                      Content="Keep attachments in redacted copies"
                                      IsChecked="{Binding RedactionPreferences.KeepAttachments}"
                                      AutomationProperties.Name="Keep Attachments When Redacting"
                                      AutomationProperties.HelpText="Keep the PDF's embedded files in a redacted copy instead of removing them."/>
                            <TextBlock Text="Off (default): a redacted copy contains none of the PDF's attached files. On: text attachments (txt, csv, xml, html, json, md) have the redacted text cut out and attached PDFs are redacted too; any other attachment is listed in the report as not checked, because it may still contain the redacted text. A PDF portfolio can only be redacted with this on."
                                       Classes="help"/>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Covering Box Width" Classes="field-label"/>
                            <ComboBox x:Name="RedactionWidthPolicyComboBox"
                                  Classes="enum-labels"
                                      ItemsSource="{Binding WidthPolicyOptions}"
                                      SelectedItem="{Binding RedactionPreferences.Width}"
                                      AutomationProperties.Name="Redaction Width Policy"
                                      AutomationProperties.HelpText="How the removed text's width is handled."/>
                            <TextBlock Text="Fixed-size marker: like Close the gap, plus a covering box of one fixed size regardless of what was removed — closes the width channel AND stays visibly marked; the line keeps room for the box, so it covers none of the text that follows. Exact-width box: the box matches the removed text exactly and the page does not reflow — but the box's width then measures how long the removed text was. Widened box: rounded wider so similar-length words can't be told apart by measuring it. Close the gap: remove the space entirely and draw no box; removes the width from the file itself, at the cost of reflowing the line. Gap rounded to a whole em: no box; weaker than Close the gap, since the rounded gap still narrows the candidates. For an area redaction the box is the one you dragged; Close the gap, Fixed-size marker and Gap rounded to a whole em close the gap there too, and only Fixed-size marker draws a box. When redacting text, those three also remove an underline, box or highlight drawn to the removed word."
                                       Classes="help"/>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Link URLs" Classes="field-label"/>
                            <ComboBox x:Name="LinkUriCarrierPolicyComboBox"
                                  Classes="enum-labels"
                                      ItemsSource="{Binding CarrierScrubModeOptions}"
                                      SelectedItem="{Binding RedactionPreferences.LinkUriPolicy}"
                                      AutomationProperties.Name="Link URL Redaction Policy"
                                      AutomationProperties.HelpText="How a link target containing the redacted text is handled."/>
                            <TextBlock Text="Cut out the redacted text: cut the word out of the URL, leaving the rest — and, under the Maximum profile, let that profile's own choice stand. Remove the whole value: drop the entire link target, so no surrounding text survives to infer the word from. Leave it and report it: change nothing and list the link in the redaction report for you to decide."
                                       Classes="help"/>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Document Metadata" Classes="field-label"/>
                            <ComboBox x:Name="MetadataCarrierPolicyComboBox"
                                  Classes="enum-labels"
                                      ItemsSource="{Binding CarrierScrubModeOptions}"
                                      SelectedItem="{Binding RedactionPreferences.MetadataPolicy}"
                                      AutomationProperties.Name="Metadata Redaction Policy"
                                      AutomationProperties.HelpText="How document metadata containing the redacted text is handled."/>
                            <TextBlock Text="Applies to the /Info fields (Title, Author, Subject…) and the XMP packet. A templated field narrows a removed value the same way a known URL does."
                                       Classes="help"/>
                            <TextBlock Text="⚠ Leave it and report it leaves the redacted text in the document. The redaction report will say so — act on it before sharing the file."
                                       Classes="warning"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Printing (#1545) -->
                <Border Classes="settings-card">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Printing" Classes="settings-card-title"/>

                        <TextBlock Text="File &gt; Print opens the system print dialog with the document as currently edited. Pending redactions are applied to the printed copy."
                                   Classes="help"/>

                        <Separator/>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Page Scaling" Classes="field-label"/>
                            <ComboBox x:Name="PrintScalingComboBox"
                                  Classes="enum-labels"
                                      ItemsSource="{Binding PrintScalingOptions}"
                                      SelectedItem="{Binding SelectedPrintScaling}"
                                      AutomationProperties.Name="Print Page Scaling"
                                      AutomationProperties.HelpText="How printed pages are scaled onto the paper."/>
                            <TextBlock Text="Shrink oversized pages: pages larger than the paper are scaled down; smaller pages print at actual size. Fit to page: every page is scaled up or down to fill the paper. Actual size: every page prints at 100%. On macOS pages are drawn by macOS's own PDF renderer, so small differences from the excise viewer are possible; on Windows they are drawn by excise's renderer."
                                       Classes="help"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer Buttons -->
        <Border Grid.Row="2"
                Background="{DynamicResource SecondaryBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,12">
            <ctl:DialogButtonPanel>
                <Button ctl:DialogButtonPanel.Role="Extra"
                        Content="Reset to Defaults"
                        Command="{Binding ResetToDefaultsCommand}"
                        Classes="modern-button dialog-button"
                        AutomationProperties.Name="Reset Preferences to Defaults"
                        AutomationProperties.HelpText="Restore preference values to their defaults."/>
                <Button ctl:DialogButtonPanel.Role="Cancel"
                        Content="Cancel"
                        Command="{Binding CancelCommand}"
                        Classes="modern-button dialog-button"
                        IsCancel="True"
                        AutomationProperties.Name="Cancel Preferences"
                        AutomationProperties.HelpText="Close preferences without saving changes."/>
                <Button ctl:DialogButtonPanel.Role="Primary"
                        Content="Save"
                        Command="{Binding SaveCommand}"
                        Classes="modern-button dialog-button accent"
                        IsDefault="True"
                        AutomationProperties.Name="Save Preferences"
                        AutomationProperties.HelpText="Save preference changes and close this dialog."/>
            </ctl:DialogButtonPanel>
        </Border>
    </Grid>
</Window>
