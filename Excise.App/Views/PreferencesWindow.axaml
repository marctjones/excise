<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Excise.App.ViewModels"
        xmlns:ctl="using:Excise.App.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="860" d:DesignHeight="640"
        x:Class="Excise.App.Views.PreferencesWindow"
        x:DataType="vm:PreferencesViewModel"
        Title="{OnPlatform Default=Preferences, macOS=Settings}"
        Width="860" Height="640"
        MinWidth="680" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        CanResize="True">

    <Design.DataContext>
        <vm:PreferencesViewModel/>
    </Design.DataContext>

    <!-- #2000: categories on the left, one row per setting on the right (label and
         a one-line description, control on the right, long help under Details).
         Choosing a category scrolls to it; every control stays in the tree, so
         keyboard, automation and tests reach all of them. Changes apply as they
         are made (PreferencesWindow.axaml.cs). -->
    <Grid RowDefinitions="*,Auto" ColumnDefinitions="200,*">

        <!-- Categories -->
        <Border Grid.Row="0" Grid.Column="0"
                Background="{DynamicResource SidebarBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0"
                Padding="12,16">
            <StackPanel Spacing="12">
                <TextBlock Text="{OnPlatform Default=Preferences, macOS=Settings}" Classes="dialog-title" Margin="12,0,0,0"/>
                <ListBox x:Name="SettingsNav"
                         Classes="settings-nav"
                         SelectionMode="Single"
                         AutomationProperties.Name="Settings Categories"
                         AutomationProperties.HelpText="Jump to a group of settings.">
                    <ListBoxItem Tag="SectionGeneral" Content="General"/>
                    <ListBoxItem Tag="SectionPerformance" Content="Performance"/>
                    <ListBoxItem Tag="SectionText" Content="Text"/>
                    <ListBoxItem Tag="SectionRedaction" Content="Redaction"/>
                    <ListBoxItem Tag="SectionPrinting" Content="Printing"/>
                </ListBox>
            </StackPanel>
        </Border>

        <!-- Settings -->
        <ScrollViewer x:Name="SettingsScroller" Grid.Row="0" Grid.Column="1" Padding="24,8,24,24">
            <StackPanel Spacing="8">

                <!-- ── General ─────────────────────────────────────────────── -->
                <TextBlock x:Name="SectionGeneral" Text="General" Classes="settings-section"/>

                <!-- Appearance (#2002) -->
                <Border Classes="settings-row">
                    <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <Label Content="Appearance" Target="{Binding #AppearanceComboBox}" Classes="field-label"/>
                                <TextBlock Text="Light or dark window chrome. Pages always show as the PDF draws them." Classes="help"/>
                            </StackPanel>
                            <ComboBox x:Name="AppearanceComboBox" Grid.Column="1"
                                      Classes="enum-labels"
                                      ItemsSource="{Binding AppearanceOptions}"
                                      SelectedItem="{Binding SelectedAppearance}"
                                      AutomationProperties.Name="Appearance"
                                      AutomationProperties.HelpText="Light or dark window chrome. Match system follows the operating system."/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Documents (#1463) -->
                <Border Classes="settings-row">
                    <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <Label Content="Open documents in" Target="{Binding #DocumentOpenModeComboBox}" Classes="field-label"/>
                                <TextBlock Text="Where a document opens when the window already shows one." Classes="help"/>
                            </StackPanel>
                            <ComboBox x:Name="DocumentOpenModeComboBox" Grid.Column="1"
                                      Classes="enum-labels"
                                      ItemsSource="{Binding DocumentOpenModeOptions}"
                                      SelectedItem="{Binding SelectedDocumentOpenMode}"
                                      AutomationProperties.Name="Open Documents In"
                                      AutomationProperties.HelpText="Where a document opens when the window already shows one."/>
                        </Grid>
                        <ToggleButton x:Name="DetailsToggle1" Content="Details" Classes="details-toggle"
                                      AutomationProperties.Name="Details"
                                      AutomationProperties.HelpText="Show or hide the full explanation of this setting."/>
                        <TextBlock IsVisible="{Binding #DetailsToggle1.IsChecked}" Text="Automatic: a new window; on macOS, System Settings &gt; Desktop &amp; Dock &gt; Prefer tabs when opening documents decides whether it opens as a tab. New window: always a new window. New tab: a tab in the current window (Ctrl+Tab switches tabs; right-click a tab to move it to its own window). Replace current document: as older versions did. A window with no document always takes the file, and a file that is already open is brought to the front."
                                       Classes="help"/>
                    </StackPanel>
                </Border>

                <!-- Forms (#1570) -->
                <Border Classes="settings-row">
                    <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <Label Content="Run form calculations (FormCalc)" Target="{Binding #RunFormCalcCheckBox}" Classes="field-label"/>
                                <TextBlock Text="Dynamic XFA forms compute their totals and show the fields their author meant. JavaScript never runs." Classes="help"/>
                            </StackPanel>
                            <CheckBox x:Name="RunFormCalcCheckBox" Grid.Column="1"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding RunFormCalc}"
                                      AutomationProperties.Name="Run Form Calculations"
                                      AutomationProperties.HelpText="Run a dynamic XFA form's FormCalc calculations when it opens."/>
                        </Grid>
                        <ToggleButton x:Name="DetailsToggle2" Content="Details" Classes="details-toggle"
                                      AutomationProperties.Name="Details"
                                      AutomationProperties.HelpText="Show or hide the full explanation of this setting."/>
                        <TextBlock IsVisible="{Binding #DetailsToggle2.IsChecked}" Text="On (default): when a dynamic XFA form opens, its FormCalc initialize and calculate scripts run, so totals and fields shown or hidden by a script appear as the form's author meant. Scripts can only change the form's own field values and visibility; they cannot reach files, the network or the rest of your computer, and each one is limited in time and memory. Off: the form shows the values stored in the file. JavaScript never runs. Applies to documents opened after the change."
                                       Classes="help"/>
                    </StackPanel>
                </Border>

                <!-- ── Performance ─────────────────────────────────────────── -->
                <TextBlock x:Name="SectionPerformance" Text="Performance" Classes="settings-section"/>
                <TextBlock Text="Trade memory and CPU against how quickly pages you have already seen come back. Changes apply as you make them."
                           Classes="help"/>

                <Border Classes="settings-row">
                    <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <Label Content="Preset" Target="{Binding #PerformancePresetComboBox}" Classes="field-label"/>
                                <TextBlock Text="Changing an advanced value below switches this to Custom." Classes="help"/>
                            </StackPanel>
                            <ComboBox x:Name="PerformancePresetComboBox" Grid.Column="1"
                                      Classes="enum-labels"
                                      ItemsSource="{Binding PerformancePresetOptions}"
                                      SelectedItem="{Binding SelectedPerformancePreset}"
                                      AutomationProperties.Name="Performance Preset"
                                      AutomationProperties.HelpText="Choose how much memory and CPU the viewer may use. Changing an advanced value switches this to Custom."/>
                        </Grid>
                        <ToggleButton x:Name="DetailsToggle3" Content="Details" Classes="details-toggle"
                                      AutomationProperties.Name="Details"
                                      AutomationProperties.HelpText="Show or hide the full explanation of this setting."/>
                        <TextBlock IsVisible="{Binding #DetailsToggle3.IsChecked}" Text="Low memory: small caches, no background thumbnail rendering, trims after 15 s idle. Balanced: today's behaviour. Fast: large caches, more render threads, no background trims."
                                       Classes="help"/>
                    </StackPanel>
                </Border>

                <Border Classes="settings-row">
                    <StackPanel x:Name="MemoryReadoutPanel"
                                Spacing="2"
                                AutomationProperties.Name="Memory Use"
                                AutomationProperties.HelpText="Live memory use of excise, refreshed every second while Preferences is open.">
                        <TextBlock Text="Memory use (live)" Classes="field-label"/>
                        <TextBlock Classes="help">
                            <Run Text="App working set: "/><Run Text="{Binding WorkingSetText}"/>
                        </TextBlock>
                        <TextBlock Classes="help">
                            <Run Text="Managed heap: "/><Run Text="{Binding ManagedHeapText}"/>
                        </TextBlock>
                        <TextBlock Classes="help">
                            <Run Text="Page tile cache: "/><Run Text="{Binding TileCacheText}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Classes="settings-row">
                    <Expander x:Name="PerformanceAdvancedExpander"
                              Header="Advanced"
                              Classes="settings-details"
                              AutomationProperties.Name="Advanced Performance Settings"
                              AutomationProperties.HelpText="Individual cache, thumbnail, trim and render-thread limits.">
                        <StackPanel Spacing="12" Margin="0,8,0,0">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <Label Content="Page tile cache (MB)" Target="{Binding #TileCacheBudgetNumericUpDown}" Classes="field-label" VerticalAlignment="Center"/>
                                <NumericUpDown x:Name="TileCacheBudgetNumericUpDown" Grid.Column="1"
                                               Value="{Binding TileCacheBudgetMb}"
                                               Minimum="32" Maximum="1024" Increment="16" FormatString="0"
                                               AutomationProperties.Name="Page Tile Cache Budget"
                                               AutomationProperties.HelpText="Megabytes of rendered continuous-view tiles kept for scrolling back, 32 to 1024."/>
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <Label Content="Cached pages (single-page view)" Target="{Binding #SinglePageCachedPagesNumericUpDown}" Classes="field-label" VerticalAlignment="Center"/>
                                <NumericUpDown x:Name="SinglePageCachedPagesNumericUpDown" Grid.Column="1"
                                               Value="{Binding SinglePageCachedPages}"
                                               Minimum="1" Maximum="24" Increment="1" FormatString="0"
                                               AutomationProperties.Name="Cached Single Pages"
                                               AutomationProperties.HelpText="Rendered pages kept for instant back-navigation in single-page view, 1 to 24."/>
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <Label Content="Render thumbnails in the background" Target="{Binding #ThumbnailPrewarmCheckBox}" Classes="field-label" VerticalAlignment="Center"/>
                                <CheckBox x:Name="ThumbnailPrewarmCheckBox" Grid.Column="1"
                                          IsChecked="{Binding ThumbnailPrewarm}"
                                          AutomationProperties.Name="Thumbnail Background Rendering"
                                          AutomationProperties.HelpText="Pre-render every page thumbnail once the document has been idle for the idle delay below."/>
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <Label Content="Thumbnails kept around the visible ones" Target="{Binding #ThumbnailKeepMarginNumericUpDown}" Classes="field-label" VerticalAlignment="Center"/>
                                <NumericUpDown x:Name="ThumbnailKeepMarginNumericUpDown" Grid.Column="1"
                                               Value="{Binding ThumbnailKeepMargin}"
                                               Minimum="12" Maximum="500" Increment="4" FormatString="0"
                                               AutomationProperties.Name="Thumbnail Keep Margin"
                                               AutomationProperties.HelpText="Thumbnails held in memory on each side of the visible ones, 12 to 500."/>
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <Label Content="Release caches when excise is in the background or idle" Target="{Binding #SoftCacheTrimsCheckBox}" Classes="field-label" VerticalAlignment="Center"/>
                                <CheckBox x:Name="SoftCacheTrimsCheckBox" Grid.Column="1"
                                          IsChecked="{Binding SoftCacheTrims}"
                                          AutomationProperties.Name="Background Cache Trims"
                                          AutomationProperties.HelpText="Drop scroll-back caches when the window is deactivated, minimized, or idle."/>
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <Label Content="Idle delay (seconds)" Target="{Binding #IdleTrimSecondsNumericUpDown}" Classes="field-label" VerticalAlignment="Center"/>
                                <!-- #1565: this is now the app's one idle delay. It gates the
                                     background thumbnail pre-render as well as the cache trim,
                                     so it stays editable when soft trims are off. -->
                                <NumericUpDown x:Name="IdleTrimSecondsNumericUpDown" Grid.Column="1"
                                               Value="{Binding IdleTrimSeconds}"
                                               Minimum="10" Maximum="600" Increment="5" FormatString="0"
                                               AutomationProperties.Name="Idle Delay"
                                               AutomationProperties.HelpText="Seconds without activity before scroll-back caches are released and background thumbnail rendering starts, 10 to 600. Lowering it warms thumbnails sooner."/>
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <Label Content="Render threads" Target="{Binding #RenderThreadsNumericUpDown}" Classes="field-label" VerticalAlignment="Center"/>
                                <NumericUpDown x:Name="RenderThreadsNumericUpDown" Grid.Column="1"
                                               Value="{Binding RenderThreads}"
                                               Minimum="1" Maximum="{Binding MaxRenderThreads}" Increment="1" FormatString="0"
                                               AutomationProperties.Name="Render Threads"
                                               AutomationProperties.HelpText="Continuous-view page renders that may run at once, 1 to the CPU count."/>
                            </Grid>
                        </StackPanel>
                    </Expander>
                </Border>

                <!-- ── Text (#774) ─────────────────────────────────────────── -->
                <TextBlock x:Name="SectionText" Text="Text" Classes="settings-section"/>
                <TextBlock Text="How copied text is ordered when you select across the page." Classes="help"/>

                <Border Classes="settings-row">
                    <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <Label Content="Reading order" Target="{Binding #ReadingOrderStrategyComboBox}" Classes="field-label"/>
                                <TextBlock Text="The order selected text is copied in." Classes="help"/>
                            </StackPanel>
                            <ComboBox x:Name="ReadingOrderStrategyComboBox" Grid.Column="1"
                                      Classes="enum-labels"
                                      ItemsSource="{Binding ReadingOrderStrategyOptions}"
                                      SelectedItem="{Binding SelectedReadingOrderStrategy}"
                                      AutomationProperties.Name="Reading Order Strategy"
                                      AutomationProperties.HelpText="How selected text is ordered when copied."/>
                        </Grid>
                        <ToggleButton x:Name="DetailsToggle4" Content="Details" Classes="details-toggle"
                                      AutomationProperties.Name="Details"
                                      AutomationProperties.HelpText="Show or hide the full explanation of this setting."/>
                        <TextBlock IsVisible="{Binding #DetailsToggle4.IsChecked}" Text="Column by column: reads each column top to bottom before the next. Top to bottom, left to right: geometric order, which interleaves columns. As stored in the file: the PDF's own text order."
                                       Classes="help"/>
                    </StackPanel>
                </Border>

                <Border Classes="settings-row">
                    <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <Label Content="Whitespace" Target="{Binding #WhitespaceModeComboBox}" Classes="field-label"/>
                                <TextBlock Text="Blank lines and list indentation in copied text." Classes="help"/>
                            </StackPanel>
                            <ComboBox x:Name="WhitespaceModeComboBox" Grid.Column="1"
                                      Classes="enum-labels"
                                      ItemsSource="{Binding WhitespaceModeOptions}"
                                      SelectedItem="{Binding SelectedWhitespaceMode}"
                                      AutomationProperties.Name="Copy Whitespace Mode"
                                      AutomationProperties.HelpText="How blank lines and list indentation are added to copied text."/>
                        </Grid>
                        <ToggleButton x:Name="DetailsToggle5" Content="Details" Classes="details-toggle"
                                      AutomationProperties.Name="Details"
                                      AutomationProperties.HelpText="Show or hide the full explanation of this setting."/>
                        <TextBlock IsVisible="{Binding #DetailsToggle5.IsChecked}" Text="Keep paragraphs and lists: a blank line at detected paragraph breaks, bullet and numbered lists kept indented. One line per visual line: no paragraph or list detection."
                                       Classes="help"/>
                    </StackPanel>
                </Border>

                <!-- ── Redaction (#1188/#1169) ─────────────────────────────── -->
                <TextBlock x:Name="SectionRedaction" Text="Redaction" Classes="settings-section"/>
                <!-- Kept visible: it explains why the carrier settings below exist. -->
                <TextBlock Text="A PDF repeats page text in places you never see — link targets and document metadata. Cutting the redacted word out of one of those can REVEAL it: remove 'your' from https://www.irs.gov/your-account and the leftover https://www.irs.gov/-account tells anyone who knows the site what was removed."
                           Classes="help"/>

                <Border Classes="settings-row">
                    <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <Label Content="Output profile" Target="{Binding #RedactionProfileComboBox}" Classes="field-label"/>
                                <TextBlock Text="How much of the PDF's hidden machinery a redaction removes. Maximum is no longer accessible or interactive." Classes="help"/>
                            </StackPanel>
                            <ComboBox x:Name="RedactionProfileComboBox" Grid.Column="1"
                                      Classes="enum-labels"
                                      ItemsSource="{Binding RedactionProfileOptions}"
                                      SelectedItem="{Binding RedactionProfile}"
                                      AutomationProperties.Name="Redaction Output Profile"
                                      AutomationProperties.HelpText="How much of the PDF's hidden machinery a redaction removes."/>
                        </Grid>
                        <ToggleButton x:Name="DetailsToggle6" Content="Details" Classes="details-toggle"
                                      AutomationProperties.Name="Details"
                                      AutomationProperties.HelpText="Show or hide the full explanation of this setting."/>
                        <TextBlock IsVisible="{Binding #DetailsToggle6.IsChecked}" Text="Standard: also removes the parts of the PDF that can repeat the page and that cutting a word out cannot make safe — all JavaScript, actions that open files or submit data (page links still work), the producer's private data, page thumbnails, the appearance of hidden fields, content on layers that are switched off, and the document properties and XMP (a PDF/A or PDF/UA marker is kept). Tooltips, alternate text, structure titles, field names, bookmark titles, link targets and signer names are KEPT, with the redacted word cut out. Maximum: all of that, plus the whole value of every kept item is dropped, bookmarks, links, comments and field names are stripped, and forms and annotations are flattened, signatures and their certificates included — THE RESULT IS NO LONGER ACCESSIBLE OR INTERACTIVE, so a screen reader cannot read it properly and forms no longer work."
                                       Classes="help"/>
                    </StackPanel>
                </Border>

                <Border Classes="settings-row">
                    <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <Label Content="Whole words only" Target="{Binding #RedactionWholeWordCheckBox}" Classes="field-label"/>
                                <TextBlock Text="Off: 'Lee' also matches inside 'Sleeman'. On: the term must stand alone." Classes="help"/>
                            </StackPanel>
                            <CheckBox x:Name="RedactionWholeWordCheckBox" Grid.Column="1"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding RedactionWholeWord}"
                                      AutomationProperties.Name="Whole Word Redaction"
                                      AutomationProperties.HelpText="Require the redacted term to be bounded by a non-word character on both sides."/>
                        </Grid>
                        <ToggleButton x:Name="DetailsToggle7" Content="Details" Classes="details-toggle"
                                      AutomationProperties.Name="Details"
                                      AutomationProperties.HelpText="Show or hide the full explanation of this setting."/>
                        <TextBlock IsVisible="{Binding #DetailsToggle7.IsChecked}" Text="Off (default): the term matches anywhere, so redacting 'Lee' also removes it from 'Sleeman' — right for a case number inside a longer citation, wrong for a name. On: the term must stand alone. Applies to page text and to metadata, outlines and link targets alike."
                                       Classes="help"/>
                    </StackPanel>
                </Border>

                <Border Classes="settings-row">
                    <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <Label Content="Keep attachments in redacted copies" Target="{Binding #RedactionKeepAttachmentsCheckBox}" Classes="field-label"/>
                                <TextBlock Text="Off: a redacted copy has no attached files. On: text and PDF attachments are redacted too." Classes="help"/>
                            </StackPanel>
                            <CheckBox x:Name="RedactionKeepAttachmentsCheckBox" Grid.Column="1"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding RedactionKeepAttachments}"
                                      AutomationProperties.Name="Keep Attachments When Redacting"
                                      AutomationProperties.HelpText="Keep the PDF's embedded files in a redacted copy instead of removing them."/>
                        </Grid>
                        <ToggleButton x:Name="DetailsToggle8" Content="Details" Classes="details-toggle"
                                      AutomationProperties.Name="Details"
                                      AutomationProperties.HelpText="Show or hide the full explanation of this setting."/>
                        <TextBlock IsVisible="{Binding #DetailsToggle8.IsChecked}" Text="Off (default): a redacted copy contains none of the PDF's attached files. On: text attachments (txt, csv, xml, html, json, md) have the redacted text cut out and attached PDFs are redacted too; any other attachment is listed in the report as not checked, because it may still contain the redacted text. A PDF portfolio can only be redacted with this on."
                                       Classes="help"/>
                    </StackPanel>
                </Border>

                <Border Classes="settings-row">
                    <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <Label Content="Covering box width" Target="{Binding #RedactionWidthPolicyComboBox}" Classes="field-label"/>
                                <TextBlock Text="Whether the removed text's width can be measured from what is left." Classes="help"/>
                            </StackPanel>
                            <ComboBox x:Name="RedactionWidthPolicyComboBox" Grid.Column="1"
                                      Classes="enum-labels"
                                      ItemsSource="{Binding WidthPolicyOptions}"
                                      SelectedItem="{Binding RedactionWidth}"
                                      AutomationProperties.Name="Redaction Width Policy"
                                      AutomationProperties.HelpText="How the removed text's width is handled."/>
                        </Grid>
                        <ToggleButton x:Name="DetailsToggle9" Content="Details" Classes="details-toggle"
                                      AutomationProperties.Name="Details"
                                      AutomationProperties.HelpText="Show or hide the full explanation of this setting."/>
                        <TextBlock IsVisible="{Binding #DetailsToggle9.IsChecked}" Text="Fixed-size marker: like Close the gap, plus a covering box of one fixed size regardless of what was removed — closes the width channel AND stays visibly marked; the line keeps room for the box, so it covers none of the text that follows. Exact-width box: the box matches the removed text exactly and the page does not reflow — but the box's width then measures how long the removed text was. Widened box: rounded wider so similar-length words can't be told apart by measuring it. Close the gap: remove the space entirely and draw no box; removes the width from the file itself, at the cost of reflowing the line. Gap rounded to a whole em: no box; weaker than Close the gap, since the rounded gap still narrows the candidates. For an area redaction the box is the one you dragged; Close the gap, Fixed-size marker and Gap rounded to a whole em close the gap there too, and only Fixed-size marker draws a box. When redacting text, those three also remove an underline, box or highlight drawn to the removed word."
                                       Classes="help"/>
                    </StackPanel>
                </Border>

                <Border Classes="settings-row">
                    <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <Label Content="Link URLs" Target="{Binding #LinkUriCarrierPolicyComboBox}" Classes="field-label"/>
                                <TextBlock Text="A link target that contains the redacted text." Classes="help"/>
                            </StackPanel>
                            <ComboBox x:Name="LinkUriCarrierPolicyComboBox" Grid.Column="1"
                                      Classes="enum-labels"
                                      ItemsSource="{Binding CarrierScrubModeOptions}"
                                      SelectedItem="{Binding RedactionLinkUriPolicy}"
                                      AutomationProperties.Name="Link URL Redaction Policy"
                                      AutomationProperties.HelpText="How a link target containing the redacted text is handled."/>
                        </Grid>
                        <ToggleButton x:Name="DetailsToggle10" Content="Details" Classes="details-toggle"
                                      AutomationProperties.Name="Details"
                                      AutomationProperties.HelpText="Show or hide the full explanation of this setting."/>
                        <TextBlock IsVisible="{Binding #DetailsToggle10.IsChecked}" Text="Cut out the redacted text: cut the word out of the URL, leaving the rest — and, under the Maximum profile, let that profile's own choice stand. Remove the whole value: drop the entire link target, so no surrounding text survives to infer the word from. Leave it and report it: change nothing and list the link in the redaction report for you to decide."
                                       Classes="help"/>
                    </StackPanel>
                </Border>

                <Border Classes="settings-row">
                    <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <Label Content="Document metadata" Target="{Binding #MetadataCarrierPolicyComboBox}" Classes="field-label"/>
                                <TextBlock Text="The /Info fields (Title, Author, Subject…) and the XMP packet." Classes="help"/>
                            </StackPanel>
                            <ComboBox x:Name="MetadataCarrierPolicyComboBox" Grid.Column="1"
                                      Classes="enum-labels"
                                      ItemsSource="{Binding CarrierScrubModeOptions}"
                                      SelectedItem="{Binding RedactionMetadataPolicy}"
                                      AutomationProperties.Name="Metadata Redaction Policy"
                                      AutomationProperties.HelpText="How document metadata containing the redacted text is handled."/>
                        </Grid>
                        <ToggleButton x:Name="DetailsToggle11" Content="Details" Classes="details-toggle"
                                      AutomationProperties.Name="Details"
                                      AutomationProperties.HelpText="Show or hide the full explanation of this setting."/>
                        <TextBlock IsVisible="{Binding #DetailsToggle11.IsChecked}" Text="Applies to the /Info fields (Title, Author, Subject…) and the XMP packet. A templated field narrows a removed value the same way a known URL does."
                                       Classes="help"/>
                    </StackPanel>
                </Border>

                <!-- Always visible, never behind Details: a data-leak warning. -->
                <TextBlock Text="⚠ Leave it and report it leaves the redacted text in the document. The redaction report will say so — act on it before sharing the file."
                           Classes="warning"/>

                <!-- ── Printing (#1545) ────────────────────────────────────── -->
                <TextBlock x:Name="SectionPrinting" Text="Printing" Classes="settings-section"/>
                <TextBlock Text="File &gt; Print opens the system print dialog with the document as currently edited. Pending redactions are applied to the printed copy."
                           Classes="help"/>

                <Border Classes="settings-row">
                    <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <Label Content="Page scaling" Target="{Binding #PrintScalingComboBox}" Classes="field-label"/>
                                <TextBlock Text="How printed pages are scaled onto the paper." Classes="help"/>
                            </StackPanel>
                            <ComboBox x:Name="PrintScalingComboBox" Grid.Column="1"
                                      Classes="enum-labels"
                                      ItemsSource="{Binding PrintScalingOptions}"
                                      SelectedItem="{Binding SelectedPrintScaling}"
                                      AutomationProperties.Name="Print Page Scaling"
                                      AutomationProperties.HelpText="How printed pages are scaled onto the paper."/>
                        </Grid>
                        <ToggleButton x:Name="DetailsToggle12" Content="Details" Classes="details-toggle"
                                      AutomationProperties.Name="Details"
                                      AutomationProperties.HelpText="Show or hide the full explanation of this setting."/>
                        <TextBlock IsVisible="{Binding #DetailsToggle12.IsChecked}" Text="Shrink oversized pages: pages larger than the paper are scaled down; smaller pages print at actual size. Fit to page: every page is scaled up or down to fill the paper. Actual size: every page prints at 100%. On macOS pages are drawn by macOS's own PDF renderer, so small differences from the excise viewer are possible; on Windows they are drawn by excise's renderer."
                                       Classes="help"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer Buttons -->
        <Border Grid.Row="1" Grid.ColumnSpan="2"
                Background="{DynamicResource SecondaryBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,12">
            <ctl:DialogButtonPanel>
                <Button ctl:DialogButtonPanel.Role="Extra"
                        Content="Reset to Defaults"
                        Command="{Binding ResetToDefaultsCommand}"
                        Classes="modern-button dialog-button"
                        AutomationProperties.Name="Reset Preferences to Defaults"
                        AutomationProperties.HelpText="Restore preference values to their defaults."/>
                <Button ctl:DialogButtonPanel.Role="Cancel"
                        Content="Close"
                        Command="{Binding CloseCommand}"
                        Classes="modern-button dialog-button"
                        IsCancel="True"
                        IsDefault="True"
                        AutomationProperties.Name="Close Preferences"
                        AutomationProperties.HelpText="Close preferences. Changes have already been applied and saved."/>
            </ctl:DialogButtonPanel>
        </Border>
    </Grid>
</Window>
