<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Excise.App.ViewModels"
        x:Class="Excise.App.Views.ReduceFileSizeDialog"
        x:DataType="vm:ReduceFileSizeDialogViewModel"
        Title="Reduce File Size"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <Grid RowDefinitions="*,Auto">
      <Grid Margin="24,20,24,16" RowDefinitions="Auto,Auto,Auto,*">

        <TextBlock Grid.Row="0"
                   Text="Save a smaller copy of this document."
                   Classes="dialog-title"/>

        <TextBlock Grid.Row="1"
                   Margin="0,6,0,12"
                   Classes="help"
                   Text="You choose where the copy goes next. Your original file is never changed."/>

        <ComboBox x:Name="ReduceFileSizePresetBox" Grid.Row="2"
                  HorizontalAlignment="Stretch"
                  ItemsSource="{x:Static vm:ReduceFileSizeDialogViewModel.Choices}"
                  SelectedItem="{Binding Selected}"
                  AutomationProperties.Name="Reduce file size preset"/>

        <TextBlock x:Name="ReduceFileSizePresetDescription" Grid.Row="3"
                   Margin="0,10,0,0"
                   TextWrapping="Wrap" FontSize="12"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   Text="{Binding Selected.Description}"/>
    </Grid>

    <Border Grid.Row="1"
            Background="{DynamicResource SecondaryBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="24,12">
        <StackPanel Classes="dialog-footer">
            <Button x:Name="ReduceFileSizeCancelButton" Content="Cancel"
                    Classes="modern-button dialog-button"
                    IsCancel="True" Command="{Binding CancelCommand}"
                    AutomationProperties.Name="Cancel Reduce File Size"/>
            <Button x:Name="ReduceFileSizeContinueButton" Content="Choose Location..."
                    Classes="modern-button dialog-button accent"
                    IsDefault="True" Command="{Binding ConfirmCommand}"
                    AutomationProperties.Name="Choose where to save the smaller copy"/>
        </StackPanel>
    </Border>
    </Grid>
</Window>
