<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Excise.App.ViewModels"
        xmlns:ctl="using:Excise.App.Controls"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        x:Class="Excise.App.Views.MakeSearchableDialog"
        x:DataType="vm:MakeSearchableDialogViewModel"
        Title="Make Searchable"
        Width="480"
        WindowStartupLocation="CenterOwner"
        CanResize="false"
        SizeToContent="Height"
        Background="{DynamicResource AppBackgroundBrush}">

    <Grid RowDefinitions="*,Auto">
        <StackPanel Grid.Row="0" Margin="24,20,24,16" Spacing="12">

            <!-- Header -->
            <StackPanel Spacing="4">
                <TextBlock Text="Make Searchable" Classes="dialog-title"
                           IsVisible="{OnPlatform Default=True, macOS=False}"/>
                <TextBlock Text="OCRs every page that doesn't already have extractable text and writes the recognized words back as an invisible, searchable layer. The page's visual appearance is unchanged. This cannot be undone: it clears the undo history and marks the document as changed, so close without saving to discard it."
                           Classes="help"/>
            </StackPanel>

            <!-- Tesseract-not-installed banner -->
            <ui:FAInfoBar Severity="Error"
                        Title="OCR engine not found"
                        IsClosable="False"
                        IsOpen="{Binding !TesseractAvailable}"
                        IsVisible="{Binding !TesseractAvailable}">
                <TextBlock Text="{x:Static vm:MakeSearchableDialogViewModel.TesseractMissingMessage}" TextWrapping="Wrap" Margin="0,0,0,12"/>
            </ui:FAInfoBar>

            <!-- Options -->
            <StackPanel Spacing="8" IsEnabled="{Binding CanEditOptions}">
                <TextBlock Text="Language" Classes="field-label"/>
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox x:Name="LanguageTextBox"
                             Grid.Column="0"
                             Text="{Binding Language}"
                             PlaceholderText="e.g. eng, deu, eng+spa"
                             AutomationProperties.Name="OCR Language"
                             AutomationProperties.HelpText="Tesseract language code, e.g. eng, deu, or eng+spa for multiple languages."
                             Margin="0,0,8,0"/>
                    <ComboBox x:Name="LanguagePresetComboBox"
                              Grid.Column="1"
                              ItemsSource="{Binding LanguagePresets}"
                              SelectedItem="{Binding Language}"
                              PlaceholderText="Presets"
                              AutomationProperties.Name="OCR Language Preset"
                              AutomationProperties.HelpText="Pick a common tesseract language code."
                              Width="120"/>
                </Grid>

                <CheckBox Content="Re-OCR pages that already have text"
                          IsChecked="{Binding Force}"
                          AutomationProperties.Name="Force Re-OCR"
                          AutomationProperties.HelpText="OCR and overlay even pages that already have an extractable text layer."/>
            </StackPanel>

            <!-- Progress -->
            <StackPanel Spacing="4" IsVisible="{Binding IsRunning}">
                <ProgressBar Minimum="0" Maximum="1" Value="{Binding ProgressFraction}"
                             Height="6"
                             AutomationProperties.Name="Make Searchable Progress"/>
                <TextBlock Text="{Binding ProgressText}"
                           Classes="help"/>
            </StackPanel>

            <!-- Result summary -->
            <ui:FAInfoBar Severity="Success"
                        Title="Done"
                        IsClosable="False"
                        IsOpen="{Binding ResultSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                        IsVisible="{Binding ResultSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding ResultSummary}" TextWrapping="Wrap" Margin="0,0,0,12"/>
            </ui:FAInfoBar>

            <!-- Error -->
            <ui:FAInfoBar Severity="Error"
                        Title="OCR failed"
                        IsClosable="False"
                        IsOpen="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                        IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Margin="0,0,0,12"/>
            </ui:FAInfoBar>

        </StackPanel>

        <!-- Footer -->
        <Border Grid.Row="1"
                Background="{DynamicResource SecondaryBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,12">
            <ctl:DialogButtonPanel>
                <Button ctl:DialogButtonPanel.Role="Cancel" Content="{Binding CancelButtonText}"
                        Command="{Binding CancelCommand}"
                        IsCancel="True"
                        Classes="modern-button dialog-button"
                        AutomationProperties.Name="Cancel or Close Make Searchable"
                        AutomationProperties.HelpText="Cancel the running OCR pass, or close this dialog."/>

                <Button ctl:DialogButtonPanel.Role="Primary" Content="Start"
                        Command="{Binding StartCommand}"
                        IsEnabled="{Binding CanStart}"
                        Classes="modern-button dialog-button accent"
                        IsDefault="True"
                        AutomationProperties.Name="Start Make Searchable"
                        AutomationProperties.HelpText="Start OCR and write the recognized text back as an invisible, searchable layer."/>
            </ctl:DialogButtonPanel>
        </Border>
    </Grid>

</Window>
