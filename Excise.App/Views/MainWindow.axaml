<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Excise.App.ViewModels"
        xmlns:models="using:Excise.App.Models"
        xmlns:access="using:Excise.App.Automation"
        xmlns:toolbar="using:Excise.App.Controls"
        xmlns:controls="using:Excise.Avalonia.Controls"
        xmlns:views="using:Excise.App.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="Excise.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:Name="MainWin"
        Title="Excise"
        Icon="/Assets/excise_logo_256.png"
        Width="1200" Height="800"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="40"
        Background="{DynamicResource AppBackgroundBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Styles/Icons.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Window.Styles>
        <!-- #1476: what the main toolbar's degradation stages mean. The panel
             (ToolbarActionsPanel, PriorityToolbarPanel) only sets :icon-only,
             :dense and :compact, cumulatively; these styles decide what they do
             and each one only has to describe what its stage ADDS to the stage
             before it. Declared on the window,
             not in Controls.axaml, so the headless test app (which loads only
             FluentTheme) lays the toolbar out the same way. Padding and the rotate
             glyph size live here rather than as local values on the buttons,
             because a local value would outrank the :compact setters.
             Within one Styles collection the later style wins, so the :compact
             styles come last. -->
        <Style Selector="toolbar|PriorityToolbarPanel Button.toolbar-button">
            <Setter Property="Padding" Value="10,6"/>
        </Style>
        <Style Selector="toolbar|PriorityToolbarPanel Button.toolbar-button.labelled">
            <Setter Property="Padding" Value="12,6"/>
        </Style>
        <Style Selector="toolbar|PriorityToolbarPanel Button.toolbar-glyph">
            <Setter Property="FontSize" Value="16"/>
        </Style>
        <!-- The same 16 px Controls.axaml already gives PathIcon.toolbar-icon,
             restated here for the same reason as the padding above: the headless
             test app loads only FluentTheme, so without this the shrink ladder's
             TOP rung would be whatever Fluent happens to default a PathIcon to,
             and 16 -> 14 -> 12 could not be asserted. Same value, so the running
             app is unchanged. -->
        <Style Selector="toolbar|PriorityToolbarPanel PathIcon.toolbar-icon">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
        </Style>
        <!-- Stage 1: labels go. Tooltips and CommandAccessibility's automation
             names still carry them. -->
        <Style Selector="toolbar|PriorityToolbarPanel:icon-only TextBlock.toolbar-label">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <!-- Stage 2 (:dense) and stage 3 (:compact): icons shrink twice before
             anything hides. The row keeps its height; the panel sizes it from the
             full stage.

             ⚠️ Each step must make an icon-only button STRICTLY narrower, or a
             narrower window could show more than a wider one and
             PriorityToolbarLayout's widest-first order would be a lie. Per
             icon-only button, horizontal padding + icon:
                 :icon-only  10+10 + 16 = 36   (labelled: 12+12 + 16 = 40)
                 :dense       8+8  + 14 = 30
                 :compact     6+6  + 12 = 24
             (An earlier sketch used 4 px padding with a 14 px icon: 4+4+14 = 22,
             NARROWER than :compact's 24, which inverts the order.) -->
        <Style Selector="toolbar|PriorityToolbarPanel:dense Button.toolbar-button">
            <Setter Property="Padding" Value="8,6"/>
        </Style>
        <Style Selector="toolbar|PriorityToolbarPanel:dense PathIcon.toolbar-icon">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
        </Style>
        <Style Selector="toolbar|PriorityToolbarPanel:dense Button.toolbar-glyph">
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style Selector="toolbar|PriorityToolbarPanel:compact Button.toolbar-button">
            <Setter Property="Padding" Value="6,6"/>
        </Style>
        <Style Selector="toolbar|PriorityToolbarPanel:compact PathIcon.toolbar-icon">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
        </Style>
        <Style Selector="toolbar|PriorityToolbarPanel:compact Button.toolbar-glyph">
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <!-- Stage 4, hiding by priority, is the panel's own IsVisible handling. -->
    </Window.Styles>

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto">

        <!-- Menu Bar -->
        <Menu x:Name="MainMenuBar"
              Grid.Row="0"
              Background="{DynamicResource SecondaryBackgroundBrush}">
            <!-- FILE MENU -->
            <MenuItem Header="_File">
                <MenuItem Header="_Open..." Command="{Binding OpenFileCommand}" InputGesture="Ctrl+O"
                          access:CommandAccessibility.CommandId="app.open">
                    <MenuItem.Icon><PathIcon Classes="menu-icon" Data="{StaticResource IconFolderOpen}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{Binding SaveButtonText, StringFormat='_{0}'}" Command="{Binding SaveFileCommand}" InputGesture="Ctrl+S"
                          access:CommandAccessibility.CommandId="app.save">
                    <MenuItem.Icon><PathIcon Classes="menu-icon" Data="{StaticResource IconSave}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Save _As..." Command="{Binding SaveAsCommand}" InputGesture="Ctrl+Shift+S"
                          access:CommandAccessibility.CommandId="app.saveAs"/>
                <MenuItem Header="Save Flattened _Form Copy..." Command="{Binding SaveFlattenedFormCopyCommand}"
                          access:CommandAccessibility.CommandId="form.saveFlattenedCopy"/>
                <MenuItem Header="Sign _Document..." Command="{Binding SignDocumentCommand}"
                          access:CommandAccessibility.CommandId="app.signDocument"/>
                <Separator/>
                <MenuItem Header="_Recent Files" Name="RecentFilesMenu" ItemsSource="{Binding RecentFileMenuItems}">
                    <!-- Placeholder shown when menu has no items (ensures submenu arrow appears) -->
                    <MenuItem.Styles>
                        <Style Selector="MenuItem:empty">
                            <Setter Property="IsVisible" Value="True"/>
                        </Style>
                    </MenuItem.Styles>
                </MenuItem>
                <Separator/>
                <MenuItem Header="_Close Document" Command="{Binding CloseDocumentCommand}" InputGesture="Ctrl+W"
                          access:CommandAccessibility.CommandId="app.closeDocument"/>
                <MenuItem Header="E_xit" Command="{Binding ExitCommand}" access:CommandAccessibility.CommandId="app.exit" InputGesture="Alt+F4"/>
            </MenuItem>

            <!-- EDIT MENU -->
            <MenuItem Header="_Edit">
                <MenuItem Header="{Binding UndoMenuHeader}" Command="{Binding UndoCommand}" access:CommandAccessibility.CommandId="edit.undo" InputGesture="Ctrl+Z"
                          IsEnabled="{Binding CanUndo}"
                          AutomationProperties.Name="Undo"/>
                <MenuItem Header="{Binding RedoMenuHeader}" Command="{Binding RedoCommand}" access:CommandAccessibility.CommandId="edit.redo" InputGesture="Ctrl+Y"
                          IsEnabled="{Binding CanRedo}"
                          AutomationProperties.Name="Redo"/>
                <Separator/>
                <MenuItem Header="_Find..." Command="{Binding ToggleSearchCommand}" InputGesture="Ctrl+F"
                          access:CommandAccessibility.CommandId="search.open">
                    <MenuItem.Icon><PathIcon Classes="menu-icon" Data="{StaticResource IconSearch}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Find _Next" Command="{Binding FindNextCommand}" InputGesture="F3"
                          access:CommandAccessibility.CommandId="search.next"/>
                <MenuItem Header="Find _Previous" Command="{Binding FindPreviousCommand}" InputGesture="Shift+F3"
                          access:CommandAccessibility.CommandId="search.previous"/>
                <Separator/>
                <MenuItem Header="_Select Text Mode" Command="{Binding ToggleTextSelectionModeCommand}" InputGesture="T"
                          access:CommandAccessibility.CommandId="edit.selectTextMode">
                    <MenuItem.Icon>
                        <TextBlock Text="✓" IsVisible="{Binding IsTextSelectionMode}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Typewriter Mode" Command="{Binding ToggleTypewriterModeCommand}"
                          access:CommandAccessibility.CommandId="edit.typewriterMode">
                    <MenuItem.Icon>
                        <TextBlock Text="✓" IsVisible="{Binding IsTypewriterMode}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <!-- #1476: the toolbar's colour swatches can be hidden on a narrow
                     window, so the same eight presets live here. Setting a colour
                     with no active box sets the colour of the next box drawn. -->
                <!-- Each preset carries its OWN command id, so the accessible
                     name CommandAccessibility derives from the registry says
                     WHICH colour. Sharing typewriter.setColor across all eight
                     made a screen reader announce eight identical items over a
                     visible affordance (a colour) it cannot read at all.
                     The submenu keeps the generic id: it is still the scripting
                     entry point for an arbitrary hex, and the registry gate
                     requires every declared id to be GUI-reachable. Its tooltip
                     is suppressed — a submenu header does not want one. -->
                <MenuItem Header="Typewriter Text Co_lor"
                          IsEnabled="{Binding IsDocumentLoaded}"
                          access:CommandAccessibility.CommandId="typewriter.setColor"
                          access:CommandAccessibility.ShowToolTip="False">
                    <MenuItem Header="Black" Command="{Binding SetTypewriterColorCommand}" CommandParameter="#000000"
                              access:CommandAccessibility.CommandId="typewriter.setColor.black"/>
                    <MenuItem Header="Gray" Command="{Binding SetTypewriterColorCommand}" CommandParameter="#555555"
                              access:CommandAccessibility.CommandId="typewriter.setColor.gray"/>
                    <MenuItem Header="Red" Command="{Binding SetTypewriterColorCommand}" CommandParameter="#D0021B"
                              access:CommandAccessibility.CommandId="typewriter.setColor.red"/>
                    <MenuItem Header="Orange" Command="{Binding SetTypewriterColorCommand}" CommandParameter="#F5A623"
                              access:CommandAccessibility.CommandId="typewriter.setColor.orange"/>
                    <MenuItem Header="Green" Command="{Binding SetTypewriterColorCommand}" CommandParameter="#2E7D32"
                              access:CommandAccessibility.CommandId="typewriter.setColor.green"/>
                    <MenuItem Header="Blue" Command="{Binding SetTypewriterColorCommand}" CommandParameter="#1565C0"
                              access:CommandAccessibility.CommandId="typewriter.setColor.blue"/>
                    <MenuItem Header="Purple" Command="{Binding SetTypewriterColorCommand}" CommandParameter="#6A1B9A"
                              access:CommandAccessibility.CommandId="typewriter.setColor.purple"/>
                    <MenuItem Header="White" Command="{Binding SetTypewriterColorCommand}" CommandParameter="#FFFFFF"
                              access:CommandAccessibility.CommandId="typewriter.setColor.white"/>
                </MenuItem>
                <!-- #1476: Form Authoring is a mode like Typewriter; the toolbar
                     toggle is among the first actions a narrow window hides. -->
                <MenuItem Header="Form _Authoring Mode" Command="{Binding ToggleFormAuthoringModeCommand}"
                          IsEnabled="{Binding IsDocumentLoaded}"
                          access:CommandAccessibility.CommandId="form.toggleAuthoring">
                    <MenuItem.Icon>
                        <TextBlock Text="✓" IsVisible="{Binding IsFormAuthoringMode}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <!-- #780: pending type-over edits flatten on save even after leaving
                     typewriter mode. These affordances make them impossible to lose
                     silently: reach every off-page edit, or explicitly discard. -->
                <MenuItem Header="Go to Next Pending Type-over Edit"
                          Command="{Binding GoToNextPendingTypewriterEditCommand}" access:CommandAccessibility.CommandId="typewriter.goToNextPendingEdit"
                          IsEnabled="{Binding HasPendingTypewriterEdits}"
                          AutomationProperties.Name="Go to next pending type-over edit"/>
                <MenuItem Header="Discard Pending Type-over Edits"
                          Command="{Binding DiscardPendingTypewriterEditsCommand}" access:CommandAccessibility.CommandId="typewriter.discardPendingEdits"
                          IsEnabled="{Binding HasPendingTypewriterEdits}"
                          AutomationProperties.Name="Discard pending type-over edits"/>
                <MenuItem Header="_Copy Selected Text" Command="{Binding CopyTextCommand}" InputGesture="Ctrl+C"
                          IsEnabled="{Binding IsTextSelectionMode}"
                          access:CommandAccessibility.CommandId="edit.copyText"/>
            </MenuItem>

            <!-- ANNOTATE MENU -->
            <MenuItem Header="_Annotate">
                <MenuItem Header="Add _Highlight From Selection" Command="{Binding AddHighlightAnnotationFromSelectionCommand}"
                          IsEnabled="{Binding HasTextSelection}"
                          access:CommandAccessibility.CommandId="annotation.addHighlight"/>
                <MenuItem Header="Add _Underline From Selection" Command="{Binding AddUnderlineAnnotationFromSelectionCommand}"
                          IsEnabled="{Binding HasTextSelection}"
                          access:CommandAccessibility.CommandId="annotation.addUnderline"/>
                <MenuItem Header="Add Strike_out From Selection" Command="{Binding AddStrikeOutAnnotationFromSelectionCommand}"
                          IsEnabled="{Binding HasTextSelection}"
                          access:CommandAccessibility.CommandId="annotation.addStrikeOut"/>
                <MenuItem Header="Add S_quiggly From Selection" Command="{Binding AddSquigglyAnnotationFromSelectionCommand}"
                          IsEnabled="{Binding HasTextSelection}"
                          access:CommandAccessibility.CommandId="annotation.addSquiggly"/>
                <Separator/>
                <MenuItem Header="Add S_quare From Drag" Command="{Binding AddSquareAnnotationFromDragCommand}"
                          IsEnabled="{Binding IsDocumentLoaded}"
                          access:CommandAccessibility.CommandId="annotation.addSquare"/>
                <MenuItem Header="Add C_ircle From Drag" Command="{Binding AddCircleAnnotationFromDragCommand}"
                          IsEnabled="{Binding IsDocumentLoaded}"
                          access:CommandAccessibility.CommandId="annotation.addCircle"/>
                <MenuItem Header="Add _Text Box From Drag..." Command="{Binding AddFreeTextAnnotationFromDragCommand}"
                          IsEnabled="{Binding IsDocumentLoaded}"
                          access:CommandAccessibility.CommandId="annotation.addFreeText"/>
                <MenuItem Header="Add Stam_p From Drag"
                          IsEnabled="{Binding IsDocumentLoaded}"
                          access:CommandAccessibility.CommandId="annotation.addStamp">
                    <MenuItem Header="Approved" Command="{Binding AddStampAnnotationFromDragCommand}" access:CommandAccessibility.CommandId="annotation.addStamp"
                              CommandParameter="Approved"/>
                    <MenuItem Header="Experimental" Command="{Binding AddStampAnnotationFromDragCommand}" access:CommandAccessibility.CommandId="annotation.addStamp"
                              CommandParameter="Experimental"/>
                    <MenuItem Header="Not Approved" Command="{Binding AddStampAnnotationFromDragCommand}" access:CommandAccessibility.CommandId="annotation.addStamp"
                              CommandParameter="NotApproved"/>
                    <MenuItem Header="As Is" Command="{Binding AddStampAnnotationFromDragCommand}" access:CommandAccessibility.CommandId="annotation.addStamp"
                              CommandParameter="AsIs"/>
                    <MenuItem Header="Expired" Command="{Binding AddStampAnnotationFromDragCommand}" access:CommandAccessibility.CommandId="annotation.addStamp"
                              CommandParameter="Expired"/>
                    <MenuItem Header="Not For Public Release" Command="{Binding AddStampAnnotationFromDragCommand}" access:CommandAccessibility.CommandId="annotation.addStamp"
                              CommandParameter="NotForPublicRelease"/>
                    <MenuItem Header="Confidential" Command="{Binding AddStampAnnotationFromDragCommand}" access:CommandAccessibility.CommandId="annotation.addStamp"
                              CommandParameter="Confidential"/>
                    <MenuItem Header="Sold" Command="{Binding AddStampAnnotationFromDragCommand}" access:CommandAccessibility.CommandId="annotation.addStamp"
                              CommandParameter="Sold"/>
                    <MenuItem Header="Departmental" Command="{Binding AddStampAnnotationFromDragCommand}" access:CommandAccessibility.CommandId="annotation.addStamp"
                              CommandParameter="Departmental"/>
                    <MenuItem Header="Top Secret" Command="{Binding AddStampAnnotationFromDragCommand}" access:CommandAccessibility.CommandId="annotation.addStamp"
                              CommandParameter="TopSecret"/>
                    <MenuItem Header="Draft" Command="{Binding AddStampAnnotationFromDragCommand}" access:CommandAccessibility.CommandId="annotation.addStamp"
                              CommandParameter="Draft"/>
                    <MenuItem Header="For Comment" Command="{Binding AddStampAnnotationFromDragCommand}" access:CommandAccessibility.CommandId="annotation.addStamp"
                              CommandParameter="ForComment"/>
                    <MenuItem Header="Final" Command="{Binding AddStampAnnotationFromDragCommand}" access:CommandAccessibility.CommandId="annotation.addStamp"
                              CommandParameter="Final"/>
                    <MenuItem Header="For Public Release" Command="{Binding AddStampAnnotationFromDragCommand}" access:CommandAccessibility.CommandId="annotation.addStamp"
                              CommandParameter="ForPublicRelease"/>
                    <MenuItem Header="Information Only" Command="{Binding AddStampAnnotationFromDragCommand}" access:CommandAccessibility.CommandId="annotation.addStamp"
                              CommandParameter="InformationOnly"/>
                </MenuItem>
                <MenuItem Header="Add I_mage Stamp From Drag..." Command="{Binding AddImageStampAnnotationFromDragCommand}"
                          IsEnabled="{Binding IsDocumentLoaded}"
                          access:CommandAccessibility.CommandId="annotation.addImageStamp"/>
                <MenuItem Header="_Draw (Ink)" Command="{Binding ToggleFreehandModeCommand}"
                          IsEnabled="{Binding IsDocumentLoaded}"
                          access:CommandAccessibility.CommandId="annotation.toggleDrawMode"/>
                <MenuItem Header="Draw _Line" Command="{Binding ToggleLineModeCommand}"
                          IsEnabled="{Binding IsDocumentLoaded}"
                          access:CommandAccessibility.CommandId="annotation.toggleLineMode"/>
                <MenuItem Header="Draw _Arrow" Command="{Binding ToggleArrowModeCommand}"
                          IsEnabled="{Binding IsDocumentLoaded}"
                          access:CommandAccessibility.CommandId="annotation.toggleArrowMode"/>
                <MenuItem Header="Draw Pol_ygon" Command="{Binding TogglePolygonModeCommand}"
                          IsEnabled="{Binding IsDocumentLoaded}"
                          access:CommandAccessibility.CommandId="annotation.togglePolygonMode"/>
                <MenuItem Header="Draw Poly_Line" Command="{Binding TogglePolyLineModeCommand}"
                          IsEnabled="{Binding IsDocumentLoaded}"
                          access:CommandAccessibility.CommandId="annotation.togglePolyLineMode"/>

                <Separator/>
                <MenuItem Header="Add _Sticky Note..." Command="{Binding AddStickyNoteAnnotationCommand}"
                          IsEnabled="{Binding IsDocumentLoaded}"
                          access:CommandAccessibility.CommandId="annotation.addStickyNote"/>
                <MenuItem Header="_Place Sticky Note (click page)" Command="{Binding ToggleStickyNoteToolCommand}"
                          IsEnabled="{Binding IsDocumentLoaded}"
                          access:CommandAccessibility.CommandId="annotation.toggleStickyNoteTool"/>
            </MenuItem>

            <!-- DOCUMENT MENU -->
            <MenuItem Header="_Document">
                <MenuItem Header="_Add Pages..." Command="{Binding AddPagesCommand}"
                          access:CommandAccessibility.CommandId="document.addPages">
                    <MenuItem.Icon><PathIcon Classes="menu-icon" Data="{StaticResource IconAdd}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Insert Pages _Before Current..." Command="{Binding InsertPagesBeforeCurrentCommand}"
                          access:CommandAccessibility.CommandId="document.insertPagesBefore"/>
                <MenuItem Header="Insert Pages _After Current..." Command="{Binding InsertPagesAfterCurrentCommand}"
                          access:CommandAccessibility.CommandId="document.insertPagesAfter"/>
                <MenuItem Header="_Extract Current Page..." Command="{Binding ExtractCurrentPageCommand}"
                          access:CommandAccessibility.CommandId="document.extractCurrentPage"/>
                <MenuItem Header="Extract _Selected Pages..." Command="{Binding ExtractSelectedPagesCommand}"
                          IsEnabled="{Binding HasSelectedPages}"
                          access:CommandAccessibility.CommandId="document.extractSelectedPages"/>
                <Separator/>
                <MenuItem Header="_Combine Documents..." Command="{Binding CombineDocumentsCommand}"
                          access:CommandAccessibility.CommandId="document.combine"/>
                <MenuItem Header="S_plit Document..." Command="{Binding SplitDocumentCommand}"
                          IsEnabled="{Binding IsDocumentLoaded}"
                          access:CommandAccessibility.CommandId="document.split"/>
                <Separator/>
                <MenuItem Header="Move Page _Earlier" Command="{Binding MoveCurrentPageEarlierCommand}"
                          access:CommandAccessibility.CommandId="document.moveCurrentPageEarlier"/>
                <MenuItem Header="Move Page _Later" Command="{Binding MoveCurrentPageLaterCommand}"
                          access:CommandAccessibility.CommandId="document.moveCurrentPageLater"/>
                <MenuItem Header="Move Selected Pages E_arlier" Command="{Binding MoveSelectedPagesEarlierCommand}"
                          IsEnabled="{Binding CanMoveSelectedPagesEarlier}"
                          access:CommandAccessibility.CommandId="document.moveSelectedPagesEarlier"/>
                <MenuItem Header="Move Selected Pages L_ater" Command="{Binding MoveSelectedPagesLaterCommand}"
                          IsEnabled="{Binding CanMoveSelectedPagesLater}"
                          access:CommandAccessibility.CommandId="document.moveSelectedPagesLater"/>
                <Separator/>
                <MenuItem Header="_Remove Current Page" Command="{Binding RemoveCurrentPageCommand}"
                          IsEnabled="{Binding IsDocumentLoaded}"
                          access:CommandAccessibility.CommandId="document.removeCurrentPage">
                    <MenuItem.Icon><PathIcon Classes="menu-icon" Data="{StaticResource IconDelete}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Remove Selected Pages" Command="{Binding RemoveSelectedPagesCommand}"
                          IsEnabled="{Binding CanRemoveSelectedPages}"
                          access:CommandAccessibility.CommandId="document.removeSelectedPages"/>
                <MenuItem Header="Clear Page Selection" Command="{Binding ClearSelectedPagesCommand}"
                          IsEnabled="{Binding HasSelectedPages}"
                          access:CommandAccessibility.CommandId="document.clearPageSelection"/>
                <Separator/>
                <MenuItem Header="Rotate _Left 90°" Command="{Binding RotatePageLeftCommand}" InputGesture="Ctrl+L"
                          access:CommandAccessibility.CommandId="document.rotateLeft"/>
                <MenuItem Header="Rotate _Right 90°" Command="{Binding RotatePageRightCommand}" InputGesture="Ctrl+R"
                          access:CommandAccessibility.CommandId="document.rotateRight"/>
                <MenuItem Header="Rotate _180°" Command="{Binding RotatePage180Command}"
                          access:CommandAccessibility.CommandId="document.rotate180"/>
                <Separator/>
                <MenuItem Header="_Export Current Page..." Command="{Binding ExportCurrentPageCommand}" InputGesture="Ctrl+E"
                          access:CommandAccessibility.CommandId="document.exportCurrentPage"/>
                <MenuItem Header="Export _All Pages as Images..." Command="{Binding ExportPagesCommand}"
                          access:CommandAccessibility.CommandId="document.exportAllPages"/>
                <MenuItem Header="_Print..." Command="{Binding PrintCommand}" InputGesture="Ctrl+P"
                          IsEnabled="{Binding CanPrint}"
                          ToolTip.Tip="{Binding PrintDisabledReason}"
                          access:CommandAccessibility.CommandId="document.print"/>
                <Separator/>
                <MenuItem Header="_Security..." Command="{Binding SecurityCommand}"
                          ToolTip.Tip="Set, change, or remove password protection on this document."
                          IsEnabled="{Binding IsDocumentLoaded}"
                          access:CommandAccessibility.CommandId="document.security">
                    <MenuItem.Icon><PathIcon Classes="menu-icon" Data="{StaticResource IconLock}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Attachments" Command="{Binding AttachmentsCommand}"
                          ToolTip.Tip="Show the Attachments pane: files embedded in this document."
                          IsEnabled="{Binding IsDocumentLoaded}"
                          access:CommandAccessibility.CommandId="document.attachments"/>
                <MenuItem Header="_Bates Numbering..." Command="{Binding BatesNumberingCommand}"
                          ToolTip.Tip="Stamp a sequential Bates number on every page."
                          IsEnabled="{Binding IsDocumentLoaded}"
                          access:CommandAccessibility.CommandId="document.batesNumbering"/>
                <MenuItem Header="Reduce File Si_ze..." Command="{Binding ReduceFileSizeCommand}"
                          ToolTip.Tip="Save a smaller copy of this document. The original is not changed."
                          IsEnabled="{Binding IsDocumentLoaded}"
                          access:CommandAccessibility.CommandId="document.reduceFileSize"/>
            </MenuItem>

            <!-- REDACTION MENU -->
            <MenuItem Header="_Redaction">
                <MenuItem Header="_Enable Redaction Mode" Command="{Binding ToggleRedactionModeCommand}" InputGesture="R"
                          access:CommandAccessibility.CommandId="redaction.toggleMode">
                    <MenuItem.Icon>
                        <TextBlock Text="✓" IsVisible="{Binding IsRedactionMode}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Apply Redaction" Command="{Binding ApplyRedactionCommand}" InputGesture="Enter"
                          IsEnabled="{Binding IsRedactionMode}"
                          access:CommandAccessibility.CommandId="redaction.apply">
                    <MenuItem.Icon><PathIcon Classes="menu-icon" Data="{StaticResource IconRedact}" Foreground="#D32F2F"/></MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <!-- Toggle items bind IsChecked ONE-WAY and mutate state only via
                     their Command. A TwoWay IsChecked binding with no Command is
                     what desynced these menus before: MenuItem does not toggle
                     itself, so the click did nothing and the check never moved.
                     ToggleType is kept so screen readers still get the UIA Toggle
                     pattern (AutomationProperties alone cannot express it). -->
                <MenuItem x:Name="RedactionClipboardMenuItem"
                          Header="_View Clipboard History"
                          ToggleType="CheckBox"
                          IsChecked="{Binding IsClipboardSidebarVisible, Mode=OneWay}"
                          Command="{Binding ToggleClipboardSidebarCommand}"
                          access:CommandAccessibility.CommandId="view.toggleClipboardHistory"/>
            </MenuItem>

            <!-- TOOLS MENU -->
            <MenuItem Header="_Tools">
                <MenuItem Header="_Verify Digital Signatures..." Command="{Binding VerifySignaturesCommand}"
                          IsEnabled="{Binding IsDocumentLoaded}"
                          access:CommandAccessibility.CommandId="tools.verifySignatures">
                    <MenuItem.Icon><PathIcon Classes="menu-icon" Data="{StaticResource IconLock}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="RevealHiddenTextMenuItem"
                          Header="Reveal _Hidden Text (audit overlay)"
                          ToolTip.Tip="Surface text that is present in the PDF but visually covered by an opaque overlay — the classic 'black-box redaction' failure mode."
                          IsEnabled="{Binding IsDocumentLoaded}"
                          ToggleType="CheckBox"
                          IsChecked="{Binding RevealHiddenText, Mode=OneWay}"
                          Command="{Binding ToggleRevealHiddenTextCommand}"
                          access:CommandAccessibility.CommandId="tools.revealHiddenText"/>
                <MenuItem x:Name="RevealRasterizedHiddenMenuItem"
                          Header="Reveal _Rasterized Hidden Text (deep / OCR)"
                          ToolTip.Tip="Also run differential OCR: render the page with overlays stripped, OCR both versions, and surface words present only in the underlying raster. Slower; requires 'tesseract' on PATH."
                          IsEnabled="{Binding IsDocumentLoaded}"
                          ToggleType="CheckBox"
                          IsChecked="{Binding RevealRasterizedHidden, Mode=OneWay}"
                          Command="{Binding ToggleRevealRasterizedHiddenCommand}"
                          access:CommandAccessibility.CommandId="tools.revealRasterizedHiddenText"/>
                <Separator/>
                <MenuItem Header="Make _Searchable..." Command="{Binding MakeSearchableCommand}"
                          ToolTip.Tip="OCR scanned pages and write the recognized text back as an invisible, searchable layer."
                          IsEnabled="{Binding IsDocumentLoaded}"
                          access:CommandAccessibility.CommandId="tools.makeSearchable"/>
                <!-- #1476: the toolbar's auto-detect button is the second action a
                     narrow window hides, so it needs a menu home. -->
                <MenuItem Header="Auto-detect Form _Fields" Command="{Binding AutoDetectFieldsCommand}"
                          ToolTip.Tip="Heuristically add form fields where the page has underline placeholders or empty squares."
                          IsEnabled="{Binding IsDocumentLoaded}"
                          access:CommandAccessibility.CommandId="form.autoDetectFields"/>
                <Separator/>
                <MenuItem Header="_Preferences..." Command="{Binding ShowPreferencesCommand}" InputGesture="Ctrl+,"
                          access:CommandAccessibility.CommandId="app.preferences">
                    <MenuItem.Icon><PathIcon Classes="menu-icon" Data="{StaticResource IconSettings}"/></MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <!-- VIEW MENU -->
            <MenuItem Header="_View">
                <MenuItem Header="_Zoom In" Command="{Binding ZoomInCommand}" InputGesture="Ctrl++"
                          access:CommandAccessibility.CommandId="view.zoomIn"/>
                <MenuItem Header="Zoom _Out" Command="{Binding ZoomOutCommand}" InputGesture="Ctrl+-"
                          access:CommandAccessibility.CommandId="view.zoomOut"/>
                <MenuItem Header="_Actual Size" Command="{Binding ZoomActualSizeCommand}" InputGesture="Ctrl+D0"
                          access:CommandAccessibility.CommandId="view.zoomActualSize"/>
                <Separator/>
                <MenuItem Header="Fit _Width" Command="{Binding ZoomFitWidthCommand}" InputGesture="Ctrl+D1"
                          access:CommandAccessibility.CommandId="view.zoomFitWidth"/>
                <MenuItem Header="Fit _Page" Command="{Binding ZoomFitPageCommand}" InputGesture="Ctrl+D2"
                          access:CommandAccessibility.CommandId="view.zoomFitPage"/>
                <Separator/>
                <MenuItem x:Name="ViewContinuousMenuItem"
                          Header="_Continuous Scroll"
                          ToggleType="CheckBox"
                          IsChecked="{Binding IsContinuousView, Mode=OneWay}"
                          Command="{Binding ToggleContinuousViewCommand}"
                          InputGesture="Ctrl+Shift+C"
                          access:CommandAccessibility.CommandId="view.toggleContinuous"/>
                <Separator/>
                <MenuItem x:Name="ViewOutlineMenuItem"
                          Header="Show _Outline"
                          ToggleType="CheckBox"
                          IsChecked="{Binding IsOutlineSidebarVisible, Mode=OneWay}"
                          Command="{Binding ToggleOutlineCommand}"
                          InputGesture="Ctrl+Shift+O"
                          access:CommandAccessibility.CommandId="view.toggleOutline"/>
                <MenuItem x:Name="ViewThumbnailsMenuItem"
                          Header="Show _Thumbnails"
                          ToggleType="CheckBox"
                          IsChecked="{Binding IsThumbnailsSidebarVisible, Mode=OneWay}"
                          Command="{Binding ToggleThumbnailsCommand}"
                          InputGesture="Ctrl+Shift+T"
                          access:CommandAccessibility.CommandId="view.toggleThumbnails"/>
                <MenuItem x:Name="ViewAttachmentsMenuItem"
                          Header="Show Atta_chments"
                          ToggleType="CheckBox"
                          IsChecked="{Binding IsAttachmentsSidebarVisible, Mode=OneWay}"
                          Command="{Binding ToggleAttachmentsCommand}"
                          access:CommandAccessibility.CommandId="view.toggleAttachments"/>
                <MenuItem x:Name="ViewAnnotationsMenuItem"
                          Header="Show _Annotations"
                          ToggleType="CheckBox"
                          IsChecked="{Binding AreAnnotationsVisible, Mode=OneWay}"
                          Command="{Binding ToggleAnnotationsCommand}"
                          access:CommandAccessibility.CommandId="view.toggleAnnotations"/>
                <MenuItem x:Name="ViewCommentAnnotationsMenuItem"
                          Header="Show C_omments"
                          ToggleType="CheckBox"
                          IsChecked="{Binding AreCommentAnnotationsVisible, Mode=OneWay}"
                          Command="{Binding ToggleCommentAnnotationsCommand}"
                          access:CommandAccessibility.CommandId="view.toggleCommentAnnotations"/>
                <MenuItem x:Name="ViewFieldAndLinkAnnotationsMenuItem"
                          Header="Show Form _Fields and Links"
                          ToggleType="CheckBox"
                          IsChecked="{Binding AreFieldAndLinkAnnotationsVisible, Mode=OneWay}"
                          Command="{Binding ToggleFieldAndLinkAnnotationsCommand}"
                          access:CommandAccessibility.CommandId="view.toggleFieldAndLinkAnnotations"/>
                <MenuItem x:Name="ViewHighlightFormFieldsMenuItem"
                          Header="_Highlight Form Fields"
                          ToggleType="CheckBox"
                          IsChecked="{Binding AreFormFieldsHighlighted, Mode=OneWay}"
                          Command="{Binding ToggleFormFieldHighlightingCommand}"
                          access:CommandAccessibility.CommandId="view.toggleFormFieldHighlighting"/>
                <MenuItem x:Name="ViewAnnotationAuditMenuItem"
                          Header="Reveal Hi_dden Annotations (Audit)"
                          ToggleType="CheckBox"
                          IsChecked="{Binding IsAnnotationAuditModeEnabled, Mode=OneWay}"
                          Command="{Binding ToggleAnnotationAuditModeCommand}"
                          access:CommandAccessibility.CommandId="view.toggleAnnotationAuditMode"/>
                <MenuItem x:Name="ViewClipboardMenuItem"
                          Header="Show _Clipboard History"
                          ToggleType="CheckBox"
                          IsChecked="{Binding IsClipboardSidebarVisible, Mode=OneWay}"
                          Command="{Binding ToggleClipboardSidebarCommand}"
                          access:CommandAccessibility.CommandId="view.toggleClipboardHistory"/>
                <Separator/>
                <!-- #1789: two optional, independently-toggleable surfaces for the
                     same annotation commands the Annotate menu already exposes —
                     off by default, either/both/neither may be on. -->
                <MenuItem x:Name="ViewAnnotationToolbarMenuItem"
                          Header="Annotation _Toolbar"
                          ToggleType="CheckBox"
                          IsChecked="{Binding IsAnnotationToolbarVisible, Mode=OneWay}"
                          Command="{Binding ToggleAnnotationToolbarCommand}"
                          access:CommandAccessibility.CommandId="view.toggleAnnotationToolbar"/>
                <MenuItem x:Name="ViewAnnotationPaletteMenuItem"
                          Header="_Floating Annotation Palette"
                          ToggleType="CheckBox"
                          IsChecked="{Binding IsAnnotationPaletteVisible, Mode=OneWay}"
                          Command="{Binding ToggleAnnotationPaletteCommand}"
                          access:CommandAccessibility.CommandId="view.toggleAnnotationPalette"/>
            </MenuItem>

            <!-- WINDOW MENU (#1553): every open document; the view model builds
                 the entries (macOS builds its native Window menu instead). -->
            <MenuItem Header="_Window" Name="WindowMenu" ItemsSource="{Binding OpenDocumentMenuItems}"/>

            <!-- HELP MENU -->
            <MenuItem Header="_Help">
                <MenuItem Header="_Keyboard Shortcuts" Command="{Binding ShowShortcutsCommand}" InputGesture="F1"
                          access:CommandAccessibility.CommandId="app.keyboardShortcuts"/>
                <MenuItem Header="_Documentation" Command="{Binding ShowDocumentationCommand}"
                          access:CommandAccessibility.CommandId="app.documentation"/>
                <Separator/>
                <MenuItem Header="_About Excise" Command="{Binding AboutCommand}"
                          access:CommandAccessibility.CommandId="app.about"/>
            </MenuItem>
        </Menu>


        <!-- Modern Title Bar Area -->
        <!-- #1643: this row IS the window's title bar (the window extends its
             client area into the decorations), so it has to behave like one:
             drag to move and snap, double-click to zoom. Avalonia does not
             wire that up for a custom title area — the window must call
             BeginMoveDrag itself, which is what the code-behind does. -->
        <Grid x:Name="TitleBarArea"
              Grid.Row="2" Height="40" Background="{DynamicResource ToolbarBackgroundBrush}"
              ColumnDefinitions="Auto,*,Auto">
            <!-- App Icon and Title -->
            <StackPanel x:Name="TitleBarAppLabel"
                        Grid.Column="0"
                        Orientation="Horizontal"
                        Spacing="10"
                        Margin="10,0">
                <TextBlock Text="Excise"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Center area for document name -->
            <TextBlock Grid.Column="1"
                       Text="{Binding DocumentName, FallbackValue='No document open'}"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>
        </Grid>

        <!-- Main toolbar (#1476). It never scrolls and never wraps: as it narrows,
             PriorityToolbarPanel drops the text labels, then shrinks the icons
             twice (the :icon-only / :dense / :compact styles in Window.Styles),
             then hides whole priority groups, lowest first. Everything it can hide is also
             in the menu (MainMenuBar here, MacNativeMenuBuilder on macOS), so
             hiding only decides what stays one click away. ToolbarWidthTests
             pins all of this.

             Priorities (higher stays longer; equal values hide together):
               97  typewriter style flyout      (size + alignment + the eight
                                                 colour presets, in one flyout;
                                                 the button has no command of its
                                                 own, so no menu entry stands in
                                                 for it; shown only while styling
                                                 a box. The colours inside it ARE
                                                 in Edit > Typewriter Text Color)
               95  Redact, Apply
               90  Open, Save; form field type (no command; form mode only)
               85  Find
               80  Select Text, Type
               60  outline + thumbnails sidebars
               55  continuous scroll
               50  highlight, sticky note
               25  Flatten Form
               20  Form Authoring
               15  Auto-detect Fields
               10  rotate left/right            (Document menu, Ctrl+L / Ctrl+R)
             Zoom keeps its own Auto column, so #589's guarantee holds by
             construction and zoom is never hidden.

             Direct children of the panel must not bind IsVisible: the panel
             owns it. A contextual item binds PriorityToolbarPanel.IsAvailable. -->
        <StackPanel Grid.Row="3">
        <Border x:Name="ToolbarBorder"
                Background="{DynamicResource SecondaryBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="8,6">
            <Grid ColumnDefinitions="*,Auto">
                <toolbar:PriorityToolbarPanel x:Name="ToolbarActionsPanel"
                                              Grid.Column="0"
                                              Spacing="4"
                                              MinHeight="32"
                                              ClipToBounds="True"
                                              Margin="0,0,8,0">
                    <!-- View Group: sidebar toggles (outline + page previews) -->
                    <Button x:Name="ToolbarOutlineButton"
                            toolbar:PriorityToolbarPanel.Priority="60"
                            Command="{Binding ToggleOutlineCommand}"
                            Classes="modern-button toggle toolbar-button"
                            Classes.active="{Binding IsOutlineSidebarVisible}"
                            access:CommandAccessibility.CommandId="view.toggleOutline"
                            ToolTip.Tip="Show/hide Outline (Ctrl+Shift+O)"
                            AutomationProperties.Name="Toggle Outline Sidebar"
                            AutomationProperties.HelpText="Show or hide the document outline / bookmarks panel">
                        <PathIcon Classes="toolbar-icon" Data="{StaticResource IconOutline}"/>
                    </Button>
                    <Button x:Name="ToolbarThumbnailsButton"
                            toolbar:PriorityToolbarPanel.Priority="60"
                            Command="{Binding ToggleThumbnailsCommand}"
                            Classes="modern-button toggle toolbar-button"
                            Classes.active="{Binding IsThumbnailsSidebarVisible}"
                            access:CommandAccessibility.CommandId="view.toggleThumbnails"
                            ToolTip.Tip="Show/hide Page Previews (Ctrl+Shift+T)"
                            AutomationProperties.Name="Toggle Thumbnails Sidebar"
                            AutomationProperties.HelpText="Show or hide the page thumbnails / previews panel">
                        <PathIcon Classes="toolbar-icon" Data="{StaticResource IconThumbnails}"/>
                    </Button>
                    <Button x:Name="ToolbarContinuousButton"
                            toolbar:PriorityToolbarPanel.Priority="55"
                            Command="{Binding ToggleContinuousViewCommand}"
                            Classes="modern-button toggle toolbar-button"
                            Classes.active="{Binding IsContinuousView}"
                            access:CommandAccessibility.CommandId="view.toggleContinuous"
                            ToolTip.Tip="Continuous scroll view (Ctrl+Shift+C)"
                            AutomationProperties.Name="Continuous Scroll View"
                            AutomationProperties.HelpText="Toggle between single-page editing view and continuous reading view">
                        <PathIcon Classes="toolbar-icon" Data="{StaticResource IconContinuous}"/>
                    </Button>

                    <Border toolbar:PriorityToolbarPanel.IsSeparator="True"
                            Width="1" Height="24" Margin="6,0"
                            Background="{DynamicResource DividerBrush}"/>

                    <!-- File Group -->
                    <Button toolbar:PriorityToolbarPanel.Priority="90"
                            Command="{Binding OpenFileCommand}"
                            Classes="modern-button toolbar-button labelled"
                            access:CommandAccessibility.CommandId="app.open"
                            ToolTip.Tip="Open PDF (Ctrl+O)"
                            AutomationProperties.Name="Open PDF File"
                            AutomationProperties.HelpText="Opens a file dialog to select a PDF document">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Classes="toolbar-icon" Data="{StaticResource IconFolderOpen}"/>
                            <TextBlock Classes="toolbar-label" Text="Open"/>
                        </StackPanel>
                    </Button>
                    <Button toolbar:PriorityToolbarPanel.Priority="90"
                            Command="{Binding SaveFileCommand}"
                            Classes="modern-button toolbar-button labelled"
                            IsEnabled="{Binding IsDocumentLoaded}"
                            access:CommandAccessibility.CommandId="app.save"
                            ToolTip.Tip="Save (Ctrl+S)"
                            AutomationProperties.Name="Save Document"
                            AutomationProperties.HelpText="Saves the current PDF document">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Classes="toolbar-icon" Data="{StaticResource IconSave}"/>
                            <TextBlock Classes="toolbar-label" Text="{Binding SaveButtonText}"/>
                        </StackPanel>
                    </Button>
                    <Button toolbar:PriorityToolbarPanel.Priority="25"
                            Command="{Binding SaveFlattenedFormCopyCommand}"
                            Classes="modern-button toolbar-button labelled"
                            IsEnabled="{Binding IsDocumentLoaded}"
                            access:CommandAccessibility.CommandId="form.saveFlattenedCopy"
                            ToolTip.Tip="Save a flattened copy of filled form values"
                            AutomationProperties.Name="Save Flattened Form Copy"
                            AutomationProperties.HelpText="Creates a copy where interactive form values are baked into page content">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Classes="toolbar-icon" Data="{StaticResource IconLayers}"/>
                            <TextBlock Classes="toolbar-label" Text="Flatten Form"/>
                        </StackPanel>
                    </Button>

                    <Border toolbar:PriorityToolbarPanel.IsSeparator="True"
                            Width="1" Height="24" Margin="6,0"
                            Background="{DynamicResource DividerBrush}"/>

                    <!-- Mode Toggles -->
                    <Button toolbar:PriorityToolbarPanel.Priority="80"
                            Command="{Binding ToggleTextSelectionModeCommand}"
                            Classes="modern-button toggle toolbar-button labelled"
                            Classes.active="{Binding IsTextSelectionMode}"
                            IsEnabled="{Binding IsDocumentLoaded}"
                            access:CommandAccessibility.CommandId="edit.selectTextMode"
                            ToolTip.Tip="Text Selection Mode (T)"
                            AutomationProperties.Name="Text Selection Mode"
                            AutomationProperties.HelpText="Toggle text selection mode to select and copy text">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Classes="toolbar-icon" Data="{StaticResource IconTextSelect}"/>
                            <TextBlock Classes="toolbar-label" Text="Select Text"/>
                        </StackPanel>
                    </Button>

                    <Button toolbar:PriorityToolbarPanel.Priority="80"
                            Command="{Binding ToggleTypewriterModeCommand}"
                            Classes="modern-button toggle toolbar-button labelled"
                            Classes.active="{Binding IsTypewriterMode}"
                            IsEnabled="{Binding IsDocumentLoaded}"
                            access:CommandAccessibility.CommandId="edit.typewriterMode"
                            ToolTip.Tip="Typewriter Mode"
                            AutomationProperties.Name="Typewriter Mode"
                            AutomationProperties.HelpText="Place editable text that saves as flat PDF page content">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Classes="toolbar-icon" Data="{StaticResource IconTypewriter}"/>
                            <TextBlock Classes="toolbar-label" Text="Type"/>
                        </StackPanel>
                    </Button>

                    <!-- #781: style inspector for the ACTIVE type-over box.
                         Available only in typewriter mode with a box active.
                         Every control routes through WithStyle on the active
                         PdfTypewriterTextOperation (MainWindowViewModel.TypewriterStyle.cs).

                         #1476 follow-up: the WHOLE inspector — size, alignment
                         AND the eight colour presets — lives in ONE FLYOUT.
                         Inline, the three controls cost the toolbar ~330 px
                         whenever a type-over box was active, which pushed the
                         whole row past icon-only even on a 1600 px window: the
                         user lost every unrelated label for the duration of a
                         text edit. One button costs ~50 px instead. The flyout
                         content keeps the old inline layout, the old x:Names and
                         the old automation names.

                         The button shows the active colour beside the glyph, so
                         the one piece of state the inspector used to display on
                         the toolbar is still visible without opening anything.

                         ⚠️ Do NOT put Classes="toolbar-label" on anything inside
                         the flyout: flyout content is logically parented to the
                         toolbar, so the :icon-only style would hide it while the
                         flyout is open. -->
                    <Button x:Name="TypewriterStyleFlyoutButton"
                            toolbar:PriorityToolbarPanel.Priority="97"
                            toolbar:PriorityToolbarPanel.IsAvailable="{Binding IsTypewriterStyleInspectorVisible}"
                            Classes="modern-button toolbar-button"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Typewriter Text Style"
                            AutomationProperties.HelpText="Font size, alignment and colour of the active type-over text box"
                            ToolTip.Tip="Text size, alignment and color of the active text box">
                        <!-- Deliberately NOT Classes="…labelled": that class only
                             widens the padding to 12,6, and the 4 px it adds at
                             :icon-only would put the typewriter row within a
                             pixel of the 1024 px boundary (measured: icon-only
                             row 842 against 846 available). The label itself is
                             free at every stage below Full, where it is hidden. -->
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <PathIcon Classes="toolbar-icon" Data="{StaticResource IconTextStyle}"/>
                            <Border Width="10" Height="16" CornerRadius="2"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource DividerBrush}"
                                    Background="{Binding TypewriterColorBrush}"
                                    AutomationProperties.Name="Active Typewriter Text Color"/>
                            <TextBlock Classes="toolbar-label" Text="Style" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout>
                                <StackPanel Spacing="8" Width="184">
                                    <TextBlock Text="Text style" FontWeight="Medium" FontSize="11"/>
                                    <StackPanel x:Name="TypewriterFontSizeGroup"
                                                Orientation="Horizontal" Spacing="6"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="Size" VerticalAlignment="Center" FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <NumericUpDown x:Name="TypewriterFontSizeUpDown"
                                                       Value="{Binding TypewriterFontSize}"
                                                       Minimum="4" Maximum="96" Increment="1"
                                                       FormatString="0" Width="130"
                                                       VerticalAlignment="Center"
                                                       AutomationProperties.Name="Typewriter Font Size"
                                                       AutomationProperties.HelpText="Font size of the active type-over text box"
                                                       ToolTip.Tip="Font size of the active text box"/>
                                    </StackPanel>
                                    <ComboBox x:Name="TypewriterAlignmentComboBox"
                                              SelectedIndex="{Binding TypewriterAlignmentIndex}"
                                              HorizontalAlignment="Stretch"
                                              MinWidth="92" VerticalAlignment="Center"
                                              AutomationProperties.Name="Typewriter Text Alignment"
                                              AutomationProperties.HelpText="Text alignment of the active type-over text box"
                                              ToolTip.Tip="Text alignment of the active text box">
                                        <ComboBoxItem Content="Left"/>
                                        <ComboBoxItem Content="Center"/>
                                        <ComboBoxItem Content="Right"/>
                                    </ComboBox>
                                    <TextBlock Text="Color" FontWeight="Medium" FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <!-- #1476: the same eight presets are in Edit > Typewriter Text
                                         Color and in MacNativeMenuBuilder; TypewriterColorPresetAccessibilityTests
                                         keeps the three lists equal AND keeps each one named.

                                         Each swatch carries its OWN command id, so CommandAccessibility
                                         gives it a distinct accessible name and tooltip from the registry
                                         — do NOT add AutomationProperties.Name or ToolTip.Tip here: they
                                         are overwritten at runtime and would drift from the registry
                                         silently. The x:Name is what identifies the swatch in
                                         tests/gui-interaction-registry.json, which reads the XAML rather
                                         than the runtime tree and so cannot see the registry's label. -->
                                    <WrapPanel>
                                        <Button x:Name="TypewriterColorSwatchBlack"
                                                Width="28" Height="28" Padding="2" Margin="2"
                                                Command="{Binding SetTypewriterColorCommand}"
                                                access:CommandAccessibility.CommandId="typewriter.setColor.black"
                                                CommandParameter="#000000">
                                            <Border Background="#000000" CornerRadius="2"/>
                                        </Button>
                                        <Button x:Name="TypewriterColorSwatchGray"
                                                Width="28" Height="28" Padding="2" Margin="2"
                                                Command="{Binding SetTypewriterColorCommand}"
                                                access:CommandAccessibility.CommandId="typewriter.setColor.gray"
                                                CommandParameter="#555555">
                                            <Border Background="#555555" CornerRadius="2"/>
                                        </Button>
                                        <Button x:Name="TypewriterColorSwatchRed"
                                                Width="28" Height="28" Padding="2" Margin="2"
                                                Command="{Binding SetTypewriterColorCommand}"
                                                access:CommandAccessibility.CommandId="typewriter.setColor.red"
                                                CommandParameter="#D0021B">
                                            <Border Background="#D0021B" CornerRadius="2"/>
                                        </Button>
                                        <Button x:Name="TypewriterColorSwatchOrange"
                                                Width="28" Height="28" Padding="2" Margin="2"
                                                Command="{Binding SetTypewriterColorCommand}"
                                                access:CommandAccessibility.CommandId="typewriter.setColor.orange"
                                                CommandParameter="#F5A623">
                                            <Border Background="#F5A623" CornerRadius="2"/>
                                        </Button>
                                        <Button x:Name="TypewriterColorSwatchGreen"
                                                Width="28" Height="28" Padding="2" Margin="2"
                                                Command="{Binding SetTypewriterColorCommand}"
                                                access:CommandAccessibility.CommandId="typewriter.setColor.green"
                                                CommandParameter="#2E7D32">
                                            <Border Background="#2E7D32" CornerRadius="2"/>
                                        </Button>
                                        <Button x:Name="TypewriterColorSwatchBlue"
                                                Width="28" Height="28" Padding="2" Margin="2"
                                                Command="{Binding SetTypewriterColorCommand}"
                                                access:CommandAccessibility.CommandId="typewriter.setColor.blue"
                                                CommandParameter="#1565C0">
                                            <Border Background="#1565C0" CornerRadius="2"/>
                                        </Button>
                                        <Button x:Name="TypewriterColorSwatchPurple"
                                                Width="28" Height="28" Padding="2" Margin="2"
                                                Command="{Binding SetTypewriterColorCommand}"
                                                access:CommandAccessibility.CommandId="typewriter.setColor.purple"
                                                CommandParameter="#6A1B9A">
                                            <Border Background="#6A1B9A" CornerRadius="2"/>
                                        </Button>
                                        <Button x:Name="TypewriterColorSwatchWhite"
                                                Width="28" Height="28" Padding="2" Margin="2"
                                                Command="{Binding SetTypewriterColorCommand}"
                                                access:CommandAccessibility.CommandId="typewriter.setColor.white"
                                                CommandParameter="#FFFFFF">
                                            <Border Background="#FFFFFF" CornerRadius="2"/>
                                        </Button>
                                    </WrapPanel>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <Border toolbar:PriorityToolbarPanel.IsSeparator="True"
                            toolbar:PriorityToolbarPanel.IsAvailable="{Binding IsTypewriterStyleInspectorVisible}"
                            Width="1" Height="24" Margin="6,0"
                            Background="{DynamicResource DividerBrush}"/>

                    <Button toolbar:PriorityToolbarPanel.Priority="50"
                            Command="{Binding AddHighlightAnnotationFromSelectionCommand}"
                            Classes="modern-button toolbar-button"
                            IsEnabled="{Binding HasTextSelection}"
                            access:CommandAccessibility.CommandId="annotation.addHighlight"
                            ToolTip.Tip="Add highlight from selected text"
                            AutomationProperties.Name="Add Highlight From Selection"
                            AutomationProperties.HelpText="Creates a real PDF highlight annotation from the current text selection">
                        <PathIcon Classes="toolbar-icon" Data="{StaticResource IconHighlight}"/>
                    </Button>

                    <Button toolbar:PriorityToolbarPanel.Priority="50"
                            Command="{Binding AddStickyNoteAnnotationCommand}"
                            Classes="modern-button toolbar-button"
                            IsEnabled="{Binding IsDocumentLoaded}"
                            access:CommandAccessibility.CommandId="annotation.addStickyNote"
                            ToolTip.Tip="Add sticky note"
                            AutomationProperties.Name="Add Sticky Note"
                            AutomationProperties.HelpText="Creates a real PDF sticky-note annotation on the current page or text selection">
                        <PathIcon Classes="toolbar-icon" Data="{StaticResource IconNote}"/>
                    </Button>

                    <Button toolbar:PriorityToolbarPanel.Priority="95"
                            Command="{Binding ToggleRedactionModeCommand}"
                            Classes="modern-button toggle toolbar-button labelled"
                            Classes.active="{Binding IsRedactionMode}"
                            IsEnabled="{Binding IsDocumentLoaded}"
                            access:CommandAccessibility.CommandId="redaction.toggleMode"
                            ToolTip.Tip="Redaction Mode (R)"
                            AutomationProperties.Name="Redaction Mode"
                            AutomationProperties.HelpText="Toggle redaction mode to mark areas for removal">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Classes="toolbar-icon" Data="{StaticResource IconRedact}"/>
                            <TextBlock Classes="toolbar-label" Text="Redact"/>
                        </StackPanel>
                    </Button>

                    <Button toolbar:PriorityToolbarPanel.Priority="95"
                            toolbar:PriorityToolbarPanel.IsAvailable="{Binding IsRedactionMode}"
                            Command="{Binding ApplyRedactionCommand}"
                            Classes="modern-button primary toolbar-button labelled"
                            IsEnabled="{Binding IsRedactionMode}"
                            access:CommandAccessibility.CommandId="redaction.apply"
                            ToolTip.Tip="Apply Redaction (Enter)"
                            AutomationProperties.Name="Apply Redaction"
                            AutomationProperties.HelpText="Apply the current redaction selection">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Classes="toolbar-icon" Data="{StaticResource IconCheck}"/>
                            <TextBlock Classes="toolbar-label" Text="Apply"/>
                        </StackPanel>
                    </Button>

                    <Border toolbar:PriorityToolbarPanel.IsSeparator="True"
                            Width="1" Height="24" Margin="6,0"
                            Background="{DynamicResource DividerBrush}"/>

                    <!-- Form Authoring -->
                    <Button toolbar:PriorityToolbarPanel.Priority="20"
                            Command="{Binding ToggleFormAuthoringModeCommand}"
                            Classes="modern-button toggle toolbar-button"
                            Classes.active="{Binding IsFormAuthoringMode}"
                            IsEnabled="{Binding IsDocumentLoaded}"
                            access:CommandAccessibility.CommandId="form.toggleAuthoring"
                            ToolTip.Tip="Form Authoring Mode — drag to define a new field"
                            AutomationProperties.Name="Form Authoring Mode">
                        <PathIcon Classes="toolbar-icon" Data="{StaticResource IconForm}"/>
                    </Button>

                    <ComboBox x:Name="FormFieldTypeComboBox"
                              toolbar:PriorityToolbarPanel.Priority="90"
                              toolbar:PriorityToolbarPanel.IsAvailable="{Binding IsFormAuthoringMode}"
                              SelectedIndex="0"
                              IsEnabled="{Binding IsDocumentLoaded}"
                              SelectionChanged="OnFormFieldTypeChanged"
                              ToolTip.Tip="Field type for the next drag"
                              MinWidth="100" Margin="4,0">
                        <ComboBoxItem Content="Text"/>
                        <ComboBoxItem Content="Checkbox"/>
                        <ComboBoxItem Content="Choice"/>
                        <ComboBoxItem Content="Signature"/>
                    </ComboBox>

                    <Button toolbar:PriorityToolbarPanel.Priority="15"
                            Command="{Binding AutoDetectFieldsCommand}"
                            Classes="modern-button toolbar-button"
                            IsEnabled="{Binding IsDocumentLoaded}"
                            access:CommandAccessibility.CommandId="form.autoDetectFields"
                            ToolTip.Tip="Heuristically add form fields where the page has underline placeholders or empty squares"
                            AutomationProperties.Name="Auto-detect Form Fields">
                        <PathIcon Classes="toolbar-icon" Data="{StaticResource IconSparkles}"/>
                    </Button>

                    <Border toolbar:PriorityToolbarPanel.IsSeparator="True"
                            Width="1" Height="24" Margin="6,0"
                            Background="{DynamicResource DividerBrush}"/>

                    <!-- Tools Group -->
                    <Button toolbar:PriorityToolbarPanel.Priority="85"
                            Command="{Binding ToggleSearchCommand}"
                            Classes="modern-button toolbar-button labelled"
                            IsEnabled="{Binding IsDocumentLoaded}"
                            access:CommandAccessibility.CommandId="search.open"
                            ToolTip.Tip="Find Text (Ctrl+F)"
                            AutomationProperties.Name="Find Text"
                            AutomationProperties.HelpText="Opens the search bar to find text in the document">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Classes="toolbar-icon" Data="{StaticResource IconSearch}"/>
                            <TextBlock Classes="toolbar-label" Text="Find"/>
                        </StackPanel>
                    </Button>

                    <Border toolbar:PriorityToolbarPanel.IsSeparator="True"
                            Width="1" Height="24" Margin="6,0"
                            Background="{DynamicResource DividerBrush}"/>

                    <!-- Page Rotation -->
                    <Button toolbar:PriorityToolbarPanel.Priority="10"
                            Content="↺" Command="{Binding RotatePageLeftCommand}"
                            Classes="modern-button toolbar-button toolbar-glyph"
                            IsEnabled="{Binding IsDocumentLoaded}"
                            access:CommandAccessibility.CommandId="document.rotateLeft"
                            ToolTip.Tip="Rotate Left (Ctrl+L)"
                            AutomationProperties.Name="Rotate Page Left"
                            AutomationProperties.HelpText="Rotate the current page 90 degrees counter-clockwise"/>
                    <Button toolbar:PriorityToolbarPanel.Priority="10"
                            Content="↻" Command="{Binding RotatePageRightCommand}"
                            Classes="modern-button toolbar-button toolbar-glyph"
                            IsEnabled="{Binding IsDocumentLoaded}"
                            access:CommandAccessibility.CommandId="document.rotateRight"
                            ToolTip.Tip="Rotate Right (Ctrl+R)"
                            AutomationProperties.Name="Rotate Page Right"
                            AutomationProperties.HelpText="Rotate the current page 90 degrees clockwise"/>
                </toolbar:PriorityToolbarPanel>

                <!-- Right: Zoom Controls -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                    <Button Content="−" Command="{Binding ZoomOutCommand}"
                            Classes="modern-button" Padding="10,6" FontWeight="Bold"
                            IsEnabled="{Binding IsDocumentLoaded}"
                            access:CommandAccessibility.CommandId="view.zoomOut"
                            ToolTip.Tip="Zoom Out (Ctrl+-)"
                            AutomationProperties.Name="Zoom Out"
                            AutomationProperties.HelpText="Decrease zoom level"/>
                    <TextBlock Text="{Binding ZoomLevel, StringFormat='{}{0:P0}'}"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               MinWidth="45" TextAlignment="Center"
                               FontSize="12" FontWeight="Medium"
                               AutomationProperties.Name="Zoom Level"/>
                    <Button Content="+" Command="{Binding ZoomInCommand}"
                            Classes="modern-button" Padding="10,6" FontWeight="Bold"
                            IsEnabled="{Binding IsDocumentLoaded}"
                            access:CommandAccessibility.CommandId="view.zoomIn"
                            ToolTip.Tip="Zoom In (Ctrl++)"
                            AutomationProperties.Name="Zoom In"
                            AutomationProperties.HelpText="Increase zoom level"/>
                    <Button Content="Fit" Command="{Binding ZoomFitWidthCommand}"
                            Classes="modern-button" Padding="10,6" FontSize="11"
                            IsEnabled="{Binding IsDocumentLoaded}"
                            access:CommandAccessibility.CommandId="view.zoomFitWidth"
                            ToolTip.Tip="Fit Width (Ctrl+1)"
                            AutomationProperties.Name="Fit Width"
                            AutomationProperties.HelpText="Fit the page to the window width. Shortcut: Ctrl+1."/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- #1789: the optional second annotation toolbar row — off by default,
             toggled from View ▸ Annotation Toolbar. Every one of the 15
             annotation commands lives here regardless of what the main toolbar
             above already carries (Highlight and Sticky Note duplicate main-
             toolbar buttons): this row is meant to stand alone as a complete
             annotation strip, and a would-be user of it should not have to look
             at two rows to find every tool. IsVisible is bound on this Border,
             never on a PriorityToolbarPanel child (see the note on
             ToolbarActionsPanel above) — same never-scroll, never-wrap
             discipline as the main toolbar, just with a shorter Priority list
             since the Annotate menu is always the fallback for anything this
             row overflows. -->
        <Border x:Name="AnnotationToolbarBorder"
                IsVisible="{Binding IsAnnotationToolbarVisible}"
                Background="{DynamicResource SecondaryBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="8,6">
            <toolbar:PriorityToolbarPanel x:Name="AnnotationToolbarPanel"
                                          Spacing="4"
                                          MinHeight="32"
                                          ClipToBounds="True">
                <Button x:Name="AnnotationToolbarHighlightButton"
                        toolbar:PriorityToolbarPanel.Priority="100"
                        Command="{Binding AddHighlightAnnotationFromSelectionCommand}"
                        Classes="modern-button toolbar-button"
                        IsEnabled="{Binding HasTextSelection}"
                        access:CommandAccessibility.CommandId="annotation.addHighlight"
                        ToolTip.Tip="Add highlight from selected text"
                        AutomationProperties.Name="Add Highlight From Selection">
                    <PathIcon Classes="toolbar-icon" Data="{StaticResource IconHighlight}"/>
                </Button>
                <Button x:Name="AnnotationToolbarUnderlineButton"
                        toolbar:PriorityToolbarPanel.Priority="95"
                        Command="{Binding AddUnderlineAnnotationFromSelectionCommand}"
                        Classes="modern-button toolbar-button"
                        IsEnabled="{Binding HasTextSelection}"
                        access:CommandAccessibility.CommandId="annotation.addUnderline"
                        ToolTip.Tip="Add underline from selected text"
                        AutomationProperties.Name="Add Underline From Selection">
                    <PathIcon Classes="toolbar-icon" Data="{StaticResource IconUnderline}"/>
                </Button>
                <Button x:Name="AnnotationToolbarStrikeOutButton"
                        toolbar:PriorityToolbarPanel.Priority="90"
                        Command="{Binding AddStrikeOutAnnotationFromSelectionCommand}"
                        Classes="modern-button toolbar-button"
                        IsEnabled="{Binding HasTextSelection}"
                        access:CommandAccessibility.CommandId="annotation.addStrikeOut"
                        ToolTip.Tip="Add strikeout from selected text"
                        AutomationProperties.Name="Add Strikeout From Selection">
                    <PathIcon Classes="toolbar-icon" Data="{StaticResource IconStrikeOut}"/>
                </Button>
                <Button x:Name="AnnotationToolbarSquigglyButton"
                        toolbar:PriorityToolbarPanel.Priority="85"
                        Command="{Binding AddSquigglyAnnotationFromSelectionCommand}"
                        Classes="modern-button toolbar-button"
                        IsEnabled="{Binding HasTextSelection}"
                        access:CommandAccessibility.CommandId="annotation.addSquiggly"
                        ToolTip.Tip="Add squiggly underline from selected text"
                        AutomationProperties.Name="Add Squiggly From Selection">
                    <PathIcon Classes="toolbar-icon" Data="{StaticResource IconSquiggly}"/>
                </Button>

                <Border toolbar:PriorityToolbarPanel.IsSeparator="True"
                        Width="1" Height="24" Margin="6,0"
                        Background="{DynamicResource DividerBrush}"/>

                <Button x:Name="AnnotationToolbarSquareButton"
                        toolbar:PriorityToolbarPanel.Priority="80"
                        Command="{Binding AddSquareAnnotationFromDragCommand}"
                        Classes="modern-button toolbar-button"
                        IsEnabled="{Binding IsDocumentLoaded}"
                        access:CommandAccessibility.CommandId="annotation.addSquare"
                        ToolTip.Tip="Add square from drag"
                        AutomationProperties.Name="Add Square">
                    <PathIcon Classes="toolbar-icon" Data="{StaticResource IconSquare}"/>
                </Button>
                <Button x:Name="AnnotationToolbarCircleButton"
                        toolbar:PriorityToolbarPanel.Priority="75"
                        Command="{Binding AddCircleAnnotationFromDragCommand}"
                        Classes="modern-button toolbar-button"
                        IsEnabled="{Binding IsDocumentLoaded}"
                        access:CommandAccessibility.CommandId="annotation.addCircle"
                        ToolTip.Tip="Add circle from drag"
                        AutomationProperties.Name="Add Circle">
                    <PathIcon Classes="toolbar-icon" Data="{StaticResource IconCircle}"/>
                </Button>
                <Button x:Name="AnnotationToolbarFreeTextButton"
                        toolbar:PriorityToolbarPanel.Priority="70"
                        Command="{Binding AddFreeTextAnnotationFromDragCommand}"
                        Classes="modern-button toolbar-button"
                        IsEnabled="{Binding IsDocumentLoaded}"
                        access:CommandAccessibility.CommandId="annotation.addFreeText"
                        ToolTip.Tip="Add text box from drag"
                        AutomationProperties.Name="Add Text Box">
                    <PathIcon Classes="toolbar-icon" Data="{StaticResource IconFreeText}"/>
                </Button>
                <Button x:Name="AnnotationToolbarStampButton"
                        toolbar:PriorityToolbarPanel.Priority="65"
                        Classes="modern-button toolbar-button"
                        IsEnabled="{Binding IsDocumentLoaded}"
                        ToolTip.Tip="Add stamp from drag"
                        AutomationProperties.Name="Add Stamp">
                    <PathIcon Classes="toolbar-icon" Data="{StaticResource IconStamp}"/>
                    <Button.Flyout>
                        <Flyout>
                            <StackPanel Spacing="2" Width="168">
                                <Button Content="Approved" Command="{Binding AddStampAnnotationFromDragCommand}" CommandParameter="Approved" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" access:CommandAccessibility.CommandId="annotation.addStamp"/>
                                <Button Content="Experimental" Command="{Binding AddStampAnnotationFromDragCommand}" CommandParameter="Experimental" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" access:CommandAccessibility.CommandId="annotation.addStamp"/>
                                <Button Content="Not Approved" Command="{Binding AddStampAnnotationFromDragCommand}" CommandParameter="NotApproved" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" access:CommandAccessibility.CommandId="annotation.addStamp"/>
                                <Button Content="As Is" Command="{Binding AddStampAnnotationFromDragCommand}" CommandParameter="AsIs" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" access:CommandAccessibility.CommandId="annotation.addStamp"/>
                                <Button Content="Expired" Command="{Binding AddStampAnnotationFromDragCommand}" CommandParameter="Expired" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" access:CommandAccessibility.CommandId="annotation.addStamp"/>
                                <Button Content="Not For Public Release" Command="{Binding AddStampAnnotationFromDragCommand}" CommandParameter="NotForPublicRelease" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" access:CommandAccessibility.CommandId="annotation.addStamp"/>
                                <Button Content="Confidential" Command="{Binding AddStampAnnotationFromDragCommand}" CommandParameter="Confidential" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" access:CommandAccessibility.CommandId="annotation.addStamp"/>
                                <Button Content="Sold" Command="{Binding AddStampAnnotationFromDragCommand}" CommandParameter="Sold" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" access:CommandAccessibility.CommandId="annotation.addStamp"/>
                                <Button Content="Departmental" Command="{Binding AddStampAnnotationFromDragCommand}" CommandParameter="Departmental" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" access:CommandAccessibility.CommandId="annotation.addStamp"/>
                                <Button Content="Top Secret" Command="{Binding AddStampAnnotationFromDragCommand}" CommandParameter="TopSecret" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" access:CommandAccessibility.CommandId="annotation.addStamp"/>
                                <Button Content="Draft" Command="{Binding AddStampAnnotationFromDragCommand}" CommandParameter="Draft" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" access:CommandAccessibility.CommandId="annotation.addStamp"/>
                                <Button Content="For Comment" Command="{Binding AddStampAnnotationFromDragCommand}" CommandParameter="ForComment" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" access:CommandAccessibility.CommandId="annotation.addStamp"/>
                                <Button Content="Final" Command="{Binding AddStampAnnotationFromDragCommand}" CommandParameter="Final" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" access:CommandAccessibility.CommandId="annotation.addStamp"/>
                                <Button Content="For Public Release" Command="{Binding AddStampAnnotationFromDragCommand}" CommandParameter="ForPublicRelease" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" access:CommandAccessibility.CommandId="annotation.addStamp"/>
                                <Button Content="Information Only" Command="{Binding AddStampAnnotationFromDragCommand}" CommandParameter="InformationOnly" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" access:CommandAccessibility.CommandId="annotation.addStamp"/>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button x:Name="AnnotationToolbarImageStampButton"
                        toolbar:PriorityToolbarPanel.Priority="60"
                        Command="{Binding AddImageStampAnnotationFromDragCommand}"
                        Classes="modern-button toolbar-button"
                        IsEnabled="{Binding IsDocumentLoaded}"
                        access:CommandAccessibility.CommandId="annotation.addImageStamp"
                        ToolTip.Tip="Add image stamp from drag"
                        AutomationProperties.Name="Add Image Stamp">
                    <PathIcon Classes="toolbar-icon" Data="{StaticResource IconImageStamp}"/>
                </Button>

                <Border toolbar:PriorityToolbarPanel.IsSeparator="True"
                        Width="1" Height="24" Margin="6,0"
                        Background="{DynamicResource DividerBrush}"/>

                <Button x:Name="AnnotationToolbarInkButton"
                        toolbar:PriorityToolbarPanel.Priority="55"
                        Command="{Binding ToggleFreehandModeCommand}"
                        Classes="modern-button toolbar-button"
                        IsEnabled="{Binding IsDocumentLoaded}"
                        access:CommandAccessibility.CommandId="annotation.toggleDrawMode"
                        ToolTip.Tip="Draw (Ink)"
                        AutomationProperties.Name="Draw (Ink)">
                    <PathIcon Classes="toolbar-icon" Data="{StaticResource IconInk}"/>
                </Button>
                <Button x:Name="AnnotationToolbarLineButton"
                        toolbar:PriorityToolbarPanel.Priority="50"
                        Command="{Binding ToggleLineModeCommand}"
                        Classes="modern-button toolbar-button"
                        IsEnabled="{Binding IsDocumentLoaded}"
                        access:CommandAccessibility.CommandId="annotation.toggleLineMode"
                        ToolTip.Tip="Draw Line"
                        AutomationProperties.Name="Draw Line">
                    <PathIcon Classes="toolbar-icon" Data="{StaticResource IconAnnotationLine}"/>
                </Button>
                <Button x:Name="AnnotationToolbarArrowButton"
                        toolbar:PriorityToolbarPanel.Priority="45"
                        Command="{Binding ToggleArrowModeCommand}"
                        Classes="modern-button toolbar-button"
                        IsEnabled="{Binding IsDocumentLoaded}"
                        access:CommandAccessibility.CommandId="annotation.toggleArrowMode"
                        ToolTip.Tip="Draw Arrow"
                        AutomationProperties.Name="Draw Arrow">
                    <PathIcon Classes="toolbar-icon" Data="{StaticResource IconArrow}"/>
                </Button>
                <Button x:Name="AnnotationToolbarPolygonButton"
                        toolbar:PriorityToolbarPanel.Priority="40"
                        Command="{Binding TogglePolygonModeCommand}"
                        Classes="modern-button toolbar-button"
                        IsEnabled="{Binding IsDocumentLoaded}"
                        access:CommandAccessibility.CommandId="annotation.togglePolygonMode"
                        ToolTip.Tip="Draw Polygon"
                        AutomationProperties.Name="Draw Polygon">
                    <PathIcon Classes="toolbar-icon" Data="{StaticResource IconPolygon}"/>
                </Button>
                <Button x:Name="AnnotationToolbarPolyLineButton"
                        toolbar:PriorityToolbarPanel.Priority="35"
                        Command="{Binding TogglePolyLineModeCommand}"
                        Classes="modern-button toolbar-button"
                        IsEnabled="{Binding IsDocumentLoaded}"
                        access:CommandAccessibility.CommandId="annotation.togglePolyLineMode"
                        ToolTip.Tip="Draw PolyLine"
                        AutomationProperties.Name="Draw PolyLine">
                    <PathIcon Classes="toolbar-icon" Data="{StaticResource IconPolyLine}"/>
                </Button>

                <Border toolbar:PriorityToolbarPanel.IsSeparator="True"
                        Width="1" Height="24" Margin="6,0"
                        Background="{DynamicResource DividerBrush}"/>

                <Button x:Name="AnnotationToolbarStickyNoteButton"
                        toolbar:PriorityToolbarPanel.Priority="30"
                        Command="{Binding AddStickyNoteAnnotationCommand}"
                        Classes="modern-button toolbar-button"
                        IsEnabled="{Binding IsDocumentLoaded}"
                        access:CommandAccessibility.CommandId="annotation.addStickyNote"
                        ToolTip.Tip="Add sticky note"
                        AutomationProperties.Name="Add Sticky Note">
                    <PathIcon Classes="toolbar-icon" Data="{StaticResource IconNote}"/>
                </Button>
            </toolbar:PriorityToolbarPanel>
        </Border>
        </StackPanel>

        <!-- Search Bar -->
        <Border Grid.Row="4"
                Background="{DynamicResource SecondaryBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="8,6"
                IsVisible="{Binding IsSearchVisible}">
          <StackPanel Orientation="Vertical" Spacing="4">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                <!-- Search Label -->
                <TextBlock Grid.Column="0" Text="Find:"
                           VerticalAlignment="Center"
                           Margin="4,0,8,0"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>

                <!-- Search TextBox. KeyDown is wired in code-behind so
                     Enter triggers search immediately (in addition to
                     the type-and-pause debounce). -->
                <TextBox x:Name="SearchTextBox"
                         Grid.Column="1"
                         Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="Search text… (auto-searches as you type, or press Enter)"
                         MinWidth="300"
                         Margin="0,0,8,0"
                         KeyDown="OnSearchTextBoxKeyDown"
                         AutomationProperties.Name="Search Text"
                         AutomationProperties.HelpText="Enter text to search for in the document"/>

                <!-- Find button — manual fallback if auto-search isn't
                     obvious to the user. -->
                <Button Grid.Column="2"
                        Content="Find"
                        Command="{Binding FindCommand}"
                        Classes="modern-button compact"
                        Padding="12,4"
                        Margin="0,0,8,0"
                        access:CommandAccessibility.CommandId="search.find"
                        AutomationProperties.Name="Find"
                        AutomationProperties.HelpText="Search for the entered text. Shortcut: Enter."/>

                <!-- Case Sensitive Checkbox -->
                <CheckBox Grid.Column="3"
                          IsChecked="{Binding SearchCaseSensitive}"
                          Content="Case sensitive"
                          AutomationProperties.Name="Case Sensitive Search"
                          AutomationProperties.HelpText="Match uppercase and lowercase letters exactly."
                          Margin="0,0,8,0"/>

                <!-- Whole Words Checkbox -->
                <CheckBox Grid.Column="4"
                          IsChecked="{Binding SearchWholeWords}"
                          Content="Whole words"
                          AutomationProperties.Name="Whole Word Search"
                          AutomationProperties.HelpText="Match only complete words."
                          Margin="0,0,8,0"/>

                <!-- Regex Checkbox -->
                <CheckBox Grid.Column="5"
                          IsChecked="{Binding SearchUseRegex}"
                          Content="Regex"
                          Margin="0,0,8,0"
                          AutomationProperties.Name="Regular Expression Search"
                          AutomationProperties.HelpText="Use regular expression pattern matching."
                          ToolTip.Tip="Use regular expression pattern matching"/>

                <!-- Previous Button -->
                <Button Grid.Column="6"
                        Content="◀"
                        Command="{Binding FindPreviousCommand}"
                        Classes="modern-button compact"
                        Padding="8,4"
                        Margin="0,0,4,0"
                        access:CommandAccessibility.CommandId="search.previous"
                        AutomationProperties.Name="Find Previous"
                        AutomationProperties.HelpText="Move to the previous search result. Shortcut: Shift+F3."/>

                <!-- Next Button -->
                <Button Grid.Column="7"
                        Content="▶"
                        Command="{Binding FindNextCommand}"
                        Classes="modern-button compact"
                        Padding="8,4"
                        Margin="0,0,8,0"
                        access:CommandAccessibility.CommandId="search.next"
                        AutomationProperties.Name="Find Next"
                        AutomationProperties.HelpText="Move to the next search result. Shortcut: F3."/>

                <!-- Result Counter -->
                <TextBlock Grid.Column="8"
                           Text="{Binding SearchResultText}"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,8,0"
                           MinWidth="80"/>

                <!-- Close Button -->
                <Button Grid.Column="9"
                        Content="✕"
                        Command="{Binding CloseSearchCommand}"
                        Classes="modern-button compact"
                        Padding="8,4"
                        access:CommandAccessibility.CommandId="search.close"
                        AutomationProperties.Name="Close Search"
                        AutomationProperties.HelpText="Close the search bar. Shortcut: Esc."/>
            </Grid>

            <!-- Inline search progress: indeterminate bar + page-progress
                 text. Both visible only while a search is actively running.
                 The "X of Y matches" final-state count stays in
                 SearchResultText so this row vanishes when the search
                 completes. IsIndeterminate is bound to the same condition:
                 a hidden indeterminate bar keeps animating (#1462). -->
            <Grid ColumnDefinitions="*,Auto"
                  IsVisible="{Binding IsSearching}"
                  Margin="0,2,0,0">
                <ProgressBar Grid.Column="0"
                             IsIndeterminate="{Binding IsSearching}"
                             Height="2"
                             Margin="0,0,8,0"
                             VerticalAlignment="Center"
                             ShowProgressText="False" />
                <TextBlock Grid.Column="1"
                           Text="{Binding SearchProgressText}"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </Grid>
          </StackPanel>
        </Border>

        <!-- Row 5 is window CHROME: the tab strip, which is part of the
             window and must displace the document like the toolbar does.
             The notification banners used to live here too and no longer do —
             they FLOAT over the document (#1646, NoticeOverlay below), because
             a banner that takes a layout row moves the page under the reader
             every time one opens or closes. #1619 was exactly that: an
             attachments toast auto-dismissing after 5 s re-laid out the window
             and jumped the page three seconds after the document had settled. -->
        <StackPanel Grid.Row="5">
            <!-- #1554: in-app document tabs. Its DataContext is the window's
                 DocumentTabsViewModel, set in code-behind; it shows only when
                 the window holds more than one document. -->
            <views:DocumentTabStrip x:Name="DocumentTabStripHost" IsVisible="False"/>

        </StackPanel>

        <!-- Main Content Area. Auto/Auto on the sidebar columns lets them
             collapse to 0 width when their Border's IsVisible flips false,
             so toggling Show Thumbnails / Show Clipboard History gives the
             central pane the freed space rather than just blanking the
             column. -->
        <Grid Grid.Row="6" ColumnDefinitions="Auto,*,Auto">

            <!-- Left sidebar — Outline (top), Thumbnails (bottom). Each pane has
                 its own View menu toggle; the host shows while either is on.
                 Attachments moved to the RIGHT sidebar (#1641): it belongs with
                 the other per-document lists (search results, pending
                 redactions, clipboard history), and the left side is for
                 navigating the pages. -->
            <Border x:Name="LeftSidebarHost"
                    Grid.Column="0"
                    Width="220"
                    IsVisible="{Binding IsLeftSidebarVisible}"
                    Background="{DynamicResource SidebarBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0">
              <Grid RowDefinitions="*,Auto,*">

                <!-- Outline / Table of Contents -->
                <Grid x:Name="OutlinePanel"
                      Grid.Row="0" RowDefinitions="Auto,*"
                      IsVisible="{Binding IsOutlineSidebarVisible}">
                    <Border Grid.Row="0"
                            Background="{DynamicResource SecondaryBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="10,6">
                        <TextBlock Text="Outline"
                                   FontWeight="SemiBold" FontSize="12"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </Border>
                    <!-- Bind SelectedItem to VM. The setter on
                         SelectedOutlineNode jumps the viewer; this is the
                         simplest cross-platform pattern that works inside
                         TreeView's container chain (a per-row Button.Command
                         binding does NOT reliably resolve $parent[Window]
                         through the templated ItemContainer hierarchy). -->
                    <!-- PointerPressed at the TreeView level + a manual
                         walk to the clicked TreeViewItem. The SelectedItem
                         TwoWay binding works in tests under FluentTheme but
                         FluentAvalonia's TreeViewItem theme can swallow
                         clicks on the chevron/content boundary, so the
                         straightforward selection path silently no-ops in
                         the real app. The pointer handler is theme-
                         independent. -->
                    <ScrollViewer Grid.Row="1">
                        <TreeView Name="OutlineTree"
                                  ItemsSource="{Binding OutlineNodes}"
                                  SelectedItem="{Binding SelectedOutlineNode, Mode=TwoWay}"
                                  PointerPressed="OnOutlineTreePointerPressed"
                                  Background="Transparent"
                                  BorderThickness="0">
                            <TreeView.ItemTemplate>
                                <TreeDataTemplate x:DataType="models:OutlineNode"
                                                  ItemsSource="{Binding Children}">
                                    <TextBlock Text="{Binding DisplayText}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Cursor="Hand"/>
                                </TreeDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </ScrollViewer>
                </Grid>

                <!-- Splitter between outline and thumbnails (only when both visible). -->
                <GridSplitter Grid.Row="1"
                              Height="2"
                              Background="{DynamicResource BorderBrush}"
                              HorizontalAlignment="Stretch"
                              ResizeDirection="Rows"
                              IsVisible="{Binding IsSidebarSplitterVisible}"/>

                <!-- Thumbnails -->
                <Grid x:Name="ThumbnailsPanel"
                      Grid.Row="2" RowDefinitions="Auto,*"
                      IsVisible="{Binding IsThumbnailsSidebarVisible}">
                    <Border Grid.Row="0"
                            Background="{DynamicResource SecondaryBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="10,6">
                        <Grid RowDefinitions="Auto,Auto" RowSpacing="6">
                            <DockPanel Grid.Row="0">
                                <TextBlock Text="Thumbnails"
                                           FontWeight="SemiBold" FontSize="12"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding PageSelectionSummary}"
                                           HorizontalAlignment="Right"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </DockPanel>
                            <WrapPanel Grid.Row="1" Orientation="Horizontal">
                                <Button Content="↑" Command="{Binding MoveSelectedPagesEarlierCommand}"
                                        Classes="modern-button"
                                        Margin="0,0,4,4"
                                        IsEnabled="{Binding CanMoveSelectedPagesEarlier}"
                                        access:CommandAccessibility.CommandId="document.moveSelectedPagesEarlier"
                                        ToolTip.Tip="Move selected pages earlier"
                                        AutomationProperties.Name="Move Selected Pages Earlier"/>
                                <Button Content="↓" Command="{Binding MoveSelectedPagesLaterCommand}"
                                        Classes="modern-button"
                                        Margin="0,0,4,4"
                                        IsEnabled="{Binding CanMoveSelectedPagesLater}"
                                        access:CommandAccessibility.CommandId="document.moveSelectedPagesLater"
                                        ToolTip.Tip="Move selected pages later"
                                        AutomationProperties.Name="Move Selected Pages Later"/>
                                <Button Content="Extract" Command="{Binding ExtractSelectedPagesCommand}"
                                        Classes="modern-button"
                                        Margin="0,0,4,4"
                                        IsEnabled="{Binding HasSelectedPages}"
                                        access:CommandAccessibility.CommandId="document.extractSelectedPages"
                                        ToolTip.Tip="Extract selected pages"
                                        AutomationProperties.Name="Extract Selected Pages"/>
                                <Button Content="Remove" Command="{Binding RemoveSelectedPagesCommand}"
                                        Classes="modern-button"
                                        Margin="0,0,4,4"
                                        IsEnabled="{Binding CanRemoveSelectedPages}"
                                        access:CommandAccessibility.CommandId="document.removeSelectedPages"
                                        ToolTip.Tip="Remove selected pages"
                                        AutomationProperties.Name="Remove Selected Pages"/>
                                <Button Content="Clear" Command="{Binding ClearSelectedPagesCommand}"
                                        Classes="modern-button"
                                        Margin="0,0,4,4"
                                        IsEnabled="{Binding HasSelectedPages}"
                                        access:CommandAccessibility.CommandId="document.clearPageSelection"
                                        ToolTip.Tip="Clear page selection"
                                        AutomationProperties.Name="Clear Page Selection"/>
                            </WrapPanel>
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="1">
                    <ItemsControl x:Name="ThumbnailsItemsControl" ItemsSource="{Binding PageThumbnails}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:PageThumbnail">
                                    <!-- Drag-to-reorder pointer handlers are attached in
                                         code-behind on the ItemsControl with handledEventsToo:true.
                                         They cannot be XAML event attributes on this Button: the
                                         Button's own class handler marks PointerPressed/Released
                                         Handled, so a normal (handledEventsToo:false) instance
                                         handler here never runs and reorder silently did nothing
                                         (#827). Click-to-navigate stays on the Button's Command. -->
                                    <Button Margin="6" Padding="0" Background="Transparent"
                                            BorderThickness="0"
                                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).GoToPageCommand}"
                                            CommandParameter="{Binding PageIndex}"
                                            access:CommandAccessibility.CommandId="view.goToPage"
                                            Cursor="Hand"
                                            Classes.selected="{Binding IsSelected}">
                                    <Border Padding="6"
                                            Background="{DynamicResource CardBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Name="ThumbnailBorder">
                                        <StackPanel Spacing="6">
                                            <Grid ColumnDefinitions="Auto,*">
                                                <CheckBox IsChecked="{Binding IsMarkedForPageOperation, Mode=TwoWay}"
                                                          VerticalAlignment="Center"
                                                          ToolTip.Tip="Select page for batch operations"
                                                          AutomationProperties.Name="{Binding PageNumber, StringFormat='Select Page {0}'}"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding PageNumber, StringFormat='Page {0}'}"
                                                           HorizontalAlignment="Center"
                                                           FontSize="11"
                                                           FontWeight="Medium"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </Grid>
                                            <!-- EffectiveViewportChanged fires whenever this Image's
                                                 visible area changes. We use it to lazy-load the
                                                 thumbnail bitmap only for pages the user actually
                                                 scrolls to — combined with the on-disk cache
                                                 (ThumbnailCacheService) reopens are sub-millisecond
                                                 and first opens skip rendering pages they never look at. -->
                                            <Image Source="{Binding ThumbnailImage}"
                                                   Width="150" Height="200"
                                                   Stretch="Uniform"
                                                   EffectiveViewportChanged="OnThumbnailViewportChanged"
                                                   Tag="{Binding PageIndex}"/>
                                        </StackPanel>
                                    </Border>
                                    <Button.Styles>
                                        <Style Selector="Button.selected > Border">
                                            <Setter Property="BorderBrush" Value="{DynamicResource BrandPrimaryBrush}"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                            <Setter Property="Background" Value="{DynamicResource SelectedBrush}"/>
                                        </Style>
                                        <Style Selector="Button:pointerover > Border">
                                            <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                                        </Style>
                                    </Button.Styles>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                </Grid>
              </Grid>
            </Border>

            <!-- #1646: notification banners float OVER the document, anchored
                 to the top of the viewport. They are in the document column
                 only — covering the sidebars would hide the lists the banner is
                 usually telling you to look at — and after the viewer in
                 document order, so they paint on top of it. Nothing about them
                 is in the layout: opening or closing one must not move the
                 page. -->
            <!-- PDF Viewer -->
            <Border x:Name="DocumentArea"
                    Grid.Column="1"
                    Background="#E8E8E8">
                <Grid>
                    <!-- Empty State (shown when no document is loaded) -->
                    <Grid IsVisible="{Binding !IsDocumentLoaded}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                        <StackPanel Spacing="16" HorizontalAlignment="Center">
                            <PathIcon Data="{StaticResource IconPage}"
                                      Width="64"
                                      Height="64"
                                      Foreground="{DynamicResource TextTertiaryBrush}"
                                      HorizontalAlignment="Center"
                                      Opacity="0.45"/>
                            <TextBlock Text="No document open"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="Open a PDF file to get started"
                                       FontSize="13"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextTertiaryBrush}"/>
                            <Button Command="{Binding OpenFileCommand}"
                                    HorizontalAlignment="Center"
                                    Padding="20,10"
                                    FontSize="14"
                                    Margin="0,8,0,0"
                                    access:CommandAccessibility.CommandId="app.open">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon Classes="toolbar-icon" Data="{StaticResource IconFolderOpen}"/>
                                    <TextBlock Text="Open File"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Document Viewer (shown when document is loaded) -->
                    <controls:PdfViewerControl x:Name="PdfViewerControl"
                                               IsVisible="{Binding IsDocumentLoaded}"
                                               Document="{Binding PdfCoreDocument}"
                                               ShowAnnotations="{Binding AreAnnotationsVisible}"
                                               ShowCommentAnnotations="{Binding AreCommentAnnotationsVisible}"
                                               ShowFieldAndLinkAnnotations="{Binding AreFieldAndLinkAnnotationsVisible}"
                                               RevealHiddenAnnotations="{Binding IsAnnotationAuditModeEnabled}"
                                               HighlightFormFields="{Binding AreFormFieldsHighlighted}"
                                               CurrentPage="{Binding CurrentPage}"
                                               ViewMode="{Binding ViewMode, Mode=TwoWay}"
                                               ReadingOrderStrategy="{Binding ReadingOrderStrategy, Mode=TwoWay}"
                                               WhitespaceMode="{Binding WhitespaceMode, Mode=TwoWay}"
                                               RenderVersion="{Binding RenderVersion}"
                                               ZoomLevel="{Binding ZoomLevel}"
                                               InteractionMode="{Binding InteractionMode}"
                                               HiddenTextHighlights="{Binding HiddenTextHighlights}"
                                               FormFields="{Binding CurrentPageFormFields}"
                                               TypewriterTextOperations="{Binding TypewriterTextOperations}"
                                               RedactionDrawn="OnRedactionDrawn"
                                               TextSelected="OnTextSelected"
                                               LinkClicked="OnLinkClicked"
                                               ExternalLinkClicked="OnExternalLinkClicked"
                                               DangerousLinkClicked="OnDangerousLinkClicked"
                                               LinkHovered="OnLinkHovered"
                                               AnnotationHovered="OnAnnotationHovered"
                                               StickyNoteClicked="OnStickyNoteClicked"
                                               StickyNotePlacementRequested="OnStickyNotePlacementRequested"
                                               FormFieldEdited="OnFormFieldEdited"
                                               FormFieldEditRejected="OnFormFieldEditRejected"
                                               FormFieldRectDrawn="OnFormFieldRectDrawn"
                                               AnnotationPathDrawn="OnAnnotationPathDrawn"
                                               PathCaptureKind="{Binding PathCaptureKind}"
                                               TypewriterTextCreated="OnTypewriterTextCreated"
                                               TypewriterTextEdited="OnTypewriterTextEdited"
                                               TypewriterTextBoundsChanged="OnTypewriterTextBoundsChanged"
                                               TypewriterTextDeleted="OnTypewriterTextDeleted"
                                               PageChanged="OnPageChanged" />

                    <!-- #1788: the interactive sticky-note popup. An overlay in
                         the SAME window as the viewer (not a second OS Window)
                         so "click away to collapse" is ordinary same-window
                         routed-event handling — see OnDocumentAreaPointerPressedTunnel
                         in the code-behind. Positioned in code-behind from
                         PdfViewerControl.GetViewerPositionForPageRect whenever
                         StickyNotePopup changes.

                         The ContentControl (not a plain child) is deliberate:
                         with StickyNotePopup null (no popup open, the default
                         state) it realises NO visual/logical child at all, so
                         StickyNotePopupView's "Done" button does not exist in
                         MainWindow's logical tree for CommandBindingSweepTests
                         to walk — the same "swept when realised" exemption
                         #1789 already relies on for the floating palette,
                         rather than a plain Border+IsVisible=False, which
                         would still contain a live Button whose Command binds
                         to a null DataContext. -->
                    <Border x:Name="StickyNotePopupHost"
                            IsVisible="{Binding StickyNotePopup, Converter={x:Static ObjectConverters.IsNotNull}}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            ZIndex="30">
                        <ContentControl Content="{Binding StickyNotePopup}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate>
                                    <views:StickyNotePopupView/>
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>
                    </Border>
                </Grid>
            </Border>

            <StackPanel x:Name="NoticeOverlay"
                        Grid.Column="1"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Stretch"
                        ZIndex="10"
                        Spacing="4"
                        Margin="12,12,12,0">
                <!-- Toast Notification InfoBar -->
                <ui:FAInfoBar x:Name="ToastInfoBar" IsOpen="False" IsClosable="True" Margin="0"/>

                <!-- #1547: persistent XFA notice. Stays until closed or the
                     document changes, because a dynamic XFA placeholder page
                     stays on screen too. -->
                <ui:FAInfoBar x:Name="XfaFormInfoBar"
                              IsOpen="{Binding IsXfaNoticeOpen, Mode=TwoWay}"
                              IsClosable="True"
                              Severity="{Binding XfaNoticeSeverity}"
                              Title="{Binding XfaNoticeTitle}"
                              Message="{Binding XfaNoticeMessage}"
                              Margin="0"/>

                <!-- #1619: persistent attachments notice. Was a 5 s
                     auto-dismissing toast, and because the notices used to take
                     a layout row, that dismissal re-laid out the window and
                     jumped the page under the reader five seconds after the
                     document opened — the whole #1544 launch tail on a document
                     with an embedded file. A carrier the page view cannot show
                     does not stop mattering after five seconds, so it stays
                     until closed or the document changes. Floating over the
                     document (#1646) removes the re-layout as well. -->
                <ui:FAInfoBar x:Name="AttachmentsInfoBar"
                              IsOpen="{Binding IsAttachmentsNoticeOpen, Mode=TwoWay}"
                              IsClosable="True"
                              Severity="Warning"
                              Title="{Binding AttachmentsNoticeTitle}"
                              Message="{Binding AttachmentsNoticeMessage}"
                              Margin="0"/>
            </StackPanel>

            <!-- Clipboard History Sidebar -->
            <Border x:Name="ClipboardSidebarHost"
                    Grid.Column="2"
                    Width="250"
                    IsVisible="{Binding IsRightSidebarVisible}"
                    Background="{DynamicResource SidebarBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1,0,0,0">
              <Grid RowDefinitions="*,Auto">
                <Grid x:Name="ClipboardPanel"
                      Grid.Row="0" RowDefinitions="Auto,*,Auto"
                      IsVisible="{Binding ShowRightModePanel}">
                    <!-- Header — title swaps with the right-sidebar mode. -->
                    <Border Grid.Row="0" Background="{DynamicResource SecondaryBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="12,10">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0"
                                       Text="Search Results"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       IsVisible="{Binding ShowSearchResultsPanel}"/>
                            <TextBlock Grid.Column="0"
                                       Text="Pending Redactions"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       IsVisible="{Binding ShowPendingRedactionsPanel}"/>
                            <TextBlock Grid.Column="0"
                                       Text="Clipboard History"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       IsVisible="{Binding ShowClipboardHistoryPanel}"/>
                            <!-- Count badge for active mode. -->
                            <TextBlock Grid.Column="1"
                                       Text="{Binding SearchMatches.Count, StringFormat='({0})'}"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       Foreground="{DynamicResource BrandPrimaryBrush}"
                                       IsVisible="{Binding ShowSearchResultsPanel}"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding RedactionWorkflow.PendingCount, StringFormat='({0})'}"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       Foreground="{DynamicResource BrandPrimaryBrush}"
                                       IsVisible="{Binding ShowPendingRedactionsPanel}"/>
                        </Grid>
                    </Border>

                    <!-- Search results list — visible whenever the find bar
                         is open. Each row jumps to its match on click. -->
                    <ScrollViewer Grid.Row="1" IsVisible="{Binding ShowSearchResultsPanel}">
                        <ItemsControl ItemsSource="{Binding SearchMatches}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:SearchMatch">
                                    <Button HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            Margin="6,4"
                                            Padding="10"
                                            Background="{DynamicResource CardBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Cursor="Hand"
                                            Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).JumpToSearchMatchCommand}" access:CommandAccessibility.CommandId="search.jumpToMatch"
                                            CommandParameter="{Binding}">
                                        <StackPanel Spacing="4">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding MatchedText}"
                                                           FontWeight="SemiBold"
                                                           FontSize="12"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding PageIndex, StringFormat='p.{0}'}"
                                                           FontSize="11"
                                                           Margin="6,0,0,0"
                                                           Foreground="{DynamicResource BrandPrimaryBrush}"/>
                                            </Grid>
                                            <TextBlock Text="{Binding Context}"
                                                       FontSize="11"
                                                       TextWrapping="Wrap"
                                                       MaxLines="2"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Pending Redactions List (visible in redaction mode, search bar closed). -->
                    <ScrollViewer Grid.Row="1" IsVisible="{Binding ShowPendingRedactionsPanel}">
                        <ItemsControl ItemsSource="{Binding RedactionWorkflow.PendingRedactions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:PendingRedaction">
                                    <Border Margin="8" Padding="10"
                                            Background="{DynamicResource CardBrush}"
                                            BorderBrush="#E53935"
                                            BorderThickness="2"
                                            CornerRadius="6">
                                        <StackPanel Spacing="6">
                                            <!-- Header: Page Number -->
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding PageNumber, StringFormat='Page {0}'}"
                                                           FontSize="11"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource BrandPrimaryBrush}"/>
                                                <Button Grid.Column="1"
                                                        Content="×"
                                                        FontSize="16"
                                                        Padding="4,0"
                                                        Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).RemovePendingRedactionCommand}"
                                                        CommandParameter="{Binding Id}"
                                                        access:CommandAccessibility.CommandId="redaction.removePending"
                                                        Background="Transparent"
                                                        Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </Grid>

                                            <!-- Preview Text -->
                                            <TextBlock Text="{Binding PreviewText}"
                                                       FontSize="11"
                                                       TextWrapping="Wrap"
                                                       MaxHeight="60"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>

                                            <!-- Area info -->
                                            <TextBlock Text="{Binding DisplayText}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource TextTertiaryBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Redaction action buttons (visible in redaction mode, search bar closed). -->
                    <Border Grid.Row="2"
                            IsVisible="{Binding ShowPendingRedactionsPanel}"
                            Padding="12"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,1,0,0">
                        <Grid ColumnDefinitions="*,8,*">
                            <!-- Clear All Button -->
                            <Button Grid.Column="0"
                                    Content="Clear All"
                                    Command="{Binding ClearAllRedactionsCommand}"
                                    HorizontalAlignment="Stretch"
                                    Padding="12,8"
                                    FontWeight="SemiBold"
                                    access:CommandAccessibility.CommandId="redaction.clearAll"
                                    Background="{DynamicResource SecondaryBackgroundBrush}"
                                    Foreground="{DynamicResource TextPrimaryBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"/>

                            <!-- Apply All Button (issue #19) -->
                            <Button Grid.Column="2"
                                    Content="Apply All"
                                    Command="{Binding ApplyAllRedactionsCommand}"
                                    IsEnabled="{Binding RedactionWorkflow.HasPendingRedactions}"
                                    HorizontalAlignment="Stretch"
                                    Classes="primary"
                                    Padding="12,8"
                                    access:CommandAccessibility.CommandId="redaction.applyAll"
                                    FontWeight="SemiBold">
                                <Button.Styles>
                                    <Style Selector="Button.primary">
                                        <Setter Property="Background" Value="#E53935"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Style>
                                    <Style Selector="Button.primary:pointerover">
                                        <Setter Property="Background" Value="#D32F2F"/>
                                    </Style>
                                    <Style Selector="Button.primary:disabled">
                                        <Setter Property="Background" Value="#666"/>
                                        <Setter Property="Foreground" Value="#999"/>
                                    </Style>
                                </Button.Styles>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Clipboard History List (visible when neither redaction nor search active). -->
                    <ScrollViewer Grid.Row="1" IsVisible="{Binding ShowClipboardHistoryPanel}">
                        <ItemsControl ItemsSource="{Binding ClipboardHistory}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:ClipboardEntry">
                                    <Border Margin="8" Padding="10"
                                            Background="{DynamicResource CardBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Classes.redacted="{Binding IsRedacted}">
                                        <Border.Styles>
                                            <Style Selector="Border.redacted">
                                                <Setter Property="BorderBrush" Value="#E53935"/>
                                                <Setter Property="BorderThickness" Value="2"/>
                                            </Style>
                                        </Border.Styles>
                                        <StackPanel Spacing="6">
                                            <!-- Header: Type, Time and Page -->
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <Border Grid.Column="0"
                                                        Background="#E53935"
                                                        CornerRadius="3"
                                                        Padding="6,2"
                                                        Margin="0,0,8,0"
                                                        IsVisible="{Binding IsRedacted}">
                                                    <TextBlock Text="REDACTED"
                                                               FontSize="9"
                                                               FontWeight="Bold"
                                                               Foreground="White"/>
                                                </Border>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding TimeDisplay}"
                                                           FontSize="11"
                                                           FontWeight="Medium"
                                                           Foreground="{DynamicResource BrandPrimaryBrush}"/>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding PageNumber, StringFormat='Page {0}'}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </Grid>

                                            <!-- Preview Text -->
                                            <TextBlock Text="{Binding PreviewText}"
                                                       FontSize="11"
                                                       TextWrapping="Wrap"
                                                       MaxHeight="60"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>

                                            <!-- Raw copied text is preserved; this warning makes any
                                                 non-printing Unicode control explicit in the preview. -->
                                            <TextBlock Text="{Binding UnicodeSecurityNotice}"
                                                       IsVisible="{Binding HasUnicodeSecurityControls}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="#D97706"/>

                                            <!-- Character Count -->
                                            <TextBlock Text="{Binding CharacterCount, StringFormat='{}{0} characters'}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                                       HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>


                    <!-- #1563: Attachments pane. Visible by default and when empty,
                         so a document's embedded files are never out of sight.
                         Auto height with a capped list: it takes little room when
                         empty and never pushes the thumbnails off screen.
                         excise never opens or runs an attachment; Save writes the
                         bytes to a place the user picks. -->
                    <Grid x:Name="AttachmentsPanel"
                          Grid.Row="1" RowDefinitions="Auto,Auto,Auto"
                          IsVisible="{Binding IsAttachmentsSidebarVisible}">
                        <Border Grid.Row="0"
                                Background="{DynamicResource SecondaryBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,1,0,1"
                                Padding="10,6"
                                ToolTip.Tip="{Binding AttachmentsSummary}">
                            <DockPanel>
                                <TextBlock Text="Attachments"
                                           FontWeight="SemiBold" FontSize="12"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding AttachmentsCountText}"
                                           HorizontalAlignment="Right"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </DockPanel>
                        </Border>

                        <TextBlock x:Name="AttachmentsEmptyText"
                                   Grid.Row="1"
                                   Margin="10,8"
                                   FontSize="11"
                                   Text="{Binding AttachmentsEmptyText}"
                                   IsVisible="{Binding !HasAttachments}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>

                        <ListBox x:Name="AttachmentsList"
                                 Grid.Row="1"
                                 MaxHeight="180"
                                 ItemsSource="{Binding Attachments}"
                                 SelectedItem="{Binding SelectedAttachment, Mode=TwoWay}"
                                 IsVisible="{Binding HasAttachments}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 AutomationProperties.Name="Attachments">
                            <!-- The row container is what a screen reader lands
                                 on, so it carries "name, size" (#1563). -->
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem" x:DataType="models:AttachmentEntry">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}"/>
                                    <Setter Property="Padding" Value="8,4"/>
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:AttachmentEntry">
                                    <StackPanel Spacing="1" ToolTip.Tip="{Binding ToolTipText}">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right"
                                                       Margin="6,0,0,0"
                                                       Text="{Binding SizeDisplay}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontSize="11"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding DetailText}"
                                                   IsVisible="{Binding HasDetail}"
                                                   FontSize="10"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <WrapPanel Grid.Row="2" Orientation="Horizontal" Margin="6,2,6,6"
                                   IsVisible="{Binding HasAttachments}">
                            <Button x:Name="SaveAttachmentButton"
                                    Content="Save…"
                                    Command="{Binding SaveSelectedAttachmentCommand}"
                                    IsEnabled="{Binding SelectedAttachment, Converter={x:Static ObjectConverters.IsNotNull}}"
                                    Classes="modern-button"
                                    Margin="0,0,4,4"
                                    access:CommandAccessibility.CommandId="document.saveAttachment"
                                    ToolTip.Tip="Save the selected attachment to a location you choose. excise never opens or runs attachments."
                                    AutomationProperties.Name="Save Attachment"/>
                            <Button x:Name="SaveAllAttachmentsButton"
                                    Content="Save All…"
                                    Command="{Binding SaveAllAttachmentsCommand}"
                                    Classes="modern-button"
                                    Margin="0,0,4,4"
                                    access:CommandAccessibility.CommandId="document.saveAllAttachments"
                                    ToolTip.Tip="Save every attachment into a folder you choose. Existing files are never overwritten."
                                    AutomationProperties.Name="Save All Attachments"/>
                            <Button x:Name="RemoveAllAttachmentsButton"
                                    Content="Remove All"
                                    Command="{Binding RemoveAllAttachmentsCommand}"
                                    Classes="modern-button"
                                    Margin="0,0,4,4"
                                    access:CommandAccessibility.CommandId="document.removeAllAttachments"
                                    ToolTip.Tip="Strip the document's embedded files. Undoable; save afterwards to keep the change."
                                    AutomationProperties.Name="Remove All Attachments"/>
                        </WrapPanel>
                    </Grid>
              </Grid>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="7"
                Background="{DynamicResource SecondaryBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,8">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Mode Indicator -->
                <Border Grid.Column="0"
                        CornerRadius="4"
                        Padding="8,4"
                        Margin="0,0,12,0"
                        Classes.redactionActive="{Binding IsRedactionMode}">
                    <Border.Styles>
                        <!-- Normal mode style -->
                        <Style Selector="Border">
                            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
                        </Style>
                        <!-- Redaction mode active style -->
                        <Style Selector="Border.redactionActive">
                            <Setter Property="Background" Value="#E53935"/>
                        </Style>
                    </Border.Styles>
                    <TextBlock x:Name="CurrentModeStatusText"
                               Text="{Binding CurrentModeText}"
                               VerticalAlignment="Center"
                               FontSize="11"
                               FontWeight="Medium"
                               AutomationProperties.Name="Current Interaction Mode"
                               AutomationProperties.ItemStatus="{Binding CurrentModeText}"
                               Classes.redactionActive="{Binding IsRedactionMode}">
                        <TextBlock.Styles>
                            <!-- Normal mode text color -->
                            <Style Selector="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Style>
                            <!-- Redaction mode text color (white for contrast) -->
                            <Style Selector="TextBlock.redactionActive">
                                <Setter Property="Foreground" Value="White"/>
                            </Style>
                        </TextBlock.Styles>
                    </TextBlock>
                </Border>

                <!-- Status Text / Operation Status -->
                <StackPanel Grid.Column="1" Orientation="Vertical" Spacing="2">
                    <!-- Operation Status (shown when an operation is in progress) -->
                    <TextBlock x:Name="OperationStatusText"
                               Text="{Binding OperationStatus}"
                               VerticalAlignment="Center"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}"
                               AutomationProperties.Name="Operation Status"
                               AutomationProperties.ItemStatus="{Binding OperationStatus}"
                               IsVisible="{Binding OperationStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                    <!-- Regular Status Text (shown when no operation) -->
                    <TextBlock x:Name="StatusBarTextBlock"
                               Text="{Binding StatusBarText}"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               AutomationProperties.Name="Document Status"
                               AutomationProperties.ItemStatus="{Binding StatusBarText}"
                               IsVisible="{Binding OperationStatus, Converter={x:Static StringConverters.IsNullOrEmpty}}"/>
                    <!-- #1021: a document carrying unapplied /Redact marks must
                         SAY SO. excise does not apply them for you, and the
                         reviewer has to learn they exist to decide. The property
                         is null when there are none, so the notice hides itself. -->
                    <TextBlock x:Name="RedactAnnotationNoticeTextBlock"
                               Text="{Binding RedactAnnotationNotice}"
                               VerticalAlignment="Center"
                               Margin="16,0,0,0"
                               FontSize="12"
                               FontWeight="SemiBold"
                               TextWrapping="NoWrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               AutomationProperties.Name="Unapplied redaction marks"
                               IsVisible="{Binding RedactAnnotationNotice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                </StackPanel>

                <!-- Page Navigation. No command tooltips on the arrow buttons:
                     the nearby page label already explains them, and the
                     hover popup can make these small footer targets hard to
                     click while the status bar is remeasuring. Accessibility
                     metadata still comes from CommandAccessibility. -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button Content="◀" Command="{Binding PreviousPageCommand}"
                            Classes="modern-button compact" Padding="8,4"
                            access:CommandAccessibility.CommandId="view.previousPage"
                            access:CommandAccessibility.ShowToolTip="False"
                            AutomationProperties.Name="Previous Page"
                            AutomationProperties.HelpText="Navigate to the previous page. Shortcut: Page Up."/>
                    <TextBlock Text="{Binding DisplayPageNumber, StringFormat='Page {0}'}"
                               VerticalAlignment="Center"
                               FontSize="12"
                               FontWeight="Medium"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               MinWidth="80"
                               TextAlignment="Center"
                               AutomationProperties.Name="Current Page Number"/>
                    <Button Content="▶" Command="{Binding NextPageCommand}"
                            Classes="modern-button compact" Padding="8,4"
                            access:CommandAccessibility.CommandId="view.nextPage"
                            access:CommandAccessibility.ShowToolTip="False"
                            AutomationProperties.Name="Next Page"
                            AutomationProperties.HelpText="Navigate to the next page. Shortcut: Page Down."/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
