<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Excise.App.ViewModels"
        xmlns:ctl="using:Excise.App.Controls"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        x:Class="Excise.App.Views.SecurityDialog"
        x:DataType="vm:SecurityDialogViewModel"
        Title="Document Security"
        Width="480"
        WindowStartupLocation="CenterOwner"
        CanResize="false"
        SizeToContent="Height"
        Background="{DynamicResource AppBackgroundBrush}">

    <Grid RowDefinitions="*,Auto">
        <StackPanel Grid.Row="0" Margin="24,20,24,16" Spacing="12">

            <!-- Header -->
            <StackPanel Spacing="4">
                <TextBlock Text="Document Security" Classes="dialog-title"
                           IsVisible="{OnPlatform Default=True, macOS=False}"/>
                <TextBlock Text="Set, change, or remove password protection. Saving writes a new file — the currently open document is not modified in place."
                           Classes="help"/>
            </StackPanel>

            <!-- Current password (only relevant on an already-encrypted document) -->
            <StackPanel Spacing="4" IsVisible="{Binding IsEncrypted}" IsEnabled="{Binding CanEditOptions}">
                <Label Target="{Binding #CurrentPasswordBox}" Classes="field-label">
                    <Label.Content>
                        <OnPlatform x:TypeArguments="x:String" Default="Current password" Windows="_Current password"/>
                    </Label.Content>
                </Label>
                <TextBox x:Name="CurrentPasswordBox"
                         Text="{Binding CurrentPassword}"
                         PasswordChar="{Binding PasswordMaskChar}"
                         PlaceholderText="Required to change or remove protection"
                         AutomationProperties.Name="Current Password"
                         AutomationProperties.HelpText="The password that currently protects this document. Required before applying any change."/>
            </StackPanel>

            <!-- New passwords -->
            <StackPanel Spacing="12" IsEnabled="{Binding CanEditOptions}">
                <StackPanel Spacing="4">
                    <Label Target="{Binding #NewUserPasswordBox}" Classes="field-label">
                        <Label.Content>
                            <OnPlatform x:TypeArguments="x:String" Default="New user password (required to open)" Windows="New _user password (required to open)"/>
                        </Label.Content>
                    </Label>
                    <TextBox x:Name="NewUserPasswordBox"
                             Text="{Binding NewUserPassword}"
                             PasswordChar="{Binding PasswordMaskChar}"
                             PlaceholderText="Leave blank for no open password"
                             AutomationProperties.Name="New User Password"
                             AutomationProperties.HelpText="Password required to open the document. Leave blank for none."/>
                </StackPanel>
                <StackPanel Spacing="4">
                    <Label Target="{Binding #ConfirmNewUserPasswordBox}" Classes="field-label">
                        <Label.Content>
                            <OnPlatform x:TypeArguments="x:String" Default="Confirm new user password" Windows="Co_nfirm new user password"/>
                        </Label.Content>
                    </Label>
                    <TextBox x:Name="ConfirmNewUserPasswordBox"
                             Text="{Binding ConfirmNewUserPassword}"
                             PasswordChar="{Binding PasswordMaskChar}"
                             PlaceholderText="Type the new user password again"
                             AutomationProperties.Name="Confirm New User Password"
                             AutomationProperties.HelpText="The new user password again. Apply stays disabled until both entries match."/>
                    <TextBlock Text="{Binding PasswordMismatchMessage}"
                               Classes="error"
                               IsVisible="{Binding PasswordMismatchMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                </StackPanel>
                <StackPanel Spacing="4">
                    <Label Target="{Binding #NewOwnerPasswordBox}" Classes="field-label">
                        <Label.Content>
                            <OnPlatform x:TypeArguments="x:String" Default="New owner password (permissions)" Windows="New _owner password (permissions)"/>
                        </Label.Content>
                    </Label>
                    <TextBox x:Name="NewOwnerPasswordBox"
                             Text="{Binding NewOwnerPassword}"
                             PasswordChar="{Binding PasswordMaskChar}"
                             PlaceholderText="Leave blank for no owner password"
                             AutomationProperties.Name="New Owner Password"
                             AutomationProperties.HelpText="Password required to change permissions. Leave blank for none."/>
                </StackPanel>
                <CheckBox x:Name="RevealPasswordsCheckBox"
                          Content="Show passwords"
                          IsChecked="{Binding RevealPasswords}"
                          AutomationProperties.Name="Show Passwords"
                          AutomationProperties.HelpText="Show the typed passwords instead of bullets."/>
                <StackPanel Spacing="4">
                    <Label Target="{Binding #AlgorithmComboBox}" Classes="field-label">
                        <Label.Content>
                            <OnPlatform x:TypeArguments="x:String" Default="Algorithm" Windows="_Algorithm"/>
                        </Label.Content>
                    </Label>
                    <ComboBox x:Name="AlgorithmComboBox" Classes="enum-labels"
                              ItemsSource="{Binding Algorithms}"
                              SelectedItem="{Binding Algorithm}"
                              AutomationProperties.Name="Encryption Algorithm"
                              AutomationProperties.HelpText="AES-256 (PDF 2.0, default) or AES-128 for older readers."
                              HorizontalAlignment="Stretch"/>
                </StackPanel>
            </StackPanel>

            <!-- Outcome (#2004) -->
            <ui:FAInfoBar Severity="Success"
                        Title="Saved"
                        IsClosable="False"
                        IsOpen="{Binding ResultMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                        IsVisible="{Binding ResultMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding ResultMessage}" TextWrapping="Wrap" Margin="0,0,0,12"/>
            </ui:FAInfoBar>
            <ui:FAInfoBar Severity="Error"
                        Title="Could not apply"
                        IsClosable="False"
                        IsOpen="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                        IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Margin="0,0,0,12"/>
            </ui:FAInfoBar>

        </StackPanel>

        <!-- Footer -->
        <Border Grid.Row="1"
                Background="{DynamicResource SecondaryBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,12">
            <ctl:DialogButtonPanel>
                <Button ctl:DialogButtonPanel.Role="Extra" Content="Remove Protection"
                        Command="{Binding RemoveProtectionCommand}"
                        IsEnabled="{Binding CanRemove}"
                        IsVisible="{Binding IsEncrypted}"
                        Classes="modern-button dialog-button"
                        AutomationProperties.Name="Remove Password Protection"
                        AutomationProperties.HelpText="Explicitly save an unprotected copy of the document. This is the only action that drops encryption; leaving the password fields blank and clicking Apply does not."/>

                <Button ctl:DialogButtonPanel.Role="Cancel" Content="{Binding CloseButtonText}"
                        Command="{Binding CloseCommand}"
                        IsCancel="True"
                        Classes="modern-button dialog-button"
                        AutomationProperties.Name="Close Security Dialog"
                        AutomationProperties.HelpText="Close this dialog without further changes."/>

                <Button ctl:DialogButtonPanel.Role="Primary" Content="Apply"
                        Command="{Binding ApplyCommand}"
                        IsEnabled="{Binding CanApply}"
                        Classes="modern-button dialog-button accent"
                        IsDefault="True"
                        AutomationProperties.Name="Apply Security Settings"
                        AutomationProperties.HelpText="Save a copy of the document with the password/algorithm settings above."/>
            </ctl:DialogButtonPanel>
        </Border>
    </Grid>

</Window>
