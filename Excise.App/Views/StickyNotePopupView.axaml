<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Excise.App.ViewModels"
             x:Class="Excise.App.Views.StickyNotePopupView"
             x:DataType="vm:StickyNotePopupViewModel"
             Focusable="False">

    <!--
        The interactive post-it card (#1788, reworked to a real post-it look
        by #1794). Hosted by MainWindow as an overlay above PdfViewerControl,
        positioned AND SIZED in code-behind (Canvas.Left/Top via Margin, plus
        CardWidthDips/CardHeightDips) from PdfViewerControl.GetViewerPositionForPageRect
        — the one coordinate-conversion boundary this feature crosses, per
        CLAUDE.md's "convert once at the boundary" rule. This view itself does
        no coordinate math.

        This IS the note's on-page appearance while editing — same fill,
        border and rounded-rect proportions as SkiaRenderer's resting-state
        RenderStickyNoteDefault, at the SAME position/size — not a separate
        popup dialog. No "Sticky Note" label, no "Done" button: clicking
        elsewhere on the page (MainWindowViewModel.CommitOpenStickyNotePopup,
        MainWindow's light-dismiss handler) or Escape (the KeyBinding below)
        both commit and collapse back to the resting-state rendering.
    -->
    <Border Background="#FFF59D"
            BorderBrush="#E6D866"
            BorderThickness="1.5"
            CornerRadius="10"
            Padding="12"
            Width="{Binding CardWidthDips}"
            Height="{Binding CardHeightDips}"
            BoxShadow="2 3 10 0 #40000000">
        <TextBox x:Name="NoteTextBox"
                 Text="{Binding Text, Mode=TwoWay}"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 Background="Transparent"
                 BorderThickness="0"
                 Foreground="#3A2E00"
                 FontFamily="Segoe Print, Comic Sans MS, sans-serif"
                 FontSize="15"
                 KeyDown="OnNoteTextBoxKeyDown"
                 AutomationProperties.Name="Sticky note text"
                 AutomationProperties.HelpText="Type the note's text. Clicking away, or Escape, commits it."/>
    </Border>
</UserControl>
