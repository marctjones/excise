<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Excise.App.ViewModels"
        xmlns:ctl="using:Excise.App.Controls"
        x:Class="Excise.App.Views.LinuxPrintDialog"
        x:DataType="vm:LinuxPrintDialogViewModel"
        Title="Print"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <Grid RowDefinitions="*,Auto">
      <Grid Margin="24,20,24,16" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*">

        <TextBlock Grid.Row="0"
                   Text="Printer"
                   Classes="dialog-title"/>

        <ComboBox x:Name="LinuxPrintQueueBox" Grid.Row="1"
                  Margin="0,6,0,0"
                  HorizontalAlignment="Stretch"
                  ItemsSource="{Binding Queues}"
                  SelectedItem="{Binding SelectedQueue}"
                  AutomationProperties.Name="Printer queue"/>

        <Grid Grid.Row="2" Margin="0,14,0,0" ColumnDefinitions="Auto,90,Auto,*">
            <Label Grid.Column="0" Target="{Binding #LinuxPrintCopiesBox}" Classes="field-label" VerticalAlignment="Center">
                <Label.Content>
                    <OnPlatform x:TypeArguments="x:String" Default="Copies" Windows="_Copies"/>
                </Label.Content>
            </Label>
            <TextBox x:Name="LinuxPrintCopiesBox" Grid.Column="1"
                     Margin="10,0,0,0"
                     Text="{Binding CopiesText}"
                     AutomationProperties.Name="Number of copies"/>
            <CheckBox x:Name="LinuxPrintCollateBox" Grid.Column="2"
                      Margin="16,0,0,0" Content="Collate"
                      IsChecked="{Binding Collate}"
                      AutomationProperties.Name="Collate copies"/>
        </Grid>

        <Label Grid.Row="3" Margin="0,14,0,0" Target="{Binding #LinuxPrintPageRangeBox}" Classes="field-label">
            <Label.Content>
                <OnPlatform x:TypeArguments="x:String" Default="Pages" Windows="_Pages"/>
            </Label.Content>
        </Label>

        <TextBox x:Name="LinuxPrintPageRangeBox" Grid.Row="4"
                 Margin="0,6,0,0"
                 Text="{Binding PageRangeText}"
                 PlaceholderText="{Binding PageRangePlaceholder}"
                 AutomationProperties.Name="Page range"/>

        <TextBlock Grid.Row="5" Margin="0,6,0,0"
                   Classes="help"
                   Text="Leave empty to print every page, or type page numbers like 1-3,7."/>

        <TextBlock x:Name="LinuxPrintValidationText" Grid.Row="6"
                   Margin="0,10,0,0"
                   TextWrapping="Wrap" FontSize="12"
                   Foreground="{DynamicResource ErrorTextBrush}"
                   IsVisible="{Binding ValidationError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   Text="{Binding ValidationError}"/>
    </Grid>

    <Border Grid.Row="1"
            Background="{DynamicResource SecondaryBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="24,12">
        <ctl:DialogButtonPanel>
            <Button ctl:DialogButtonPanel.Role="Cancel" x:Name="LinuxPrintCancelButton" Content="Cancel"
                    Classes="modern-button dialog-button"
                    IsCancel="True" Command="{Binding CancelCommand}"
                    AutomationProperties.Name="Cancel printing"/>
            <Button ctl:DialogButtonPanel.Role="Primary" x:Name="LinuxPrintConfirmButton" Content="Print"
                    Classes="modern-button dialog-button accent"
                    IsDefault="True" Command="{Binding PrintCommand}"
                    AutomationProperties.Name="Send the job to the printer"/>
        </ctl:DialogButtonPanel>
    </Border>
    </Grid>
</Window>
