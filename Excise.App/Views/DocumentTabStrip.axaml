<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Excise.App.ViewModels"
             x:Class="Excise.App.Views.DocumentTabStrip"
             x:DataType="vm:DocumentTabsViewModel">

    <!-- #1554: in-app document tabs. The strip never scrolls and never wraps:
         the tabs share the width (each between MinWidth and MaxWidth, names
         trimmed), and the overflow button on the right lists every tab. -->
    <UserControl.Styles>
        <Style Selector="Border.document-tab">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="MinWidth" Value="40"/>
            <Setter Property="MaxWidth" Value="220"/>
        </Style>
        <Style Selector="Border.document-tab:pointerover">
            <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
        </Style>
        <Style Selector="Border.document-tab.selected">
            <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}"/>
        </Style>
        <Style Selector="Button.document-tab-button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5,4,5"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>
        <Style Selector="Border.document-tab.selected Button.document-tab-button">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.document-tab-close">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>
    </UserControl.Styles>

    <Border Background="{DynamicResource SecondaryBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1"
            IsVisible="{Binding IsStripVisible}">
        <Grid ColumnDefinitions="*,Auto">
            <ItemsControl x:Name="DocumentTabsItemsControl"
                          Grid.Column="0"
                          ItemsSource="{Binding Tabs}"
                          ClipToBounds="True"
                          AutomationProperties.Name="Open documents">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" HorizontalAlignment="Left"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DocumentTabViewModel">
                        <Border Classes="document-tab"
                                Classes.selected="{Binding IsSelected}">
                            <Grid ColumnDefinitions="*,Auto">
                                <Button Classes="document-tab-button"
                                        Command="{Binding SelectCommand}"
                                        ToolTip.Tip="{Binding ToolTip}"
                                        AutomationProperties.Name="{Binding AccessibleName}">
                                    <TextBlock Text="{Binding DisplayTitle}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Close Tab" Command="{Binding CloseCommand}"/>
                                            <MenuItem Header="Close Other Tabs" Command="{Binding CloseOthersCommand}"/>
                                            <Separator/>
                                            <MenuItem Header="Move Tab to New Window" Command="{Binding MoveToNewWindowCommand}"/>
                                            <Separator/>
                                            <MenuItem Header="Copy Path" Command="{Binding CopyPathCommand}"
                                                      IsEnabled="{Binding HasFilePath}"/>
                                            <MenuItem Header="{Binding RevealHeader}" Command="{Binding RevealCommand}"
                                                      IsEnabled="{Binding HasFilePath}"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                                <Button Grid.Column="1"
                                        Classes="document-tab-close"
                                        Content="✕"
                                        Command="{Binding CloseCommand}"
                                        ToolTip.Tip="Close tab"
                                        AutomationProperties.Name="{Binding CloseButtonName}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button x:Name="DocumentTabsOverflowButton"
                    Grid.Column="1"
                    Classes="document-tab-close"
                    Content="⌄"
                    ToolTip.Tip="All open documents"
                    AutomationProperties.Name="All open documents">
                <Button.Flyout>
                    <MenuFlyout ItemsSource="{Binding OverflowMenuItems}"/>
                </Button.Flyout>
            </Button>
        </Grid>
    </Border>
</UserControl>
