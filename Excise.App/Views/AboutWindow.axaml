<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Excise.App.ViewModels"
        xmlns:ctl="using:Excise.App.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="780" d:DesignHeight="560"
        x:Class="Excise.App.Views.AboutWindow"
        x:DataType="vm:AboutWindowViewModel"
        Title="About Excise"
        Width="780" Height="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        CanResize="True">

    <Window.DataContext>
        <vm:AboutWindowViewModel/>
    </Window.DataContext>

    <DockPanel>

        <!-- Footer band, as on every dialog (#2006) -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource SecondaryBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,12">
            <ctl:DialogButtonPanel>
                <Button ctl:DialogButtonPanel.Role="Primary"
                        Content="Close" Click="OnCloseClicked"
                        Classes="modern-button dialog-button accent"
                        IsDefault="True" IsCancel="True"
                        AutomationProperties.Name="Close About Dialog"
                        AutomationProperties.HelpText="Close the about dialog."/>
            </ctl:DialogButtonPanel>
        </Border>

        <DockPanel Margin="24,20,24,16">

        <!-- Header: logo + name + version + tagline -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,12"
              ColumnDefinitions="Auto,*">
            <Image Grid.Column="0"
                   Width="64" Height="64"
                   Source="/Assets/excise_logo_64.png"
                   VerticalAlignment="Top"
                   Margin="0,0,16,0"/>
            <StackPanel Grid.Column="1" Spacing="2">
                <!-- The product name in the design system's mono "name" voice -->
                <TextBlock Text="{Binding AppName}"
                           FontFamily="{DynamicResource MonospaceFontFamily}"
                           FontSize="22" FontWeight="Medium"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="{Binding AppVersion, StringFormat='version {0}'}"
                           Classes="help"/>
                <TextBlock Text="{Binding Tagline}"
                           TextWrapping="Wrap" Margin="0,6,0,0"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="{Binding Copyright}"
                           Classes="help" Margin="0,4,0,0"/>
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,6,0,0">
                    <Button Content="Visit GitHub"
                            Click="OnVisitGitHubClicked"
                            Classes="modern-button dialog-button"
                            AutomationProperties.Name="Visit GitHub"
                            AutomationProperties.HelpText="Open the excise GitHub project page in a browser."/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <Separator DockPanel.Dock="Top" Margin="0,0,0,8"/>

        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,4" Text="Third-party libraries"
                   Classes="settings-card-title"/>
        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8"
                   Text="{Binding Packages.Count, StringFormat='{}{0} packages — full notices below'}"
                   Classes="help"/>

        <!-- Master/detail: package list on the left, full text on the right. -->
        <Grid ColumnDefinitions="280,*">
            <ListBox Grid.Column="0"
                     Name="PackagesList"
                     ItemsSource="{Binding Packages}"
                     SelectionMode="Single"
                     AutomationProperties.Name="Third-party Libraries"
                     AutomationProperties.HelpText="Select a package to view its license notice."
                     SelectionChanged="OnSelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ThirdPartyPackage">
                        <StackPanel Spacing="0" Margin="2">
                            <TextBlock Text="{Binding Id}" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding Version}" Classes="help"/>
                                <TextBlock Text="·" Classes="help"/>
                                <TextBlock Text="{Binding LicenseName}" Classes="help"/>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Detail pane -->
            <Border Grid.Column="1" Margin="12,0,0,0"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="4" Padding="10">
                <ScrollViewer>
                    <StackPanel Name="DetailPanel" Spacing="6">
                        <TextBlock Text="Select a package to view its license."
                                   Classes="help" FontStyle="Italic"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        </DockPanel>
    </DockPanel>
</Window>
