<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- App chrome tokens (#1992), valued from the Skeptical Engineering design
         system's tokens.json (#1827): paper ground, ink text levels, rule lines, one
         moss accent, rust for what destroys, ochre for caution. Brushes live in
         ThemeDictionaries so they switch with the window's ThemeVariant; a brush
         outside them that StaticResources a themed colour would resolve once and
         never switch. Light is keyed Default so any variant without its own entry
         falls back to it. Document artwork, annotation colours and viewer overlays
         are document data and stay out of these tokens. -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <!-- Accent: moss. As a fill under white text 4.9:1; as text on paper 4.6:1 -->
            <SolidColorBrush x:Key="BrandPrimaryBrush" Color="#4A7C4A"/>
            <SolidColorBrush x:Key="BrandPrimaryHoverBrush" Color="#426F42"/>
            <SolidColorBrush x:Key="BrandPrimaryPressedBrush" Color="#3A5C3A"/>
            <!-- The accent used as text: moss-ink, 7.1:1 on paper and over 6:1 on
                 paper-sunk bands, where moss itself would be about 4.2:1 -->
            <SolidColorBrush x:Key="BrandTextBrush" Color="#3A5C3A"/>

            <!-- Grounds: paper, paper-sunk -->
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F8F8F6"/>
            <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="#EFEFE9"/>
            <SolidColorBrush x:Key="TertiaryBackgroundBrush" Color="#F4F4F0"/>
            <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#EFEFE9"/>
            <SolidColorBrush x:Key="ToolbarBackgroundBrush" Color="#F8F8F6"/>
            <SolidColorBrush x:Key="CardBrush" Color="#FCFCFA"/>
            <!-- Behind the pages: neutral, so page edges stay visible and artwork is judged on grey -->
            <SolidColorBrush x:Key="CanvasBrush" Color="#E4E4DE"/>

            <!-- Lines: rule, rule-soft -->
            <SolidColorBrush x:Key="BorderBrush" Color="#DCDCD4"/>
            <SolidColorBrush x:Key="DividerBrush" Color="#E4E4DC"/>

            <!-- Text: ink, ink-muted, ink-quiet (the lightest that passes 4.5:1) -->
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1C1C1C"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#505048"/>
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="#686860"/>

            <!-- States: selected is moss on paper-sunk -->
            <SolidColorBrush x:Key="SelectedBrush" Color="#E8EEE6"/>
            <SolidColorBrush x:Key="SelectedHoverBrush" Color="#DCE6DA"/>
            <SolidColorBrush x:Key="HoverBrush" Color="#EFEFE9"/>
            <SolidColorBrush x:Key="PressedBrush" Color="#DCDCD4"/>
            <SolidColorBrush x:Key="FocusRingBrush" Color="#3A5C3A"/>
            <!-- FluentAvalonia draws keyboard focus with these; the design's focus colour -->
            <Color x:Key="FocusStrokeColorOuter">#3A5C3A</Color>
            <SolidColorBrush x:Key="FocusStrokeColorOuterBrush" Color="#3A5C3A"/>

            <!-- Destructive (Apply Redaction): rust. Distinct from moss in hue AND
                 label/icon; white on rust 6.2:1. -->
            <SolidColorBrush x:Key="DangerBrush" Color="#9A4A3A"/>
            <SolidColorBrush x:Key="DangerHoverBrush" Color="#8A4032"/>
            <SolidColorBrush x:Key="DangerPressedBrush" Color="#7A3526"/>
            <SolidColorBrush x:Key="DisabledFillBrush" Color="#DCDCD4"/>
            <SolidColorBrush x:Key="DisabledTextBrush" Color="#686860"/>

            <!-- Status text: moss-ink, ochre-ink, rust-ink -->
            <SolidColorBrush x:Key="SuccessTextBrush" Color="#3A5C3A"/>
            <SolidColorBrush x:Key="WarningTextBrush" Color="#6A6030"/>
            <SolidColorBrush x:Key="ErrorTextBrush" Color="#7A3526"/>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="BrandPrimaryBrush" Color="#4A7C4A"/>
            <SolidColorBrush x:Key="BrandPrimaryHoverBrush" Color="#558A55"/>
            <SolidColorBrush x:Key="BrandPrimaryPressedBrush" Color="#3A5C3A"/>
            <!-- moss-ink dark: moss itself is 3.5:1 on the dark ground, too faint for text -->
            <SolidColorBrush x:Key="BrandTextBrush" Color="#A0C0A0"/>

            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#1C1C1C"/>
            <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="#242422"/>
            <SolidColorBrush x:Key="TertiaryBackgroundBrush" Color="#20201F"/>
            <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#242422"/>
            <SolidColorBrush x:Key="ToolbarBackgroundBrush" Color="#1C1C1C"/>
            <SolidColorBrush x:Key="CardBrush" Color="#20201F"/>
            <SolidColorBrush x:Key="CanvasBrush" Color="#2E2E2B"/>

            <SolidColorBrush x:Key="BorderBrush" Color="#3A3A36"/>
            <SolidColorBrush x:Key="DividerBrush" Color="#2E2E2B"/>

            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E0E0D8"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A0A090"/>
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="#909088"/>

            <SolidColorBrush x:Key="SelectedBrush" Color="#223022"/>
            <SolidColorBrush x:Key="SelectedHoverBrush" Color="#2A3A2A"/>
            <SolidColorBrush x:Key="HoverBrush" Color="#2A2A27"/>
            <SolidColorBrush x:Key="PressedBrush" Color="#3A3A36"/>
            <SolidColorBrush x:Key="FocusRingBrush" Color="#A0C0A0"/>
            <Color x:Key="FocusStrokeColorOuter">#A0C0A0</Color>
            <SolidColorBrush x:Key="FocusStrokeColorOuterBrush" Color="#A0C0A0"/>

            <SolidColorBrush x:Key="DangerBrush" Color="#9A4A3A"/>
            <SolidColorBrush x:Key="DangerHoverBrush" Color="#AA5646"/>
            <SolidColorBrush x:Key="DangerPressedBrush" Color="#7A3526"/>
            <SolidColorBrush x:Key="DisabledFillBrush" Color="#2E2E2B"/>
            <SolidColorBrush x:Key="DisabledTextBrush" Color="#808078"/>

            <SolidColorBrush x:Key="SuccessTextBrush" Color="#A0C0A0"/>
            <SolidColorBrush x:Key="WarningTextBrush" Color="#D8C890"/>
            <SolidColorBrush x:Key="ErrorTextBrush" Color="#E0A090"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
