<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="using:System"
        xmlns:conv="using:Excise.App.Converters">

    <!-- Every window sits on the paper ground (#1992) unless it sets its own. -->
    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}"/>
    </Style>

    <!-- Modern Button Styles -->
    <Style Selector="Button.modern-button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15"/>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>

    <!-- State styles target PART_ContentPresenter: FluentAvalonia's Button theme sets
         Background/BorderBrush/Foreground on it directly in its :pointerover/:pressed
         triggers, which outrank the TemplateBinding from the Button (#1801). -->
    <Style Selector="Button.modern-button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrandPrimaryBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <Style Selector="Button.modern-button:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PressedBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <Style Selector="Button.modern-button:disabled">
        <Setter Property="Opacity" Value="0.45"/>
        <Setter Property="Cursor" Value="Arrow"/>
    </Style>

    <!-- Toggle Button Active State -->
    <Style Selector="Button.modern-button.toggle.active">
        <Setter Property="Background" Value="{DynamicResource SelectedBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrandTextBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource BrandTextBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style Selector="Button.modern-button.toggle.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SelectedHoverBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrandTextBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource BrandTextBrush}"/>
    </Style>

    <!-- Primary Button (Apply Redaction) -->
    <Style Selector="Button.modern-button.primary">
        <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style Selector="Button.modern-button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource DangerHoverBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DangerHoverBrush}"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style Selector="Button.modern-button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource DangerPressedBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DangerPressedBrush}"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style Selector="Button.modern-button.primary:disabled">
        <Setter Property="Background" Value="{DynamicResource DisabledFillBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DisabledFillBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}"/>
        <Setter Property="Opacity" Value="0.6"/>
    </Style>

    <!-- Default dialog action (Save, Apply, Print, Start): brand blue. Not .primary,
         which is red and reserved for Apply Redaction (#1992). -->
    <Style Selector="Button.modern-button.accent">
        <Setter Property="Background" Value="{DynamicResource BrandPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrandPrimaryBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- FluentAvalonia's own Button.accent paints PART_ContentPresenter at rest,
         which outranks the TemplateBinding above (seen in the dark render). -->
    <Style Selector="Button.modern-button.accent /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrandPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrandPrimaryBrush}"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style Selector="Button.modern-button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrandPrimaryHoverBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrandPrimaryHoverBrush}"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style Selector="Button.modern-button.accent:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrandPrimaryPressedBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrandPrimaryPressedBrush}"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <!-- Dialog chrome (#1992): one footer button size, one help-text size, one
         field-label weight, so dialogs stop each picking their own. -->
    <Style Selector="Button.dialog-button">
        <Setter Property="MinWidth" Value="88"/>
        <Setter Property="Padding" Value="16,6"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>


    <!-- Type scale per platform (#2003): Windows uses the Fluent ramp (Body 14,
         Caption 12, Subtitle 20); macOS and Linux the Apple HIG sizes (Body 13,
         Subheadline 11, Headline 13, Title 3 15). -->
    <Style Selector="TextBlock.dialog-title">
        <Setter Property="FontSize">
            <OnPlatform x:TypeArguments="x:Double" Default="15" Windows="20"/>
        </Setter>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <Style Selector="TextBlock.field-label">
        <Setter Property="FontSize">
            <OnPlatform x:TypeArguments="x:Double" Default="13" Windows="14"/>
        </Setter>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <Style Selector="TextBlock.help">
        <Setter Property="FontSize">
            <OnPlatform x:TypeArguments="x:Double" Default="11.5" Windows="12"/>
        </Setter>
        <Setter Property="LineHeight" Value="16"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>

    <Style Selector="TextBlock.warning">
        <Setter Property="FontSize">
            <OnPlatform x:TypeArguments="x:Double" Default="11.5" Windows="12"/>
        </Setter>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}"/>
    </Style>


    <Style Selector="TextBlock.error">
        <Setter Property="FontSize">
            <OnPlatform x:TypeArguments="x:Double" Default="11.5" Windows="12"/>
        </Setter>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Foreground" Value="{DynamicResource ErrorTextBrush}"/>
    </Style>


    <!-- Compact form labels beside their field (#2003): right-aligned on macOS
         and Linux (HIG), left-aligned on Windows. Stacked forms put the label
         above the field on every platform instead. -->
    <Style Selector="TextBlock.form-label">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment">
            <OnPlatform x:TypeArguments="HorizontalAlignment" Default="Right" Windows="Left"/>
        </Setter>
        <Setter Property="FontSize">
            <OnPlatform x:TypeArguments="x:Double" Default="13" Windows="14"/>
        </Setter>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <!-- Settings inputs are sized to their content, not stretched across the
         window (#2003). -->
    <Style Selector="Border.settings-card ComboBox">
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="MinWidth" Value="260"/>
    </Style>
    <Style Selector="Border.settings-card NumericUpDown">
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="MinWidth" Value="160"/>
    </Style>

    <Style Selector="Border.settings-card">
        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="20,16"/>
    </Style>

    <Style Selector="TextBlock.settings-card-title">
        <Setter Property="Margin" Value="0,0,0,4"/>
        <Setter Property="FontSize">
            <OnPlatform x:TypeArguments="x:Double" Default="13" Windows="14"/>
        </Setter>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <!-- Option lists bound to enums show plain-language labels (#1998); the
         binding still selects the enum value. -->
    <Style Selector="ComboBox.enum-labels">
        <Setter Property="ItemTemplate">
            <DataTemplate x:DataType="sys:Object">
                <TextBlock Text="{Binding Converter={x:Static conv:EnumDisplayConverter.Instance}}"/>
            </DataTemplate>
        </Setter>
    </Style>

    <!-- Keyboard focus (#2007): a number box is one tab stop. Its spinner
         buttons stay clickable but leave the tab order; Up/Down already step
         the value, as native number boxes do on Windows and macOS. -->
    <Style Selector="ButtonSpinner /template/ RepeatButton">
        <Setter Property="IsTabStop" Value="False"/>
    </Style>

    <!-- Shared vector icon affordances. Icons use local StreamGeometry resources
         so toolbars and menus do not depend on platform emoji fonts. -->
    <Style Selector="PathIcon.toolbar-icon">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.modern-button.toggle.active PathIcon.toolbar-icon">
        <Setter Property="Foreground" Value="{DynamicResource BrandTextBrush}"/>
    </Style>

    <Style Selector="Button.modern-button.primary PathIcon.toolbar-icon">
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style Selector="PathIcon.menu-icon">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>

    <!-- TextBlock Styles -->
    <Style Selector="TextBlock.heading">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <Style Selector="TextBlock.caption">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>

    <!-- Border Styles -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="12"/>
    </Style>

</Styles>
