{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Excise PDF specification capability registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "purpose", "authority", "sources", "citationAudit", "modeDefinitions", "decisionStates", "implementationStates", "evidenceKinds", "verificationKinds", "sections", "legacySources", "generatedViews"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "status": { "enum": ["proposed", "active"] },
    "purpose": { "type": "string", "minLength": 1 },
    "authority": { "type": "string", "minLength": 1 },
    "sources": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "title", "role"], "properties": { "id": { "type": "string" }, "title": { "type": "string" }, "edition": { "type": "string" }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "role": { "type": "string" } } } },
    "citationAudit": { "type": "string", "minLength": 1 },
    "modeDefinitions": { "type": "object", "minProperties": 1 },
    "decisionStates": { "type": "array", "minItems": 1, "uniqueItems": true },
    "implementationStates": { "type": "array", "minItems": 1, "uniqueItems": true },
    "evidenceKinds": { "type": "array", "minItems": 1, "uniqueItems": true },
    "verificationKinds": { "type": "array", "minItems": 1, "uniqueItems": true },
    "sections": { "type": "array", "minItems": 1 },
    "legacySources": { "type": "string" },
    "generatedViews": { "type": "object" }
  }
}
