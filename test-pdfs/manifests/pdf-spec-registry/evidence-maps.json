    {"id":"spec-citations","generator":"scripts/build-pdf-spec-inventory.py","output":"generated/spec-source-inventory.json","purpose":"SHA-256-pinned ISO clause audit"},
    {"id":"capability-discovery","generator":"scripts/collect-pdf-capability-evidence.py","output":"generated/evidence-collection.json","purpose":"all registry leaves and repository evidence candidates"},
    {"id":"renderer-tests","generator":"scripts/build-renderer-test-evidence-map.py","output":"generated/renderer-test-evidence-map.json","purpose":"every rendering xUnit test method"},
