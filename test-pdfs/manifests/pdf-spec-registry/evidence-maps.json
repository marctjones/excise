    {"id":"benchmark-scenarios","generator":"scripts/run-pdf-capability-benchmarks.py","output":"benchmark-baselines.json","purpose":"critical-path performance evidence and budgets"},
    {"id":"reference-tools","generator":"manual pinned manifest","output":"reference-tools.json","purpose":"oracle capability, version, limit, and disagreement policy"},
