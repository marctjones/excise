    {"id":"evidence-deficiencies","generator":"scripts/build-pdf-evidence-deficiency-report.py","output":"generated/evidence-deficiency-report.json","purpose":"prioritized mode-by-mode gaps in source, test, fixture, independent evidence, and executable contracts"},
