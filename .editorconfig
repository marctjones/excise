# #911: dead-private-code detection. IDE0051/IDE0052 are the two rules a
# text-based unwired-API check structurally cannot provide (it only reads the
# approved PUBLIC surface). Compiler-accurate: no name-matching false positives
# from XAML bindings, attached properties, or interface dispatch.
#
# Warnings, not errors — the repo's 0-warning convention makes them visible
# without blocking a build mid-triage.
root = true

[*.cs]
dotnet_diagnostic.IDE0051.severity = warning
dotnet_diagnostic.IDE0052.severity = warning
