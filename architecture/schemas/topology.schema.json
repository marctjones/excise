{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/marctjones/excise/blob/develop/architecture/schemas/topology.schema.json",
  "title": "Excise generated Roslyn code topology",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generator", "sourceRevision", "projects", "symbols", "typeDependencies", "methodCycles", "seeds", "blindSpots"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "generator": { "const": "tools/Excise.Reachability" },
    "sourceRevision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "path", "classification", "component", "sourceFiles", "types", "methods", "mutableMembers", "declarationLines"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "pattern": "\\.csproj$" },
          "classification": { "enum": ["shipping", "test", "sample", "benchmark", "tool"] },
          "component": { "type": ["string", "null"] },
          "sourceFiles": { "type": "integer", "minimum": 0 },
          "types": { "type": "integer", "minimum": 0 },
          "methods": { "type": "integer", "minimum": 0 },
          "mutableMembers": { "type": "integer", "minimum": 0 },
          "declarationLines": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "symbols": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["project", "kind", "symbol", "containingType", "namespace", "file", "component", "workflows", "startLine", "endLine", "declarationLines", "branchPoints", "fanIn", "fanOut", "reachable", "seed", "mutable", "declarationCount"],
        "properties": {
          "project": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1 },
          "symbol": { "type": "string", "minLength": 1 },
          "containingType": { "type": ["string", "null"] },
          "namespace": { "type": ["string", "null"] },
          "file": { "type": ["string", "null"] },
          "component": { "type": ["string", "null"] },
          "workflows": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "startLine": { "type": "integer", "minimum": 0 },
          "endLine": { "type": "integer", "minimum": 0 },
          "declarationLines": { "type": "integer", "minimum": 0 },
          "branchPoints": { "type": "integer", "minimum": 0 },
          "fanIn": { "type": "integer", "minimum": 0 },
          "fanOut": { "type": "integer", "minimum": 0 },
          "reachable": { "type": "boolean" },
          "seed": { "type": "boolean" },
          "mutable": { "type": "boolean" },
          "declarationCount": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "typeDependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "target", "references"],
        "properties": {
          "source": { "type": "string", "minLength": 1 },
          "target": { "type": "string", "minLength": 1 },
          "references": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "methodCycles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["members"],
        "properties": {
          "members": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
        }
      }
    },
    "seeds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbols", "xamlNames", "stringLiterals"],
      "properties": {
        "symbols": { "type": "integer", "minimum": 0 },
        "xamlNames": { "type": "integer", "minimum": 0 },
        "stringLiterals": { "type": "integer", "minimum": 0 }
      }
    },
    "blindSpots": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
  }
}
