{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/marctjones/excise/blob/develop/architecture/schemas/artifact-set.schema.json",
  "title": "Excise coherent generated architecture artifact set",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "generator", "sourceRevision", "revisionSemantics", "artifacts", "historyArtifacts"],
  "properties": {
    "$schema": { "const": "../schemas/artifact-set.schema.json" },
    "schemaVersion": { "const": 2 },
    "generator": { "const": "scripts/architecture_artifacts.py" },
    "sourceRevision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "revisionSemantics": { "const": "provenance-only; normalized content and hashes determine freshness" },
    "artifacts": {
      "type": "array",
      "minItems": 7,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "format", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "format": { "enum": ["json", "dot"] },
          "schema": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "historyArtifacts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "format", "verification"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "format": { "enum": ["json", "dot"] },
          "schema": { "type": "string", "minLength": 1 },
          "verification": { "const": "schema-and-scope; derived from git history, deliberately not hash-pinned" }
        }
      }
    }
  }
}
