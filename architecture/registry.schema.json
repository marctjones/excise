{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/marctjones/excise/blob/develop/architecture/registry.schema.json",
  "title": "Excise architecture registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "reviewedAt",
    "statusDefinitions",
    "components",
    "relationships",
    "workflows",
    "concerns",
    "architectureRules",
    "diagramViews"
  ],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schemaVersion": { "const": 1 },
    "reviewedAt": { "type": "string", "format": "date" },
    "statusDefinitions": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "components": {
      "type": "array",
      "items": { "$ref": "#/$defs/component" }
    },
    "relationships": {
      "type": "array",
      "items": { "$ref": "#/$defs/relationship" }
    },
    "workflows": {
      "type": "array",
      "items": { "$ref": "#/$defs/workflow" }
    },
    "concerns": {
      "type": "array",
      "items": { "$ref": "#/$defs/concern" }
    },
    "architectureRules": {
      "type": "array",
      "items": { "$ref": "#/$defs/rule" }
    },
    "diagramViews": {
      "type": "array",
      "items": { "$ref": "#/$defs/diagramView" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "status": {
      "enum": [
        "implemented",
        "partial",
        "planned",
        "accepted_exception",
        "deprecated",
        "unknown"
      ]
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "kind",
        "layer",
        "paths",
        "currentStatus",
        "targetStatus",
        "summary",
        "targetState",
        "primaryWorkflows",
        "dependsOn",
        "verification",
        "knownGaps"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": ["project", "subsystem", "application", "tooling", "verification"]
        },
        "layer": {
          "enum": ["foundation", "engine", "integration", "presentation", "delivery", "verification"]
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "projectFile": { "type": "string", "pattern": "\\.csproj$" },
        "projectDependencies": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "allowedProjectDependencies": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "currentStatus": { "$ref": "#/$defs/status" },
        "targetStatus": { "$ref": "#/$defs/status" },
        "summary": { "type": "string", "minLength": 1 },
        "targetState": { "type": "string", "minLength": 1 },
        "primaryWorkflows": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "dependsOn": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "desiredDependsOn": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "verification": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "knownGaps": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "issueIds": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 },
          "uniqueItems": true
        }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "target", "type", "currentStatus", "targetStatus", "rationale"],
      "properties": {
        "source": { "$ref": "#/$defs/id" },
        "target": { "$ref": "#/$defs/id" },
        "type": {
          "enum": ["uses", "owns", "orchestrates", "adapts", "verifies", "must-not-depend-on"]
        },
        "currentStatus": { "$ref": "#/$defs/status" },
        "targetStatus": { "$ref": "#/$defs/status" },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "criticality", "entryPoints", "steps", "verification"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "criticality": { "enum": ["security-critical", "primary", "supporting"] },
        "entryPoints": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["order", "component", "responsibility"],
            "properties": {
              "order": { "type": "integer", "minimum": 1 },
              "component": { "$ref": "#/$defs/id" },
              "responsibility": { "type": "string", "minLength": 1 }
            }
          }
        },
        "verification": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "concern": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "priority",
        "currentStatus",
        "desiredState",
        "components",
        "symptoms",
        "deterministicDiscovery",
        "rootCauseQuestions",
        "issueIds"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "priority": { "enum": ["critical", "high", "medium", "low"] },
        "currentStatus": { "$ref": "#/$defs/status" },
        "desiredState": { "type": "string", "minLength": 1 },
        "components": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "symptoms": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "deterministicDiscovery": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "rootCauseQuestions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "issueIds": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 },
          "uniqueItems": true
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "components", "enforcement"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "statement": { "type": "string", "minLength": 1 },
        "components": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "enforcement": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "diagramView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "mode", "components", "output"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "mode": { "enum": ["current", "target"] },
        "components": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "output": { "type": "string", "pattern": "\\.dot$" }
      }
    }
  }
}
