// Generated by scripts/check_architecture_registry.py. Do not edit by hand.
digraph excise_architecture {
  graph [rankdir=BT, fontname="Helvetica", labelloc=t, label="Excise desired component architecture"];
  node [shape=box, style="rounded,filled", fontname="Helvetica"];
  edge [fontname="Helvetica", color="#475569"];
  subgraph cluster_delivery {
    label="delivery";
    color="#cbd5e1";
    "app" [label="Excise.App project\nimplemented", fillcolor="#d8f3dc"];
    "cli" [label="Excise.Cli project\nimplemented", fillcolor="#d8f3dc"];
  }
  subgraph cluster_engine {
    label="engine";
    color="#cbd5e1";
    "core-content" [label="Content-stream walker and sinks\nimplemented", fillcolor="#d8f3dc"];
    "core-document" [label="Document model and mutation boundary\nimplemented", fillcolor="#d8f3dc"];
    "core-fonts" [label="Font decoding, metrics, and subsetting\nimplemented", fillcolor="#d8f3dc"];
    "core-redaction" [label="Glyph-, image-, and carrier-level redaction\nimplemented", fillcolor="#d8f3dc"];
    "core-security" [label="Encryption, permissions, signatures, and document validation\nimplemented", fillcolor="#d8f3dc"];
    "core-text" [label="Text extraction, ordering, search geometry, and selection\nimplemented", fillcolor="#d8f3dc"];
    "core-writing" [label="Fresh-write serialization and encryption preservation\nimplemented", fillcolor="#d8f3dc"];
    "rendering" [label="Excise.Rendering project\nimplemented", fillcolor="#d8f3dc"];
  }
  subgraph cluster_foundation {
    label="foundation";
    color="#cbd5e1";
    "core" [label="Excise.Core project\nimplemented", fillcolor="#d8f3dc"];
    "core-parsing" [label="Parser, xref, filters, and hostile-input boundary\nimplemented", fillcolor="#d8f3dc"];
    "core-primitives" [label="PDF primitives and object graph\nimplemented", fillcolor="#d8f3dc"];
  }
  subgraph cluster_integration {
    label="integration";
    color="#cbd5e1";
    "ocr" [label="Excise.Ocr project\nimplemented", fillcolor="#d8f3dc"];
    "ocr-native" [label="Excise.Ocr.Native project\nimplemented", fillcolor="#d8f3dc"];
  }
  subgraph cluster_presentation {
    label="presentation";
    color="#cbd5e1";
    "app-main-window" [label="Main-window orchestration and feature state\nimplemented", fillcolor="#d8f3dc"];
    "avalonia" [label="Excise.Avalonia project\nimplemented", fillcolor="#d8f3dc"];
  }
  subgraph cluster_verification {
    label="verification";
    color="#cbd5e1";
    "architecture-tooling" [label="Architecture registry, reachability, and derived diagrams\nimplemented", fillcolor="#d8f3dc"];
    "verification" [label="Repository verification system\nimplemented", fillcolor="#d8f3dc"];
  }
  "app" -> "avalonia" [label="project", style="solid"];
  "app" -> "core" [label="project", style="solid"];
  "app" -> "ocr" [label="project", style="solid"];
  "app" -> "rendering" [label="project", style="solid"];
  "app-main-window" -> "app" [label="depends", style="solid"];
  "app-main-window" -> "avalonia" [label="depends", style="solid"];
  "architecture-tooling" -> "verification" [label="depends", style="solid"];
  "architecture-tooling" -> "verification" [label="verifies", style="dotted"];
  "avalonia" -> "core" [label="project", style="solid"];
  "avalonia" -> "rendering" [label="project", style="solid"];
  "cli" -> "core" [label="project", style="solid"];
  "cli" -> "ocr" [label="project", style="solid"];
  "cli" -> "rendering" [label="project", style="solid"];
  "core" -> "app" [label="must-not-depend-on", style="dashed"];
  "core-content" -> "core-fonts" [label="depends", style="solid"];
  "core-content" -> "core-parsing" [label="depends", style="solid"];
  "core-content" -> "core-primitives" [label="depends", style="solid"];
  "core-document" -> "core-parsing" [label="depends", style="solid"];
  "core-document" -> "core-primitives" [label="depends", style="solid"];
  "core-fonts" -> "core-parsing" [label="depends", style="solid"];
  "core-fonts" -> "core-primitives" [label="depends", style="solid"];
  "core-parsing" -> "core-primitives" [label="depends", style="solid"];
  "core-redaction" -> "core-content" [label="depends", style="solid"];
  "core-redaction" -> "core-content" [label="uses", style="dotted"];
  "core-redaction" -> "core-document" [label="depends", style="solid"];
  "core-redaction" -> "core-text" [label="depends", style="solid"];
  "core-redaction" -> "core-writing" [label="depends", style="solid"];
  "core-security" -> "core-document" [label="depends", style="solid"];
  "core-security" -> "core-parsing" [label="depends", style="solid"];
  "core-security" -> "core-primitives" [label="depends", style="solid"];
  "core-text" -> "core-content" [label="depends", style="solid"];
  "core-text" -> "core-fonts" [label="depends", style="solid"];
  "core-writing" -> "core-document" [label="depends", style="solid"];
  "core-writing" -> "core-primitives" [label="depends", style="solid"];
  "core-writing" -> "core-security" [label="depends", style="solid"];
  "ocr" -> "core" [label="project", style="solid"];
  "ocr" -> "ocr-native" [label="project", style="solid"];
  "ocr" -> "rendering" [label="project", style="solid"];
  "rendering" -> "core" [label="project", style="solid"];
  "rendering" -> "core-content" [label="uses", style="dotted"];
  "verification" -> "app" [label="depends", style="solid"];
  "verification" -> "avalonia" [label="depends", style="solid"];
  "verification" -> "cli" [label="depends", style="solid"];
  "verification" -> "core" [label="depends", style="solid"];
  "verification" -> "core-redaction" [label="verifies", style="dotted"];
  "verification" -> "ocr" [label="depends", style="solid"];
