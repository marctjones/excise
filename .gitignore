.gemini/
gha-creds-*.json

# Test PDFs (downloaded on demand, not committed)
test-pdfs/*
# But do commit corpus manifests
!test-pdfs/manifests/
!test-pdfs/manifests/**
# Except: these two registry derived files are pure functions of source (the
# .cs test files + sections/*.json) regenerated in ~seconds by
# check-pdf-capability-registry.sh, and are the two heaviest + most-churned
# files in the repo (~6 MB each, rewritten on every registry-touching commit).
# Unlike the rest of generated/ (kept committed for drift-detection and
# review-without-running-anything — see capability-scorecard.md), these two
# are cheap enough to just regenerate on demand; not tracking them measurably
# slows repo growth for no loss of the evidence itself (2026-09-08).
test-pdfs/manifests/pdf-spec-registry/generated/test-suite-evidence-map.json
test-pdfs/manifests/pdf-spec-registry/generated/evidence-deficiency-report.json
# But do commit rendering quality contracts
!test-pdfs/rendering-contracts/
!test-pdfs/rendering-contracts/**
# But do commit our sample PDFs
!test-pdfs/sample-pdfs/
!test-pdfs/sample-pdfs/**
# But do commit generated PDF 2.0 conformance fixtures
!test-pdfs/pdf20/
!test-pdfs/pdf20/**
# But do commit excise-authored generated implementation-regression fixtures
!test-pdfs/generated-regressions/
!test-pdfs/generated-regressions/**

# Publish output
/publish/

# Logs from test runs
/logs/

# Downloaded PDF specifications (large files)
ISO-32000-*.pdf
ISO-32000-*.md

# Test output
/test-output/
run_output.txt
/output/

# Screenshots (temporary debug files)
/screenshots/

# Claude Code runtime state
.claude/scheduled_tasks.lock

# ⚠️ Output-directory patterns below are ANCHORED with a leading slash, on
# purpose. Unanchored, `coverage/` matches a directory of that name at ANY
# depth — and it did: Excise.App.Tests/UI/Coverage/ (three new source files)
# was silently untracked, building fine locally and failing to compile in CI.
# Anchor anything that names a build/output directory; only patterns that must
# match per-project (bin/, obj/, TestResults/) stay unanchored.
# Guarded by scripts/check-no-ignored-sources.sh.
# Coverage reports and results (generated artifacts, not source)
/coverage-report/
/coverage-results/

# Build artifacts and worktrees
/artifacts/
/coverage/
/dist/
# Build output from scripts/build-macos-app.sh --output <dir>. Only `dist/`
# was listed, so an --output dir with any other name (dist-aot/) was tracked
# and 180 MB of dSYM + native binary got committed before anyone noticed.
/dist-*/
.claude/worktrees/
.wiki/
excise.sh

# Auto-generated test JSON
**/*.cs.json

# OCR training data — downloaded on demand (scripts/download-tessdata.sh), not committed.
# The whole directory, not just *.traineddata: scripts/corpus.sh verify requires
# every corpus destination to be fully gitignored, and a rule that covers only
# one extension leaves the rest of the directory committable.
tessdata/

# Bundled PDF spec dump (large; reference it from the Wiki, don't commit it)
PDF32000_2008.md

# Test-host crash/hang dumps and blame sequence files (xUnit --blame-hang)
*.dmp
Sequence_*.xml

# Python bytecode caches from local helper scripts
__pycache__/
*.pyc

# Git history-rewrite backup bundles
*.bundle

# Locally-installed dotnet global tools — never commit (arm64 binary + 18MB tool store)
/tools/.store/
/tools/reportgenerator

# Downloaded build inputs (scripts/download-pdfbox.sh) — not source.
tools/vendor/

# check-test-count.sh keeps its loss-streak ledger here between runs; local state, not evidence
tests/test-count-loss-ledger.tsv
