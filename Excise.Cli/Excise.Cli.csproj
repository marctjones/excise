<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>excise</AssemblyName>
    <!-- ReadyToRun compilation: pre-JIT compile IL at publish time for faster cold-start -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- Composite R2R: bundle all dependencies into single R2R image for ~40% better cold-start -->
    <PublishReadyToRunComposite>true</PublishReadyToRunComposite>
    <!-- Tiered compilation: helps R2R by deferring optimization to runtime for hot paths -->
    <TieredCompilation>true</TieredCompilation>
    <!-- #1389 - run the trim and AOT analyzers on every ordinary build, not only on an
         AOT publish. This is the gate for the source-generated JSON in CliJsonContexts.cs:
         reflection-based JsonSerializer calls are invisible to the trimmer, so under Native
         AOT they emit an empty object at RUNTIME with no build-time complaint. With this on,
         reintroducing one is IL2026 + IL3050 at compile time (verified by adding a reflection
         call back: 2x IL2026, 2x IL3050; silent otherwise). Warning-clean under it today.
         Native AOT itself stays opt-in per publish and is NOT gated for this project - the
         `aot` row (scripts/run-aot-smoke.sh) publishes Excise.App only. #1390 holds the
         publish recipe, including the LIBRARY_PATH the link needs on macOS, and proposes
         moving it into the script. Do not point this at docs/RELEASE_CHECKLIST.md: that
         documents the GUI's row, not the CLI. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Excise.Core\Excise.Core.csproj" />
    <ProjectReference Include="..\Excise.Rendering\Excise.Rendering.csproj" />
    <ProjectReference Include="..\Excise.Ocr\Excise.Ocr.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- System.CommandLine 2.0.0 GA was a substantial API rewrite vs the
         beta4 build (handlers → SetAction(parseResult), Argument/Option
         description and default moved to property-initializers, IsRequired
         renamed to Required). Migration done in Program.cs. -->
    <PackageReference Include="System.CommandLine" Version="2.0.9" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.4" />
  </ItemGroup>

</Project>
