<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>excise</AssemblyName>
    <!-- ReadyToRun compilation: pre-JIT compile IL at publish time for faster cold-start -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- Composite R2R: bundle all dependencies into single R2R image for ~40% better cold-start -->
    <PublishReadyToRunComposite>true</PublishReadyToRunComposite>
    <!-- Tiered compilation: helps R2R by deferring optimization to runtime for hot paths -->
    <TieredCompilation>true</TieredCompilation>
    <!-- #1389 - run the trim and AOT analyzers on every ordinary build, not only on an
         AOT publish. This is the gate for the source-generated JSON in CliJsonContexts.cs:
         reflection-based JsonSerializer calls are invisible to the trimmer, so under Native
         AOT they emit an empty object at RUNTIME with no build-time complaint. With this on,
         reintroducing one is IL2026 + IL3050 at compile time (verified by adding a reflection
         call back: 2x IL2026, 2x IL3050; silent otherwise). Warning-clean under it today.
         Native AOT itself stays opt-in per publish and is NOT gated for this project - the
         `aot` row (scripts/run-aot-smoke.sh) publishes Excise.App only. #1390 holds the
         publish recipe, including the LIBRARY_PATH the link needs on macOS, and proposes
         moving it into the script. Do not point this at docs/RELEASE_CHECKLIST.md: that
         documents the GUI's row, not the CLI. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Excise.Core\Excise.Core.csproj" />
    <ProjectReference Include="..\Excise.Rendering\Excise.Rendering.csproj" />
    <ProjectReference Include="..\Excise.Ocr\Excise.Ocr.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- System.CommandLine 2.0.0 GA was a substantial API rewrite vs the
         beta4 build (handlers → SetAction(parseResult), Argument/Option
         description and default moved to property-initializers, IsRequired
         renamed to Required). Migration done in Program.cs. -->
    <PackageReference Include="System.CommandLine" Version="2.0.12" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.4" />
  </ItemGroup>

  <!--
    #1207 / #1468: peak RSS on an image-heavy render is dominated by GC-RETAINED
    memory, not by live data. Measured 2026-09-19 on Altona technical2_x4 p1:
    the live managed heap mid-render is 145 MB (gcdump), of which System.Byte[]
    is 15.6 MB, while RSS peaks at 711 MiB. The decoded image samples ARE being
    released — the deferred-decode release frees 522 MiB during that render —
    but freeing to the GC is not returning to the OS, and a page that decodes
    and discards dozens of ~90 MiB sample arrays grows the heap and keeps it.

    ConserveMemory tells the GC to decommit rather than retain. Measured, two
    runs each, same page at 150 dpi:

        baseline                 1.56 s   711 MiB
        System.GC.ConserveMemory=5   1.57 s   406 MiB
        System.GC.ConserveMemory=9   1.59 s   411 MiB

    42% less memory for ~1% wall clock. 5 is used rather than 9 because it is
    no worse on memory here and asks less of the collector.

    WARNING: this is scoped to the CLI on purpose. The opposite was measured for
    the TEST RUNNER, where GC tuning made peak RSS ~24% WORSE (552 MB vs 446 MB
    on Excise.Core.Tests) — a long-lived multi-assembly host is not a
    short-lived one-page render. Do not promote this to Directory.Build.props,
    and measure before applying it to the GUI.
  -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>

</Project>
